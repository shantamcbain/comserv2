# --- Documentation runtime state (generated at runtime; NOT source) ---
# The doc system rewrites DocumentationConfig.json + scan_state.json on every
# scan/save via _atomic_write_json. Tracking them guarantees 13k-line merge
# conflicts. The app recreates them with make_path() on first write, so
# ignoring them is safe. The SHIPPED seed (root/Documentation/config/*.json)
# stays tracked — only the session/ overlay is ignored.
/Comserv/root/session/documentation_config/DocumentationConfig.json
/Comserv/root/session/documentation_config/scan_state.json
/Comserv/root/session/documentation_config/*.bak
/Comserv/root/session/documentation_config/*.tmp

# Runtime-generated app state (regenerated by the doc-scan; not source)
Comserv/root/session/
Comserv/root/session/**

# Hermes agent scratch plans (local working notes, not project source)
.hermes/plans/
.hermes/plans/**
# SQLite WAL/shared-memory side files
Comserv/data/*.db-shm
Comserv/data/*.db-wal

# 3d library user-uploaded images (giant SVG re-uploads would exceed GitHub limits; keep out of git)
Comserv/root/static/images/3d/library/**

# Runtime AI state (usage, model chains, prices, eval inbox, hermes guards, etc.)
# These are generated at runtime by AI2 components and must never be committed.
# They cause "Rejected unsafe or unknown path(s)" on commit attempts when
# the UI collects them but the target's git status does not list them (or they
# are not dirty in the bound checkout).
Comserv/data/ai_model_chains.json
Comserv/data/ai_openrouter_prices.json
Comserv/data/ai_usage_readings.jsonl
Comserv/data/ai_eval_inbox/
Comserv/data/ai_eval_inbox/**
Comserv/data/ai_hermes_overrun*.json
Comserv/data/ai_commit_gate.json
Comserv/data/ai_review_scores.json
Comserv/data/ai_reviewer_spend.json
Comserv/root/static/ai/*usage*.json*
Comserv/root/static/ai/*monitor*.json*

# Phone app source lives in its own repo:
# /home/shanta/PycharmProjects/comserv-inventory-android
# Do not re-add the Gradle project or its build output here.
/android/
Comserv/root/static/android/

# APK binaries are huge and rebuilt constantly — serve them from
# /data/nfs/inventory-apks via symlink, keep out of git
Comserv/root/static/app/*.apk
# The Android app is its own project (canonical copy is the InventoryAccounting
# worktree until it is extracted). Do not commit the source tree, Gradle output,
# or a built APK dropped under the web static tree.
/android/
Comserv/root/static/android/

# Encryption keys — keep in ~/.comserv/keys, never in git.
# *_encryption_key also matches dotfiles such as .proxmox_encryption_key.
*_encryption_key

# Secrets moved to ~/.comserv/secrets (see docs/security/secrets-design.txt)
Comserv/config/proxmox_credentials.json
Comserv/config/nginx/npm-*.conf
Comserv/.env.staging

# Generated by deploy.sh stamp_build_version at build time (baked into image)
Comserv/version.json


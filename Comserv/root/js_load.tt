<!-- common/form-filler.js → present -->
<!-- ai-common.js          → present -->
<!-- ai2editor/core.js     → present -->
<!-- ai2editor/popup.js     → present -->
<!-- ai2editor/commit-ui.js → present -->
<!-- menu.js               → present -->
<!-- local-chat.js         → present -->
<!-- user-prefs.js         → present -->
<!-- back-to-top.js        → present -->
<!-- sub-menu.js           → present -->
<!-- HealthMonitor.js      → present -->

<!-- ================================================ -->
<!-- TODO / MISSING FILES (commented until created) -->

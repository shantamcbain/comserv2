<!-- Core utilities & common functionality (early load) -->
<script src="/static/js/common/ui.js?v=[% cv %]" defer></script>
<script src="/static/js/common/form-filler.js?v=[% cv %]" defer></script>
<script src="/static/js/ai-common.js?v=[% cv %]" defer></script>
<script src="/static/js/floating-buttons.js?v=[% cv %]" defer></script>

<!-- Theme class (moved from Header.tt) -->
<!-- <script src="/static/js/theme-class.js?v=[% cv %]" defer></script> -->

<!-- Admin-only (conditional) -->
[% IF is_admin && SiteName == 'CSC' && !is_dev_server %]
<script src="/static/js/HealthMonitor.js" defer></script>
[% END %]

<!-- Hardware Monitor JS (charts + auto-refresh; V2 external module) -->
[% IF c.request.uri.match('/admin/hardware_monitor') %]
<script src="/static/js/hardware-monitor.js?v=[% cv %]" defer></script>
[% END %]
[% IF c.request.uri.match('/admin') %]
<script src="/static/js/admin-dashboard.js?v=[% cv %]" defer></script>
[% END %]

<!-- Logging: live system_log row-count ticker during dedupe -->
[% IF c.request.uri.match('/admin/logging') %]
<script src="/static/js/logging-dedupe.js?v=[% cv %]" defer></script>
[% END %]

<!-- Schema Compare JS -->
[% IF c.request.uri.match('/admin/schema_compare') %]
<script src="/static/js/schema-compare.js?v=[% cv %]" defer></script>
[% END %]

<!-- Shared "operation in progress" overlay — auto-binds to any
     form[data-busy-on-submit]; safe to load globally (no-ops without the attr). -->
<script src="/static/js/common/scan-progress.js?v=[% cv %]" defer></script>

<!-- Git Dashboard JS -->
<!-- Loaded AFTER the shared ai-chat module block (below) on purpose:
     git-dashboard.js calls ComservChat.modelSelect.init() from its
     DOMContentLoaded handler, so model-select.js MUST have executed
     first. With `defer`, scripts run in document order within this file. -->
[% IF c.request.uri.match('/admin/git') %]
[% END %]

<!-- Herb Sign Generator live preview -->
[% IF c.request.uri.match('/signgenerator') %]
<script src="/static/js/sign-preview.js?v=[% cv %]" defer></script>
[% END %]

<!-- Legacy menu (conditional) -->
[% UNLESS c.session.use_db_menu || c.stash.use_db_menu %]
<script src="/static/js/sub-menu.js" defer></script>
<script src="/static/js/menu.js" defer></script>
[% END %]

<!-- Global helpers (moved from Header.tt) -->
<!-- <script src="/static/js/switchpage.js?v=[% cv %]" defer></script> -->
<script src="/static/js/back-to-top.js?v=[% cv %]" defer></script>
[% IF c.session.user_id %]
<script src="/static/js/user-prefs.js?v=[% cv %]" defer></script>
[% END %]



<!-- AI2 Editor Suite (only when popup widget is active) -->
<!-- Shared chat modules (load FIRST, before the widgets, so they exist when
     local-chat.js / ai2editor/*.js build their DOM). Single source of truth for
     model-selection, tooltips, and the Add-Todo feature, shared by BOTH chat UIs. -->
<script src="/static/js/ai-chat/model-select.js?v=[% cv %]" defer></script>
<script src="/static/js/ai-chat/tooltips.js?v=[% cv %]" defer></script>
<script src="/static/js/ai-chat/feature-todo.js?v=[% cv %]" defer></script>

[% IF c.request.uri.match('/ai/usage') %]
<script src="/static/js/ai/usage-monitor.js?v=[% cv %]" defer></script>
[% END %]

<!-- Git Dashboard JS: MUST come AFTER model-select.js above, because
     git-dashboard.js calls ComservChat.modelSelect.init() from its
     DOMContentLoaded handler. With `defer`, scripts run in document order. -->
[% IF c.request.uri.match('/admin/git') %]
<!-- Canonical shared diff widget (git_worktree_merge_plan §3.5). Loads BEFORE
     git-dashboard.js so ComservGitDiff exists when bindFileDiff() runs. -->
<script src="/static/js/git-diff-viewer.js?v=[% cv %]" defer></script>
<link rel="stylesheet" href="/static/css/components/git-diff-viewer.css?v=[% cv %]">
<script src="/static/js/git-dashboard.js?v=[% cv %]" defer></script>
<script>
    // Give the git dashboard the same canonical catalog (with price_* / tier)
    // so model-select.js uses the fast path and shows real per-token cost,
    // instead of falling back to /ai2/providers (grouped shape drops price).
    window.ComservConfig = window.ComservConfig || {};
    window.ComservConfig.models = [% ai_model_catalog_json || '[]' %];
</script>
[% END %]

[% IF c.request.uri.match('/ai2/editing_widget_popup') %]
<script src="/static/js/git-dashboard.js?v=[% cv %]" defer></script>
<!-- Canonical shared diff widget — must precede file-diff.js so
     ComservGitDiff exists when the AI2 "Changed Files / Diff" action runs. -->
<script src="/static/js/git-diff-viewer.js?v=[% cv %]" defer></script>
<link rel="stylesheet" href="/static/css/components/git-diff-viewer.css?v=[% cv %]">
<script src="/static/js/ai2editor/core.js?v=[% cv %]" defer></script>
<script src="/static/js/ai2editor/popup.js?v=[% cv %]" defer></script>
<script src="/static/js/ai2editor/adapters/ace.js?v=[% cv %]" defer></script>
<script src="/static/js/ai2editor/adapters/richtext.js?v=[% cv %]" defer></script>
<script src="/static/js/ai2editor/sidebar-toggle.js?v=[% cv %]" defer></script>
<script src="/static/js/ai2editor/git-review.js?v=[% cv %]" defer></script>
<script src="/static/js/ai2editor/file-diff.js?v=[% cv %]" defer></script>
<script src="/static/js/ai2editor/project-tree.js?v=[% cv %]" defer></script>
<script src="/static/js/ai2editor/chat.js?v=[% cv %]" defer></script>
[% END %]

<!-- Other feature modules -->
<!-- Chat system migrated from polling to Server-Sent Events (SSE) – polling code removed (2026-07-01) -->
<!-- AI Chat V2 modular suite: voice.js must load before local-chat.js (it is
     wired from createChatWidget()); index.js loads last as the namespace shim. -->
<script src="/static/js/ai-chat/voice.js?v=[% cv %]" defer></script>
<script src="/static/js/ai-chat/support.js?v=[% cv %]" defer></script>
<script src="/static/js/ai-chat/page-context.js?v=[% cv %]" defer></script>
<script src="/static/js/ai-chat/wizards.js?v=[% cv %]" defer></script>
<script src="/static/js/ai-chat/audio-backup.js?v=[% cv %]" defer></script>
<script src="/static/js/local-chat.js?v=[% cv %]" defer></script>
<script src="/static/js/ai-chat/index.js?v=[% cv %]" defer></script>

<!-- Planning / Daily page JS (covers both /planning/daily and /Documentation/DailyPlan) -->
[% IF c.request.uri.match('/planning/daily') || c.request.uri.match('/Documentation/DailyPlan') || c.request.uri.match('/project/') %]
<script src="/static/js/planning/daily-plan.js?v=[% cv %]" defer></script>
<script src="/static/js/planning/daily-plan-gantt.js?v=[% cv %]" defer></script>
<script src="/static/js/planning/daily-plan-deploy-center.js?v=[% cv %]" defer></script>
<script src="/static/js/planning/daily-plan-utils.js?v=[% cv %]" defer></script>
<script src="/static/js/project/project-search.js?v=[% cv %]" defer></script>
[% END %]

<!-- Shared todo card Start/Done delegated handler. Loaded ONCE whenever a
     controller sets needs_todo_card_js (any route that renders todo_card.tt:
     /todo, /todo/details, /todo/day|week|month, /project, /project/details).
     Driven by a stash flag set in the controller, NOT a per-URL match list, so
     new card-bearing pages can't silently ship with dead Start/Done buttons. -->
[% IF c.stash.needs_todo_card_js %]
<script src="/static/js/planning/daily-plan-utils.js?v=[% cv %]" defer></script>
[% END %]

<!-- Beekeeping voice inspection recording (Apiary HiveManagement) -->
[% IF c.request.uri.match('/Apiary/HiveManagement') %]
<script src="/static/js/apiary/voice.js?v=[% cv %]" defer></script>
[% END %]

<!-- File Manager (convert/move helpers) -->
[% IF c.request.uri.match('/file/') %]
<script src="/static/js/file/convert.js?v=[% cv %]" defer></script>
[% END %]

<!-- Docker container management pages -->
[% IF c.request.uri.match('/admin/docker-containers-working') %]
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/xterm@5.3.0/css/xterm.css" />
<script src="https://cdn.jsdelivr.net/npm/xterm@5.3.0/lib/xterm.js" defer></script>
<script src="https://cdn.jsdelivr.net/npm/xterm-addon-fit@0.8.0/lib/xterm-addon-fit.js" defer></script>
<script src="/static/js/docker-containers-working.js?v=[% cv %]" defer></script>
[% ELSIF c.request.uri.match('/admin/docker-containers') %]
<script src="/static/js/docker-containers.js?v=[% cv %]" defer></script>
[% END %]
<!-- <script src="/static/js/nav-back.js?v=[% cv %]" defer></script> -->

<!-- Third-party (CDN preferred for large libs) -->
<script src="https://unpkg.com/htmx.org@1.9.12" defer></script>

[%# Force HTMX init early on /todo/details for debugging %]
[% IF c.request.uri.match('/todo/details') %]
<script>
  document.addEventListener('DOMContentLoaded', function() {
    if (window.htmx) {
      console.log('%c[HTMX] Loaded and ready on /todo/details', 'color:#06c');
      // Optional: window.htmx.logAll();
    } else {
      console.error('[HTMX] Failed to load!');
    }
  });
</script>
[% END %]
<script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.32.3/ace.min.js" defer></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/ace/1.32.3/ext-language_tools.js" defer></script>

[%# Page-specific initialization data (safe global config) %]
<script>
    window.ComservConfig = {
        debug: [% c.session.debug_mode || 0 %],
        username: '[% c.session.username | html %]',
        isAdmin: [% (c.stash.is_admin || c.session.is_admin) ? 'true' : 'false' %],
        isEditor: [% c.stash.is_editor ? 'true' : 'false' %],
        siteName: '[% c.stash.SiteName || c.session.SiteName | html %]',
        cv: '[% cv %]',
        // Canonical model catalog — THE single source of truth for every chat
        // surface (floating "Chat with AI" widget, /ai page, admin/AI, git
        // dashboard, AI2 editor). Built per-request in Root.pm auto from the v2
        // Router (Model::AI2->get_available_models) — the SAME source as
        // /ai2/providers — and emitted via the stash so it is always current and
        // identical for every role (including an admin whose session predates a
        // change). The chat widget reads this instead of fetching /ai2/providers
        // on every open: no per-use fetch, no render race, guaranteed parity.
        // NOTE: read the stash value (set every request), not the session value,
        // so a stale per-session cache can never hide the full list.
        models: [% c.stash.ai_model_catalog_json || '[]' %],
        // Add more as needed - keep this small
    };
</script>

[%# Global init call - runs after all scripts load %]
<script defer>
    document.addEventListener('DOMContentLoaded', function() {
        if (window.ComservInit) {
            window.ComservInit();
        }
        console.log('%c[Comserv] JS modules loaded successfully', 'color:#0a0;font-weight:bold;');
    });
</script>
[%# ============================================================
   AI EDITOR LOADING – TWO SEPARATE SYSTEMS
   ============================================================

   1. LEGACY WIDGET (temporary / deprecated path)
      - Used only by old templates that set show_code_editor_widget
      - File: ai-editing-widget-float.js (monolithic)
      - Will be removed once all pages are migrated to the new system

   2. MODERN AI2 EDITOR (preferred / modular)
      - Uses the new ai2editor/ directory structure
      - Loaded for ai_popup_mode or /ai2/ routes
      - All new development must use this path
============================================================ %]
<script src="/static/js/ai2editor/popup.js?v=[% cv %]" defer></script>
[%# AI Editor Button (v2) - Separate Window
    Pass the current page's editable source file (its .tt template, relative to
    the project root) so the popup opens with that file already loaded. Pages
    rendered without a stash template (e.g. body-only or external) fall back to
    opening the editor empty, preserving prior behaviour. %]
[% current_editor_file = '' %]
[% IF c.stash.template %][% current_editor_file = 'root/' _ c.stash.template %][% END %]
[% IF c.session.user_id && !c.request.uri.match('/ai2/') %]
<button class="btn btn-primary btn-sm ai2-float-btn"
        onclick="openAI2EditorWindow('[% current_editor_file | html %]')"
        title="Open AI2 Code Editor (v2) — edits the current page source">
    ✏️ AI Editor
</button>
[% END %]

[%# ---------------------------------------------------------------------------
   SERVER-RENDERED AI model <select> for the floating "Chat with AI" widget.
   Rendered here (every page) from the catalog in stash so the widget never has
   to build its dropdown in JS. The widget's createChatWidget() finds this node
   by id and MOVES it into the provider-selector bar (replacing the placeholder).
   Hidden until the widget needs it. This is the single source of truth — the
   same ai/model_select.tt partial every other surface uses.
--------------------------------------------------------------------------- %]
<div id="ai-provider-server-rendered" style="display:none;">
[% PROCESS 'ai/model_select.tt'
    select_id   = 'ai-provider',
    select_name = 'model',
    page        = 'chat',
    current     = ai_default_model,
    css_class   = 'ai-model-select',
    catalog     = ai_model_catalog %]
</div>

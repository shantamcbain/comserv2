[% META title = 'Git Pull Confirmation' %]
[%# File: root/admin/git_pull.tt %]
[% PageVersion = 'admin/git_pull.tt,v 0.05 2026/07/31 shanta Exp shanta ' %]

[% IF c.session.debug_mode == 1 %]
    [% PageVersion %]
[% END %]

<!-- Quick Navigation -->
<div class="quick-nav">
    <a href="[% c.uri_for('/admin/git') %]" class="admin-btn admin-btn-secondary admin-btn-sm">
        <i class="fas fa-arrow-left"></i> Back to Git Dashboard
    </a>
    <a href="[% c.uri_for('/admin/branch_management') %]" class="admin-btn admin-btn-info admin-btn-sm">
        <i class="fas fa-code-branch"></i> Branch Management
    </a>
</div>

<div class="app-container">
    <div class="content-container">
        <div class="content-primary">
            <h1>Git Pull Confirmation</h1>

            [% IF debug_msg || c.session.debug_mode == 1 %]
                <div class="admin-alert admin-alert-info">
                    <strong>Debug Information:</strong>
                    [% IF debug_msg %]
                        [% FOREACH msg IN debug_msg %]
                            <p>[% msg %]</p>
                        [% END %]
                    [% END %]
                    <p>User exists: [% c.user_exists ? 'Yes' : 'No' %]</p>
                    <p>Username: [% (c.user ? c.user.username : 'Not logged in') %]</p>
                    <p>Session roles: [% c.session.roles.join(', ') || 'None' %]</p>
                    <p>Is admin: [% c.session.roles.grep('^admin$').size ? 'Yes' : 'No' %]</p>
                </div>
            [% END %]

            [% IF error_msg %]
                <div class="admin-alert admin-alert-danger">
                    <strong>Error:</strong> [% error_msg %]
                </div>
            [% END %]

            [% IF success_msg %]
                <div class="admin-alert admin-alert-success">
                    <strong>Success:</strong> [% success_msg %]
                </div>
            [% END %]

            [% IF warning_msg %]
                <div class="admin-alert admin-alert-warning">
                    <strong>Warning:</strong> [% warning_msg %]
                </div>
            [% END %]

            [% IF output %]
                <div class="admin-panel">
                    <div class="admin-panel-header">
                        <h3>Git Command Output</h3>
                    </div>
                    <div class="admin-panel-body">
                        <pre class="command-output">[% output | html %]</pre>
                    </div>
                </div>

                <div class="admin-form-actions">
                    <a href="[% c.uri_for('/admin/git_pull') %]" class="admin-btn admin-btn-primary">
                        <i class="fas fa-sync"></i> Pull Again
                    </a>
                    <a href="[% c.uri_for('/admin/git') %]" class="admin-btn admin-btn-secondary">
                        <i class="fas fa-arrow-left"></i> Back to Git Dashboard
                    </a>
                </div>
            [% ELSE %]
                <div class="admin-alert admin-alert-warning">
                    <strong>Warning:</strong> This action will pull the latest changes from the Git repository.
                </div>

                <div class="admin-alert admin-alert-info">
                    <strong>Note:</strong> Changes to <code class="code-inline">theme_mappings.json</code> will be automatically handled:
                    <ul>
                        <li>Your local changes will be backed up</li>
                        <li>Changes will be stashed before pulling</li>
                        <li>After pulling, your changes will be reapplied</li>
                        <li>If conflicts occur, you can restore from the backup</li>
                    </ul>
                </div>

                <div class="admin-panel">
                    <div class="admin-panel-header">
                        <h3>Confirm Git Pull</h3>
                    </div>
                    <div class="admin-panel-body">
                        <p>
                            Pulling from Git will update your local repository with the latest changes from the remote repository.
                            This operation is generally safe, but if you have local changes, they might conflict with the remote changes.
                        </p>

                        [% IF current_branch %]
                        <p>
                            <strong>Current Branch:</strong>
                            <span class="status-badge">[% current_branch | html %]</span>
                        </p>
                        [% END %]

                        <p>Are you sure you want to proceed?</p>

                        <form method="POST" action="[% c.uri_for('/admin/git_pull') %]">
                            <input type="hidden" name="confirm" value="1">

                            [% IF available_branches && available_branches.size > 0 %]
                            <div class="admin-form-group">
                                <label for="branch"><strong>Select Branch to Pull:</strong></label>
                                <select name="branch" id="branch" class="admin-form-control">
                                    [% FOREACH branch IN available_branches %]
                                        <option value="[% branch | html %]" [% IF branch == current_branch %]selected[% END %]>
                                            [% branch | html %] [% IF branch == current_branch %](current)[% END %]
                                        </option>
                                    [% END %]
                                </select>
                                <small class="admin-form-help">
                                    Select the branch you want to pull from. The current branch is pre-selected.<br>
                                    <strong>Note:</strong> Master branches are excluded from the list as requested.
                                    Use <a href="[% c.uri_for('/admin/branch_management') %]">Branch Management</a> for advanced operations.
                                </small>
                            </div>
                            [% ELSE %]
                            <input type="hidden" name="branch" value="[% current_branch || 'main' %]">
                            [% END %]

                            <div class="admin-form-actions">
                                <button type="submit" class="admin-btn admin-btn-primary">
                                    <i class="fas fa-code-branch"></i> Yes, Pull from Git
                                </button>
                                <a href="[% c.uri_for('/admin/git') %]" class="admin-btn admin-btn-secondary">
                                    <i class="fas fa-times"></i> Cancel
                                </a>
                            </div>
                        </form>
                    </div>
                </div>
            [% END %]
        </div>
    </div>
</div>

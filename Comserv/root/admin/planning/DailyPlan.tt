[% META
   title = "Daily Planning"
   description = "Daily planning hub: action bar (Start Day / End Day / Logs) and tabs for Priorities, Master Plan, and Calendar."
   roles = "admin,developer,devops,editor,user,normal"
   TemplateType = "Application"
   category = "planning"
   page_version = "4.0"
   last_updated = "2026-08-13"
%]
[% SET is_csc = is_csc || (c.stash.SiteName == 'CSC') || (c.session.SiteName == 'CSC') %]

<link rel="stylesheet" href="/static/css/planning/daily-plan.css">

<div class="daily-index">

    <div class="daily-plan-header">
        <h1>[PLANNING] <a href="/planning/daily/[% selected_date %]">[% display_date %]</a></h1>
        <div class="header-date-nav">
            <a href="/planning/daily/[% prev_date %]" class="prev-day-link">← Prev Day</a>
            | Viewing [% display_date %] |
            <a href="/planning/daily/[% next_date %]" class="next-day-link">Next Day →</a>
            &nbsp;|&nbsp;
            <a href="/planning/daily/[% current_date_str %]">Today</a>
        </div>
    </div>

    [%# ── ACTION CARD (above the tab bar) ──
        Start Day / End Day / Logs / Triage / Reschedule controls. The same controls
        also exist inside the Priorities tab (in _today_work_tab.tt), but DailyPlan.tt
        passes hide_action_bar = 1 to that include so only THIS card shows — no duplicate. %]
    <div class="daily-action-card">
        <div class="daily-action-card-title">Day Controls</div>
        <div class="ActionBar">
            <a href="/todo/addtodo" class="ActionBarLink ActionBarLink--primary">+ Add Todo</a>
            <a href="/todo" class="ActionBarLink">All Todos</a>
            <a href="/log" class="ActionBarLink">Logs</a>
            <button class="ActionBarBtn ActionBarBtn--teal" data-action="start-day" title="Start your day — audits application errors, checks HelpDesk, creates daily log">🌅 Start Day</button>
            [%# 'Open Logs' alert only appears when a log is still open/unclosed, so the
                user is told a log needs attention. Distinct from the permanent 'Logs'
                link above, which always lets them check what is still open today. %]
            [% IF open_log_entry %]
            <a href="#log-panel" class="ActionBarLink ActionBarLink--green" data-action="toggle-log-panel" title="Today's log is still open — a log was started but not closed">🌅 Open Logs</a>
            [% END %]
            <button class="ActionBarBtn ActionBarBtn--orange" data-action="end-day" title="End your day — closes today's open log entry">🌙 End Day</button>
            <span id="dl-feedback" class="ActionBarFeedback" aria-live="polite"></span>
            [% IF is_admin %]
            <button class="ActionBarBtn ActionBarBtn--orange" data-action="triage-stale" title="Reduce priority of todos inactive for 180+ days">⚠ Triage Stale</button>
            <button class="ActionBarBtn ActionBarBtn--purple" data-action="reschedule" title="Re-score all todos: staleness, due dates, blocking status — then reload">♻ Reschedule</button>
            [% END %]
        </div>
    </div>

    [%# ── TAB BAR ──
        Tab content is server-side INCLUDEd into the SAME document (never an AJAX
        ?tab= full-page fetch, which re-injected layout.tt and duplicated the
        floating buttons inside the tab). The embedded pages keep their own
        internal chrome inside their tab <div>, but the parent's floating buttons
        remain at body level and stay reachable. %]
    <div class="tab-navigation" role="tablist">
        <button class="tab-button active" data-tab="priorities" role="tab" aria-selected="true">🎯 Daily Priorities</button>
        <button class="tab-button" data-tab="master-plan" role="tab" aria-selected="false">🗺️ Master Plan</button>
        <button class="tab-button" data-tab="calendar" role="tab" aria-selected="false">📅 Calendar</button>
    </div>

    <div id="priorities" class="tab-content active" role="tabpanel">
        [% INCLUDE 'admin/planning/_today_work_tab.tt' hide_action_bar = 1 %]
    </div>

    <div id="master-plan" class="tab-content" role="tabpanel">
        [%# Interim bridge (todo #2107): in-tab MASTER_PLAN links do full-page
            navigation that destroys the tab's JS state. Until that is fixed,
            give a single "open in its own tab" escape hatch so plans/docs are
            navigable. This anchor targets _blank and is outside the SPA
            router, so it cannot break the parent tab's navigation. %]
        <p style="margin:6px 0 10px;padding:8px 12px;border-left:4px solid var(--primary-color);background:var(--bg-secondary,#f8f9fa);border-radius:4px;">
            <a href="/Documentation/MASTER_PLAN" target="_blank" rel="noopener" style="color:var(--primary-color);font-weight:600;text-decoration:none;">↗ Open Master Plan in a new tab</a>
            <span style="color:var(--text-muted-color);font-size:0.9em;"> — full plan + documentation navigation (in-tab links are being fixed in todo #2107)</span>
        </p>
        [% INCLUDE 'Documentation/MASTER_PLAN.tt' %]
    </div>

    <div id="calendar" class="tab-content" role="tabpanel">
        [%# Calendar tab: Day view is rendered INLINE (horizontal gcal grid,
            proven working). Day/Week/Month switching is done with plain links
            to the standalone /todo/day|week|month routes (which render
            horizontally and reliably) carrying the date. This avoids the
            fragile inline multi-view include experiment. %]
        <div class="cal-view-subnav" style="display:flex;gap:8px;margin:10px 0 4px;">
            <a class="cal-view-link" href="/todo/day/[% selected_date %]" style="padding:6px 14px;border:1px solid var(--border-color);border-radius:6px;text-decoration:none;color:var(--text-color);font-weight:600;">Day</a>
            <a class="cal-view-link" href="/todo/week/[% selected_date %]" style="padding:6px 14px;border:1px solid var(--border-color);border-radius:6px;text-decoration:none;color:var(--text-color);font-weight:600;">Week</a>
            <a class="cal-view-link" href="/todo/month/[% selected_date %]" style="padding:6px 14px;border:1px solid var(--border-color);border-radius:6px;text-decoration:none;color:var(--text-color);font-weight:600;">Month</a>
        </div>
        [% INCLUDE 'todo/day.tt' include_mode = 1 %]
    </div>

    <p class="daily-index-legacy">
        Need the old all-in-one view? It is preserved for reference at
        <a href="/planning/daily-legacy">/planning/daily-legacy</a>.
    </p>

</div>

[% META title = 'Git Dashboard' %]
[%# File: root/admin/git/index.tt
    Single entry point for all git functionality. Route: Admin::Git::index (/admin/git).
    Compact vertical layout: a top summary strip (Repository + branch dropdown +
    push/pull) sits on one row; only the Working Tree card is open by default;
    branches / commits / stashes are collapsed <details> to save vertical space.
    Styles: /static/css/git-dashboard.css (loaded via Header.tt on this route).
    JS: /static/js/git-dashboard.js (js_load.tt). No inline <script>/<style>.
%]
[% PageVersion = 'admin/git/index.tt,v 0.02 2026/07/31 shanta Exp shanta ' %]

[% IF c.session.debug_mode == 1 %]
    [% PageVersion %]
[% END %]

<div class="quick-nav">
    <a href="[% c.uri_for('/admin') %]" class="admin-btn admin-btn-secondary admin-btn-sm">
        <i class="fas fa-arrow-left"></i> Back to Admin Dashboard
    </a>
</div>

<div class="app-container">
    <div class="content-container">
        <div class="content-primary">
            <h1><i class="fas fa-code-branch"></i> Git Dashboard</h1>

            [% IF debug_msg && c.session.debug_mode == 1 %]
                <div class="admin-alert admin-alert-info">
                    <strong>Debug Information:</strong>
                    [% FOREACH msg IN debug_msg %]
                        <p>[% msg | html %]</p>
                    [% END %]
                </div>
            [% END %]

            [% IF c.flash.error_msg %]
                <div class="admin-alert admin-alert-danger">
                    <strong>Error:</strong> [% c.flash.error_msg | html %]
                </div>
            [% END %]
            [% IF c.flash.success_msg %]
                <div class="admin-alert admin-alert-success">
                    <strong>Success:</strong> [% c.flash.success_msg | html %]
                </div>
            [% END %]

            [%# ============ Top summary strip (one row, cards fit content) ============ %]
            <div class="git-strip">

                [%# ---- Repository + branch selector (replaces the old Branches card) ---- %]
                <div class="git-card git-card--grow">
                    <h4>Repository</h4>
                    <div class="git-inline">
                        [%# Switch branch by selecting from the dropdown %]
                        <form method="post" action="[% c.uri_for('/admin/git/action') %]"
                              class="inline-form" data-git-switch-form="1">
                            <input type="hidden" name="op" value="switch">
                            <input type="hidden" name="confirm" value="1">
                            <select name="branch" class="form-control git-select"
                                    data-git-switch-select="1" title="Switch branch">
                                [% FOREACH b IN branch_details %]
                                <option value="[% b.name | html %]"
                                    [% IF b.is_current %]selected[% END %]>
                                    [% b.name | html %][% IF b.last_commit_relative %] · [% b.last_commit_relative | html %][% END %]
                                </option>
                                [% END %]
                            </select>
                        </form>

                        [% IF tracking.upstream %]
                            [% IF tracking.ahead == 0 && tracking.behind == 0 %]
                                <span class="section-info"><i class="fas fa-check"></i> up to date</span>
                            [% ELSE %]
                                [% IF tracking.ahead > 0 %]
                                <span class="section-info-warn"><i class="fas fa-upload"></i> [% tracking.ahead %] to push</span>
                                [% END %]
                                [% IF tracking.behind > 0 %]
                                <span class="section-info-warn"><i class="fas fa-download"></i> [% tracking.behind %] behind</span>
                                [% END %]
                            [% END %]
                        [% ELSE %]
                            <span class="section-info-warn">no upstream</span>
                        [% END %]
                    </div>
                    [% IF c.session.debug_mode == 1 %]
                    <div class="git-branch-meta">Repo: <code class="code-inline">[% repo_path | html %]</code></div>
                    [% END %]
                </div>

                [%# ---- Remote actions (fit width) ---- %]
                <div class="git-card git-card--fit">
                    <h4>Remote</h4>
                    <div class="git-inline">
                        <form method="post" action="[% c.uri_for('/admin/git_pull') %]" class="inline-form">
                            <input type="hidden" name="confirm" value="1">
                            <button type="submit" class="admin-btn admin-btn-sm admin-btn-primary">
                                <i class="fas fa-download"></i> Pull
                            </button>
                        </form>
                        <form method="post" action="[% c.uri_for('/admin/safe_git_pull') %]" class="inline-form">
                            <input type="hidden" name="confirm" value="1">
                            <button type="submit" class="admin-btn admin-btn-sm">
                                <i class="fas fa-shield-alt"></i> Safe Pull
                            </button>
                        </form>
                        <form method="post" action="[% c.uri_for('/admin/git/action') %]" class="inline-form"
                              data-git-confirm="Push [% tracking.ahead %] commit(s) on '[% current_branch | html %]' to origin?">
                            <input type="hidden" name="op" value="push">
                            <input type="hidden" name="confirm" value="1">
                            [% IF !tracking.upstream %]
                            <label class="checkbox-label"><input type="checkbox" name="set_upstream" value="1"> upstream</label>
                            [% END %]
                            <button type="submit" class="admin-btn admin-btn-sm"
                                    [% IF tracking.upstream && tracking.ahead == 0 %]disabled[% END %]>
                                <i class="fas fa-upload"></i> Push[% IF tracking.ahead > 0 %] ([% tracking.ahead %])[% END %]
                            </button>
                        </form>
                    </div>
                </div>

            </div>

            [%# ==================== Working Tree (the only open card) ==================== %]
            <div class="admin-panel git-worktree">
                <div class="admin-panel-header"><h3>Working Tree</h3></div>
                <div class="admin-panel-body">
                    [% IF git_status.has_changes %]
                    <form method="post" action="[% c.uri_for('/admin/git/action') %]"
                          id="git-file-form" data-git-file-form="1">
                        <input type="hidden" name="confirm" value="1">
                        <input type="hidden" name="op" value="" data-git-op-field="1">
                        <input type="hidden" name="confirm_permanent" value="" data-git-permanent-field="1">

                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th style="width:2rem">
                                        <input type="checkbox" data-git-check-all="1" title="Select all">
                                    </th>
                                    <th>File</th>
                                    <th style="width:7rem">State</th>
                                </tr>
                            </thead>
                            <tbody>
                                [% FOREACH f IN git_status.staged_files %]
                                <tr>
                                    <td><input type="checkbox" name="paths" value="[% f | html %]" data-git-file="1"></td>
                                    <td><code class="code-inline">[% f | html %]</code></td>
                                    <td><span class="status-badge">staged</span></td>
                                </tr>
                                [% END %]
                                [% FOREACH f IN git_status.modified_files %]
                                <tr>
                                    <td><input type="checkbox" name="paths" value="[% f | html %]" data-git-file="1"></td>
                                    <td><code class="code-inline">[% f | html %]</code></td>
                                    <td><span class="status-badge">modified</span></td>
                                </tr>
                                [% END %]
                                [% FOREACH f IN git_status.untracked_files %]
                                <tr>
                                    <td><input type="checkbox" name="paths" value="[% f | html %]"
                                               data-git-file="1" data-git-untracked="1"></td>
                                    <td><code class="code-inline">[% f | html %]</code></td>
                                    <td><span class="status-badge">untracked</span></td>
                                </tr>
                                [% END %]
                            </tbody>
                        </table>

                        <p>
                            <textarea name="message" placeholder="Commit / stash message"
                                      class="form-control" rows="2" data-git-message="1"></textarea>
                        </p>
                        <p>
                            <button type="button" class="admin-btn admin-btn-sm"
                                    data-git-suggest="1"
                                    data-git-suggest-url="[% c.uri_for('/admin/git/suggest_message') %]">
                                <i class="fas fa-robot"></i> Suggest message with AI
                            </button>
                            <span data-git-suggest-status="1" class="section-info-warn"></span>
                        </p>

                        <div class="git-actions">
                            <button type="button" class="admin-btn admin-btn-sm admin-btn-primary" data-git-action="stage">
                                <i class="fas fa-plus"></i> Stage
                            </button>
                            <button type="button" class="admin-btn admin-btn-sm" data-git-action="unstage">
                                <i class="fas fa-minus"></i> Unstage
                            </button>
                            <button type="button" class="admin-btn admin-btn-sm admin-btn-primary"
                                    data-git-action="commit" data-git-confirm="Commit the selected / staged changes?">
                                <i class="fas fa-check"></i> Commit
                            </button>
                            <button type="button" class="admin-btn admin-btn-sm"
                                    data-git-action="stash" data-git-confirm="Stash the selected file(s)?">
                                <i class="fas fa-box"></i> Stash
                            </button>
                            <button type="button" class="admin-btn admin-btn-sm"
                                    data-git-action="gitignore" data-git-confirm="Add the selected untracked file(s) to .gitignore?">
                                <i class="fas fa-eye-slash"></i> .gitignore
                            </button>
                            <button type="button" class="admin-btn admin-btn-sm admin-btn-danger"
                                    data-git-action="delete"
                                    data-git-confirm="Delete the selected file(s)? Tracked files are removed via git (recoverable); untracked files are permanently deleted.">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                    </form>
                    [% ELSE %]
                        <p><i class="fas fa-check"></i> Working tree clean.</p>
                    [% END %]
                </div>
            </div>

            [%# ==================== Branches (collapsed) ==================== %]
            <details class="git-collapse">
                <summary>Branches <span class="git-count">([% branch_details.size %])</span></summary>
                <div class="git-collapse-body">
                    <div class="git-branch-grid">
                        [% FOREACH b IN branch_details %]
                        <div class="git-branch-item[% IF b.is_current %] is-current[% END %]">
                            <div class="git-branch-name">
                                [% b.name | html %]
                                [% IF b.is_current %]<span class="status-badge">current</span>[% END %]
                            </div>
                            <div class="git-branch-meta">
                                [% IF b.last_commit_relative %][% b.last_commit_relative | html %][% END %]
                                [% IF b.upstream %] · tracks [% b.upstream | html %][% ELSE %] · local only[% END %]
                            </div>
                            [% IF b.last_commit_subject %]
                            <div class="git-branch-meta">[% b.last_commit_subject | html %]</div>
                            [% END %]
                            <div class="git-branch-actions">
                                [% UNLESS b.is_current %]
                                <form method="post" action="[% c.uri_for('/admin/git/action') %]" class="inline-form"
                                      data-git-confirm="Switch to branch '[% b.name | html %]'? Uncommitted changes are auto-stashed.">
                                    <input type="hidden" name="op" value="switch">
                                    <input type="hidden" name="confirm" value="1">
                                    <input type="hidden" name="branch" value="[% b.name | html %]">
                                    <button type="submit" class="admin-btn admin-btn-sm">
                                        <i class="fas fa-exchange-alt"></i> Switch
                                    </button>
                                </form>
                                [% END %]
                                [% IF b.removable %]
                                <form method="post" action="[% c.uri_for('/admin/git/action') %]" class="inline-form"
                                      data-git-confirm="Delete branch '[% b.name | html %]' locally and on origin? This cannot be undone.">
                                    <input type="hidden" name="op" value="delbranch">
                                    <input type="hidden" name="confirm" value="1">
                                    <input type="hidden" name="branch" value="[% b.name | html %]">
                                    <button type="submit" class="admin-btn admin-btn-sm admin-btn-danger">
                                        <i class="fas fa-trash"></i> Remove
                                    </button>
                                </form>
                                [% END %]
                            </div>
                        </div>
                        [% END %]
                    </div>
                </div>
            </details>

            [%# ==================== Recent commits (collapsed) ==================== %]
            <details class="git-collapse">
                <summary>Recent Commits <span class="git-count">([% recent_commits.size %])</span></summary>
                <div class="git-collapse-body">
                    [% IF recent_commits.size %]
                    <ul class="git-list">
                        [% FOREACH cmt IN recent_commits %]
                        <li>
                            <code class="code-inline">[% cmt.hash | html %]</code>
                            <span>[% cmt.message | html %]</span>
                        </li>
                        [% END %]
                    </ul>
                    [% ELSE %]<p>No commits found.</p>[% END %]
                </div>
            </details>

            [%# ==================== Stashes (collapsed, only if any) ==================== %]
            [% IF stash_list.size %]
            <details class="git-collapse">
                <summary>Stashes <span class="git-count">([% stash_list.size %])</span></summary>
                <div class="git-collapse-body">
                    <ul class="git-list">
                        [% FOREACH s IN stash_list %]
                        <li>
                            <code class="code-inline">[% s.ref | html %]</code>
                            <span>[% s.message | html %]</span>
                        </li>
                        [% END %]
                    </ul>
                    <div class="git-actions">
                        <a href="[% c.uri_for('/admin/git_stash') %]" class="admin-btn admin-btn-sm">Manage stashes</a>
                    </div>
                </div>
            </details>
            [% END %]

        </div>
    </div>
</div>

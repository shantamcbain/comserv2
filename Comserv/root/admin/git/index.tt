[% META title = 'Git Dashboard' %]
[%# File: root/admin/git/index.tt
    Single entry point for all git functionality. Route: Admin::Git::index (/admin/git).
    Compact vertical layout: a top summary strip (Repository + branch dropdown +
    push/pull) sits on one row; only the Working Tree card is open by default;
    branches / commits / stashes are collapsed <details> to save vertical space.
    Styles: /static/css/git-dashboard.css (loaded via Header.tt on this route).
    JS: /static/js/git-dashboard.js (js_load.tt). No inline <script>/<style>.
%]
[% PageVersion = 'admin/git/index.tt,v 0.02 2026/07/31 shanta Exp shanta ' %]

[%# Absolute-URL building for branch links (RELATIVE-URL TRAP: a relative path
    resolves against the current page origin, so the Open button would reopen
    the SAME server instead of the branch's own port). Build the full URL. #]
[% SET scheme = c.req.uri.scheme %]
[% SET host = c.req.uri.host %]

[% IF c.session.debug_mode == 1 %]
    [% PageVersion %]
[% END %]

<div class="quick-nav">
    <a href="[% c.uri_for('/admin') %]" class="admin-btn admin-btn-secondary admin-btn-sm">
        <i class="fas fa-arrow-left"></i> Back to Admin Dashboard
    </a>
</div>

<div class="app-container">
    <div class="content-container">
        <div class="content-primary">
            <h1><i class="fas fa-code-branch"></i> Git Dashboard <span class="git-current-branch git-current-branch--head" title="Branch this dashboard is operating on">
                <i class="fas fa-code-branch"></i> <strong>[% current_branch | html %]</strong></span></h1>

            <div class="admin-panel" data-create-worktree-panel="1">
                <div class="admin-panel-header"><h3><i class="fas fa-plus"></i> New Branch + Worktree</h3></div>
                <div class="admin-panel-body">
                    <form data-create-worktree-form="1" class="git-inline">
                        <label>Branch
                            <input type="text" name="branch" required pattern="[A-Za-z0-9._/-]+"
                                   placeholder="feature/name" class="form-control">
                        </label>
                        <label>Parent
                            <input type="text" name="parent" value="main" class="form-control">
                        </label>
                        <button type="submit" class="admin-btn admin-btn-primary">
                            <i class="fas fa-code-branch"></i> Create Branch + Worktree
                        </button>
                        <span data-create-worktree-status="1" class="section-info"></span>
                    </form>
                </div>
            </div>

            [% IF debug_msg && c.session.debug_mode == 1 %]
                <div class="admin-alert admin-alert-info">
                    <strong>Debug Information:</strong>
                    [% FOREACH msg IN debug_msg %]
                        <p>[% msg | html %]</p>
                    [% END %]
                </div>
            [% END %]

            [% IF c.flash.error_msg %]
                <div class="admin-alert admin-alert-danger">
                    <strong>Error:</strong> [% c.flash.error_msg | html %]
                </div>
            [% END %]
            [% IF c.flash.success_msg %]
                <div class="admin-alert admin-alert-success">
                    <strong>Success:</strong> [% c.flash.success_msg | html %]
                </div>
            [% END %]

            [%# ============ Top summary strip (one row, cards fit content) ============ %]
            <div class="git-strip">

                [%# ---- Host / target selector (run git on local or a remote host over SSH) ---- %]
                <div class="git-card git-card--fit">
                    <h4>Host</h4>
                    <div class="git-inline">
                        <select name="target" class="form-control git-select" id="git-target-select"
                                title="Run git on this host">
                            [% FOREACH t IN git_targets %]
                            <option value="[% t.key | html %]"
                                [% IF t.key == git_target %]selected[% END %]>
                                [% t.label | html %]
                            </option>
                            [% END %]
                        </select>
                    </div>
                    <div class="git-branch-meta" id="git-target-path">[% IF git_target == 'local' || !git_target %]local: <code class="code-inline">[% repo_path | html %]</code>[% END %]</div>
                </div>

                [%# ---- Repository + branch selector (replaces the old Branches card) ---- %]
                <div class="git-card git-card--grow">
                    <h4>Repository <span class="git-current-branch git-current-branch--head" title="Branch this dashboard is operating on">
                        <i class="fas fa-code-branch"></i> <strong>[% current_branch | html %]</strong></span></h4>
                    <div class="git-inline">
                        [% IF current_branch && current_branch != 'main' && current_branch != 'master' %]
                        <span class="section-info"><i class="fas fa-lock"></i> Worktree checkout — stays on <code class="code-inline">[% current_branch | html %]</code>. Cannot switch to main (already checked out in the primary repo). Merge main into this branch below.</span>
                        [% ELSE %]
                        <form method="post" action="[% c.uri_for('/admin/git/action') %]"
                              class="inline-form" data-git-switch-form="1">
                            <input type="hidden" name="op" value="switch">
                            <input type="hidden" name="confirm" value="1">
                            <select name="branch" class="form-control git-select"
                                    data-git-switch-select="1" title="Switch branch">
                                [% FOREACH b IN branch_details %]
                                [% IF b.name != 'git' %]
                                [% SET skip_wt = 0 %]
                                [% UNLESS b.is_current %]
                                    [% FOREACH w IN worktree_list %]
                                        [% IF w.name == b.name && w.name != 'main' %][% SET skip_wt = 1 %][% END %]
                                    [% END %]
                                [% END %]
                                [% UNLESS skip_wt %]
                                <option value="[% b.name | html %]"
                                    [% IF b.is_current %]selected[% END %]>
                                    [% b.name | html %][% IF b.last_commit_relative %] · [% b.last_commit_relative | html %][% END %]
                                </option>
                                [% END %]
                                [% END %]
                                [% END %]
                            </select>
                        </form>
                        [% END %]

                        [%# -- Relationship to the integration base (main) = the PRIMARY signal -- %]
                        [% IF tracking.upstream %]
                            [% IF tracking.ahead == 0 && tracking.behind == 0 %]
                                <span class="section-info"><i class="fas fa-check"></i> up to date with upstream</span>
                            [% ELSE %]
                                [% IF tracking.ahead > 0 %]
                                <span class="section-info"><i class="fas fa-upload"></i> [% tracking.ahead %] to push</span>
                                [% END %]
                                [% IF tracking.behind > 0 %]
                                <span class="section-info-warn"><i class="fas fa-download"></i> [% tracking.behind %] behind upstream</span>
                                [% END %]
                            [% END %]
                        [% ELSIF tracking.base %]
                            [% IF tracking.base_behind > 0 %]
                                <span class="section-info-danger"><i class="fas fa-arrow-down"></i> <strong>[% tracking.base_behind %] behind [% tracking.base | html %]</strong> — update this branch before working</span>
                            [% END %]
                            [% IF tracking.base_ahead > 0 %]
                                <span class="section-info"><i class="fas fa-code-branch"></i> <strong>[% tracking.base_ahead %] ahead of [% tracking.base | html %]</strong> — ready to merge into [% tracking.base | html %]</span>
                            [% END %]
                            [% IF tracking.base_ahead == 0 && tracking.base_behind == 0 %]
                                <span class="section-info"><i class="fas fa-check"></i> in sync with [% tracking.base | html %]</span>
                            [% END %]
                            <span class="section-info-muted">no GitHub upstream — local-merge workflow (merge into main, don't push per-branch)</span>
                        [% ELSE %]
                            <span class="section-info-warn">no upstream</span>
                        [% END %]
                    </div>
                    [% IF c.session.debug_mode == 1 %]
                    <div class="git-branch-meta">Repo: <code class="code-inline">[% repo_path | html %]</code></div>
                    [% END %]
                </div>

                [%# ---- Remote actions: ONLY relevant for branches with a GitHub upstream ---- %]
                [% IF tracking.upstream %]
                <div class="git-card git-card--fit">
                    <h4>Remote</h4>
                    <div class="git-inline">
                        <form method="post" action="[% c.uri_for('/admin/git_pull') %]" class="inline-form">
                            <input type="hidden" name="confirm" value="1">
                            <button type="submit" class="admin-btn admin-btn-sm admin-btn-primary">
                                <i class="fas fa-download"></i> Pull
                            </button>
                        </form>
                        <form method="post" action="[% c.uri_for('/admin/safe_git_pull') %]" class="inline-form">
                            <input type="hidden" name="confirm" value="1">
                            <button type="submit" class="admin-btn admin-btn-sm">
                                <i class="fas fa-shield-alt"></i> Safe Pull
                            </button>
                        </form>
                        <form method="post" action="[% c.uri_for('/admin/git/action') %]" class="inline-form"
                              data-git-confirm="Push [% tracking.ahead %] commit(s) on '[% current_branch | html %]' to origin?">
                            <input type="hidden" name="op" value="push">
                            <input type="hidden" name="confirm" value="1">
                            [% IF !tracking.upstream %]
                            <label class="checkbox-label"><input type="checkbox" name="set_upstream" value="1"> upstream</label>
                            [% END %]
                            <button type="submit" class="admin-btn admin-btn-sm"
                                    [% IF tracking.upstream && tracking.ahead == 0 %]disabled[% END %]>
                                <i class="fas fa-upload"></i> Push[% IF tracking.ahead > 0 %] ([% tracking.ahead %])[% END %]
                            </button>
                        </form>
                    </div>
                </div>
                [% END %]

            </div>

            [%# ==================== Working Tree (the only open card) ==================== %]
            <div class="admin-panel git-worktree">
                <div class="admin-panel-header"><h3>Working Tree</h3></div>
                <div class="admin-panel-body">
                    [% IF git_status.has_changes %]
                    <form method="post" action="[% c.uri_for('/admin/git/action') %]"
                          id="git-file-form" data-git-file-form="1">
                        <input type="hidden" name="confirm" value="1">
                        <input type="hidden" name="op" value="" data-git-op-field="1">
                        <input type="hidden" name="confirm_permanent" value="" data-git-permanent-field="1">

                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th style="width:2rem">
                                        <input type="checkbox" data-git-check-all="1" title="Select all">
                                    </th>
                                    <th>File</th>
                                    <th style="width:7rem">State</th>
                                </tr>
                            </thead>
                            <tbody>
                                [% FOREACH f IN git_status.staged_files %]
                                <tr>
                                    <td><input type="checkbox" name="paths" value="[% f | html %]" data-git-file="1"></td>
                                    <td><code class="code-inline">[% f | html %]</code>
                                        <button type="button" class="admin-btn admin-btn-sm" data-git-view-diff="[% f | html %]" style="margin-left:8px;">Diff</button></td>
                                    <td><span class="status-badge">staged</span></td>
                                </tr>
                                [% END %]
                                [% FOREACH f IN git_status.modified_files %]
                                <tr>
                                    <td><input type="checkbox" name="paths" value="[% f | html %]" data-git-file="1"></td>
                                    <td><code class="code-inline">[% f | html %]</code>
                                        <button type="button" class="admin-btn admin-btn-sm" data-git-view-diff="[% f | html %]" style="margin-left:8px;">Diff</button></td>
                                    <td><span class="status-badge">modified</span></td>
                                </tr>
                                [% END %]
                                [% FOREACH f IN git_status.untracked_files %]
                                <tr>
                                    <td><input type="checkbox" name="paths" value="[% f | html %]"
                                              data-git-file="1" data-git-untracked="1"></td>
                                    <td><code class="code-inline">[% f | html %]</code>
                                        <button type="button" class="admin-btn admin-btn-sm" data-git-view-diff="[% f | html %]" style="margin-left:8px;">Diff</button></td>
                                    <td><span class="status-badge">untracked</span></td>
                                </tr>
                                [% END %]
                            </tbody>
                        </table>

                        <div id="git-file-diff" class="git-file-diff" style="display:none;margin-top:12px;">
                            <div class="git-file-diff-head" style="display:flex;justify-content:space-between;align-items:center;margin-bottom:6px;">
                                <strong id="git-file-diff-title" style="color:var(--text-color,#222);"></strong>
                                <button type="button" class="admin-btn admin-btn-sm" id="git-file-diff-close">Close</button>
                            </div>
                            <pre id="git-file-diff-content" class="git-file-diff-content" style="background:#1e1f22;color:#9cdcfe;padding:10px;border:1px solid #444;border-radius:4px;max-height:50vh;overflow:auto;white-space:pre-wrap;font-size:12px;"></pre>
                        </div>

                        <p>
                            <textarea name="message" placeholder="Commit / stash message"
                                      class="form-control" rows="2" data-git-message="1"></textarea>
                        </p>
                        <p>
                            <label for="git-commit-ai-model">AI model for commit message:</label>
                            <select id="git-commit-ai-model" class="form-control"
                                    data-git-ai-model="1">
                                <option value="">Use automatic model selection</option>
                            </select>
                        </p>
                        <p>
                            <button type="button" class="admin-btn admin-btn-sm"
                                    data-git-suggest="1"
                                    data-git-suggest-url="[% c.uri_for('/admin/git/suggest_message') %]">
                                <i class="fas fa-robot"></i> Suggest message with AI
                            </button>
                            <span data-git-suggest-status="1" class="section-info-warn"></span>
                        </p>

                        <div class="git-actions">
                            <button type="button" class="admin-btn admin-btn-sm admin-btn-primary" data-git-action="stage">
                                <i class="fas fa-plus"></i> Stage
                            </button>
                            <button type="button" class="admin-btn admin-btn-sm" data-git-action="unstage">
                                <i class="fas fa-minus"></i> Unstage
                            </button>
                            <button type="button" class="admin-btn admin-btn-sm admin-btn-primary"
                                    data-git-action="commit" data-git-confirm="Commit the selected / staged changes?">
                                <i class="fas fa-check"></i> Commit
                            </button>
                            <button type="button" class="admin-btn admin-btn-sm"
                                    data-git-action="stash" data-git-confirm="Stash the selected file(s)?">
                                <i class="fas fa-box"></i> Stash
                            </button>
                            <button type="button" class="admin-btn admin-btn-sm"
                                    data-git-action="gitignore" data-git-confirm="Add the selected untracked file(s) to .gitignore?">
                                <i class="fas fa-eye-slash"></i> .gitignore
                            </button>
                            <button type="button" class="admin-btn admin-btn-sm admin-btn-danger"
                                    data-git-action="delete"
                                    data-git-confirm="Delete the selected file(s)? Tracked files are removed via git (recoverable); untracked files are permanently deleted.">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                    </form>
                    [% ELSE %]
                        <p><i class="fas fa-check"></i> Working tree clean.</p>
                    [% END %]
                </div>
            </div>

            [%# ==================== Develop Servers (zenflow worktree registry) ==================== %]
            [%# Single source of truth = stash.worktree_list (Comserv::Util::Git->build_worktree_list,\n               which reads root/config/worktrees.json). Mirrors the planning tab's "Branch Servers"\n               panel. Open/Stop/Restart buttons POST to /admin/branch_server_action (handled in\n               git-dashboard.js). No inline <script>. #]
            [% IF worktree_list && worktree_list.size %]
            <details class="git-collapse git-dev-servers">
                <summary>Develop Servers <span class="git-count">([% worktree_list.size %])</span></summary>
                <div class="git-collapse-body">
                    <table class="data-table git-dev-server-table">
                        <thead>
                            <tr>
                                <th>Branch</th>
                                <th>Port</th>
                                <th>Start Command</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            [% FOREACH b IN worktree_list %]
                            <tr[% IF b.name == current_branch %] class="git-dev-current"[% END %]>
                                <td>
                                    <code>[% b.label | html %]</code>
                                    [% IF b.name == current_branch %]<span class="status-badge">current</span>[% END %]
                                </td>
                                <td><code>:[% b.port %]</code></td>
                                <td>
                                    <code class="git-dev-cmd" title="[% b.cmd | html %]">[% b.cmd | html %]</code>
                                </td>
                                <td class="git-dev-actions">
                                    <button type="button" class="admin-btn admin-btn-sm admin-btn-primary"
                                            data-open-branch="[% b.name | html %]" data-port="[% b.port %]"
                                            data-url="[% scheme %]://[% host %]:[% b.port %][% b.url | html %]"
                                            data-cmd="[% b.cmd | html %]">Open</button>
                                    <button type="button" class="admin-btn admin-btn-sm"
                                            data-hermes-branch="[% b.name | html %]"
                                            data-hermes-cmd="[% b.hermes_cmd | html %]">Hermes</button>
                                    <button type="button" class="admin-btn admin-btn-sm admin-btn-danger"
                                            data-branch-action="stop" data-branch="[% b.name | html %]" data-port="[% b.port %]">Stop</button>
                                    <button type="button" class="admin-btn admin-btn-sm"
                                            data-branch-action="restart" data-branch="[% b.name | html %]" data-port="[% b.port %]">Restart</button>
                                </td>
                            </tr>
                            [% END %]
                        </tbody>
                    </table>
                </div>
            </details>

            [%# Live console modal for a branch server's startup log. Shown by the Open
               button (git-dashboard.js) so you can watch the server boot and read any
               command-line errors. Markup only — JS + /admin/branch_server_log drive it. #]
            <div id="git-dev-console" class="git-dev-console-overlay" style="display:none;">
                <div class="git-dev-console">
                    <div class="git-dev-console-header">
                        <span id="git-dev-console-title">Server console</span>
                        <button type="button" class="git-dev-console-close" data-git-dev-console-close="1">&times;</button>
                    </div>
                    <div class="git-dev-console-cmd" id="git-dev-console-cmd"></div>
                    <pre class="git-dev-console-log" id="git-dev-console-log">(waiting for output…)</pre>
                    <div class="git-dev-console-footer">
                        <a id="git-dev-console-open" href="#" target="_blank" class="admin-btn admin-btn-sm admin-btn-primary">Open server →</a>
                        <button type="button" class="admin-btn admin-btn-sm" data-git-dev-console-close="1">Close</button>
                    </div>
                </div>
            </div>
            [% END %]

            [%# ===== Merge (main <-> branch, one at a time) =====
                Driven by git-dashboard.js via data-attr delegation. Two directions:
                merge main into the selected branch (always allowed), or merge the
                selected branch into main (only when it is the active/checked-out
                branch, mirroring PyCharm). Conflicts reveal the Abort button. %]
            <details class="git-collapse git-merge-card">
                <summary>Merge <span class="git-count">(main &harr; branch, one at a time)</span></summary>
                <div class="git-collapse-body">
                    <div class="git-inline git-merge-controls">
                        <label>Branch
                            <select name="merge_branch" class="form-control git-select"
                                    id="git-merge-branch" data-git-merge-select="1"
                                    title="Branch to merge with main">
                                [% IF current_branch && current_branch != 'main' && current_branch != 'master' %]
                                <option value="[% current_branch | html %]" selected>[% current_branch | html %] (this checkout)</option>
                                [% ELSE %]
                                [% SET merge_sel = 0 %]
                                [% FOREACH b IN branch_details %]
                                [% IF b.name != 'git' && b.name != 'main' && b.name != 'master' %]
                                <option value="[% b.name | html %]"[% UNLESS merge_sel %] selected[% SET merge_sel = 1 %][% END %]>[% b.name | html %][% IF b.is_current %] (this checkout)[% END %]</option>
                                [% END %]
                                [% END %]
                                [% END %]
                            </select>
                        </label>
                    </div>

                    <p class="git-merge-hint">
                        <i class="fas fa-info-circle"></i>
                        This checkout: <code class="code-inline" data-git-current-branch="1">[% current_branch | html %]</code>
                    </p>
                    [% IF current_branch && current_branch != 'main' %]
                    <p class="git-merge-guideline">
                        <i class="fas fa-exclamation-triangle"></i>
                        You are on worktree <code class="code-inline">[% current_branch | html %]</code>.
                        <em>Merge main &rarr; this branch</em> updates <strong>this</strong> checkout from local main.
                        Do not switch to main. To land this branch on main, use the main dashboard (port 3001).
                    </p>
                    [% ELSE %]
                    <p class="git-merge-guideline">
                        <i class="fas fa-exclamation-triangle"></i>
                        <strong>Only <code class="code-inline">main</code> receives inbound merges.</strong>
                        Pick a worktree branch, then <em>Merge this branch &rarr; main</em>.
                    </p>
                    [% END %]

                    <div class="git-actions">
                        <button type="button" class="admin-btn admin-btn-sm admin-btn-primary"
                                data-git-merge="1" data-merge-direction="main-to-branch"
                                data-merge-url="[% c.uri_for('/admin/git/merge') %]">
                            <i class="fas fa-arrow-down"></i> Merge main &rarr; this branch
                        </button>
                        <button type="button" class="admin-btn admin-btn-sm admin-btn-primary"
                                data-git-merge="1" data-merge-direction="branch-to-main"
                                data-merge-url="[% c.uri_for('/admin/git/merge') %]">
                            <i class="fas fa-arrow-up"></i> Merge this branch &rarr; main
                        </button>
                        <button type="button" class="admin-btn admin-btn-sm admin-btn-danger"
                                data-git-merge-abort="1"
                                data-merge-abort-url="[% c.uri_for('/admin/git/merge/abort') %]"
                                style="display:none;">
                            <i class="fas fa-ban"></i> Abort merge
                        </button>
                    </div>

                    <div data-git-merge-status="1" class="git-merge-status"></div>
                    <pre data-git-merge-output="1" class="git-merge-output" style="display:none;"></pre>
                </div>
            </details>

            [%# ==================== Branches (collapsed) ==================== %]
            <details class="git-collapse">
                <summary>Branches <span class="git-count">([% branch_details.size %])</span></summary>
                <div class="git-collapse-body">
                    <div class="git-branch-grid">
                        [% FOREACH b IN branch_details %]
                        <div class="git-branch-item[% IF b.is_current %] is-current[% END %]">
                            <div class="git-branch-name">
                                [% b.name | html %]
                                [% IF b.is_current %]<span class="status-badge">current</span>[% END %]
                            </div>
                            <div class="git-branch-meta">
                                [% IF b.last_commit_relative %][% b.last_commit_relative | html %][% END %]
                                [% IF b.upstream %] · tracks [% b.upstream | html %][% ELSE %] · local only[% END %]
                            </div>
                            [% IF b.last_commit_subject %]
                            <div class="git-branch-meta">[% b.last_commit_subject | html %]</div>
                            [% END %]
                            <div class="git-branch-actions">
                                [% UNLESS b.is_current %]
                                <form method="post" action="[% c.uri_for('/admin/git/action') %]" class="inline-form"
                                      data-git-confirm="Switch to branch '[% b.name | html %]'? Uncommitted changes are auto-stashed.">
                                    <input type="hidden" name="op" value="switch">
                                    <input type="hidden" name="confirm" value="1">
                                    <input type="hidden" name="branch" value="[% b.name | html %]">
                                    <button type="submit" class="admin-btn admin-btn-sm">
                                        <i class="fas fa-exchange-alt"></i> Switch
                                    </button>
                                </form>
                                [% END %]
                                [% IF b.removable %]
                                <form method="post" action="[% c.uri_for('/admin/git/action') %]" class="inline-form"
                                      data-git-confirm="Delete branch '[% b.name | html %]' locally and on origin? This cannot be undone.">
                                    <input type="hidden" name="op" value="delbranch">
                                    <input type="hidden" name="confirm" value="1">
                                    <input type="hidden" name="branch" value="[% b.name | html %]">
                                    <button type="submit" class="admin-btn admin-btn-sm admin-btn-danger">
                                        <i class="fas fa-trash"></i> Remove
                                    </button>
                                </form>
                                [% END %]
                            </div>
                        </div>
                        [% END %]
                    </div>
                </div>
            </details>

            [%# ==================== Recent commits (collapsed) ==================== %]
            <details class="git-collapse">
                <summary>Recent Commits <span class="git-count">([% recent_commits.size %])</span></summary>
                <div class="git-collapse-body">
                    [% IF recent_commits.size %]
                    <ul class="git-list">
                        [% FOREACH cmt IN recent_commits %]
                        <li>
                            <code class="code-inline">[% cmt.hash | html %]</code>
                            <span>[% cmt.message | html %]</span>
                        </li>
                        [% END %]
                    </ul>
                    [% ELSE %]<p>No commits found.</p>[% END %]
                </div>
            </details>

            [%# ==================== Stashes (collapsed, only if any) ==================== %]
            [% IF stash_list.size %]
            <details class="git-collapse">
                <summary>Stashes <span class="git-count">([% stash_list.size %])</span></summary>
                <div class="git-collapse-body">
                    <ul class="git-list">
                        [% FOREACH s IN stash_list %]
                        <li>
                            <code class="code-inline">[% s.ref | html %]</code>
                            <span>[% s.message | html %]</span>
                        </li>
                        [% END %]
                    </ul>
                    <div class="git-actions">
                        <a href="[% c.uri_for('/admin/git_stash') %]" class="admin-btn admin-btn-sm">Manage stashes</a>
                    </div>
                </div>
            </details>
            [% END %]

        </div>
    </div>
</div>

[% META title = 'Git Dashboard' %]
[%# File: root/admin/git/index.tt
    Single entry point for all git functionality. Route: Admin::Git::index (/admin/git).
    Read-only in this phase; write operations still live on their own pages and are
    linked from the Actions panel below.
%]
[% PageVersion = 'admin/git/index.tt,v 0.01 2026/07/31 shanta Exp shanta ' %]

[% IF c.session.debug_mode == 1 %]
    [% PageVersion %]
[% END %]

<div class="quick-nav">
    <a href="[% c.uri_for('/admin') %]" class="admin-btn admin-btn-secondary admin-btn-sm">
        <i class="fas fa-arrow-left"></i> Back to Admin Dashboard
    </a>
</div>

<div class="app-container">
    <div class="content-container">
        <div class="content-primary">
            <h1><i class="fas fa-code-branch"></i> Git Dashboard</h1>

            [% IF debug_msg && c.session.debug_mode == 1 %]
                <div class="admin-alert admin-alert-info">
                    <strong>Debug Information:</strong>
                    [% FOREACH msg IN debug_msg %]
                        <p>[% msg | html %]</p>
                    [% END %]
                </div>
            [% END %]

            [% IF c.flash.error_msg %]
                <div class="admin-alert admin-alert-danger">
                    <strong>Error:</strong> [% c.flash.error_msg | html %]
                </div>
            [% END %]
            [% IF c.flash.success_msg %]
                <div class="admin-alert admin-alert-success">
                    <strong>Success:</strong> [% c.flash.success_msg | html %]
                </div>
            [% END %]

            [%# ---------------- Repository summary ---------------- %]
            <div class="admin-panel">
                <div class="admin-panel-header">
                    <h3>Repository</h3>
                </div>
                <div class="admin-panel-body">
                    <p>
                        <strong>Branch:</strong>
                        <span class="status-badge">[% current_branch | html %]</span>
                        [% IF tracking.upstream %]
                            &bull; <strong>Tracking:</strong>
                            <code class="code-inline">[% tracking.upstream | html %]</code>
                        [% ELSE %]
                            &bull; <em>No upstream configured</em>
                        [% END %]
                    </p>
                    <p>
                        [% IF tracking.ahead > 0 %]
                            <span class="section-info-warn">
                                <i class="fas fa-upload"></i>
                                [% tracking.ahead %] commit[% IF tracking.ahead != 1 %]s[% END %] to push
                            </span>
                        [% END %]
                        [% IF tracking.behind > 0 %]
                            [% IF tracking.ahead > 0 %]&bull;[% END %]
                            <span class="section-info-warn">
                                <i class="fas fa-download"></i>
                                [% tracking.behind %] commit[% IF tracking.behind != 1 %]s[% END %] behind
                            </span>
                        [% END %]
                        [% IF tracking.ahead == 0 && tracking.behind == 0 && tracking.upstream %]
                            <i class="fas fa-check"></i> Up to date with remote
                        [% END %]
                    </p>
                    [% IF c.session.debug_mode == 1 %]
                    <p><small>Repo path: <code class="code-inline">[% repo_path | html %]</code></small></p>
                    [% END %]
                </div>
            </div>

            [%# ---------------- Actions ---------------- %]
            <div class="admin-panel">
                <div class="admin-panel-header">
                    <h3>Actions</h3>
                </div>
                <div class="admin-panel-body">
                    <div class="admin-form-actions">
                        [%# Pull / Safe Pull are POST forms to the existing safe actions %]
                        <form method="post" action="[% c.uri_for('/admin/git_pull') %]" class="inline-form">
                            <input type="hidden" name="confirm" value="1">
                            <button type="submit" class="admin-btn admin-btn-primary">
                                <i class="fas fa-download"></i> Pull
                            </button>
                        </form>
                        <form method="post" action="[% c.uri_for('/admin/safe_git_pull') %]" class="inline-form">
                            <input type="hidden" name="confirm" value="1">
                            <button type="submit" class="admin-btn">
                                <i class="fas fa-shield-alt"></i> Safe Pull
                            </button>
                        </form>
                        [%# Push — posts to the unified dashboard action endpoint %]
                        <form method="post" action="[% c.uri_for('/admin/git/action') %]" class="inline-form"
                              data-git-confirm="Push [% tracking.ahead %] commit(s) on '[% current_branch | html %]' to origin?">
                            <input type="hidden" name="op" value="push">
                            <input type="hidden" name="confirm" value="1">
                            [% IF !tracking.upstream %]
                            <label class="checkbox-label">
                                <input type="checkbox" name="set_upstream" value="1"> set upstream
                            </label>
                            [% END %]
                            <button type="submit" class="admin-btn"
                                    [% IF tracking.upstream && tracking.ahead == 0 %]disabled[% END %]>
                                <i class="fas fa-upload"></i> Push
                                [% IF tracking.ahead > 0 %]([% tracking.ahead %])[% END %]
                            </button>
                        </form>
                        <a href="[% c.uri_for('/admin/branch_management') %]" class="admin-btn">
                            <i class="fas fa-code-branch"></i> Branches
                        </a>
                    </div>
                </div>
            </div>

            [%# ---------------- Working tree: select files + act ---------------- %]
            <div class="admin-panel">
                <div class="admin-panel-header">
                    <h3>Working Tree</h3>
                </div>
                <div class="admin-panel-body">
                    [% IF git_status.has_changes %]
                    <form method="post" action="[% c.uri_for('/admin/git/action') %]"
                          id="git-file-form" data-git-file-form="1">
                        <input type="hidden" name="confirm" value="1">
                        <input type="hidden" name="op" value="" data-git-op-field="1">
                        <input type="hidden" name="confirm_permanent" value="" data-git-permanent-field="1">

                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th style="width:2rem">
                                        <input type="checkbox" data-git-check-all="1" title="Select all">
                                    </th>
                                    <th>File</th>
                                    <th style="width:8rem">State</th>
                                </tr>
                            </thead>
                            <tbody>
                                [% FOREACH f IN git_status.staged_files %]
                                <tr>
                                    <td><input type="checkbox" name="paths" value="[% f | html %]" data-git-file="1"></td>
                                    <td><code class="code-inline">[% f | html %]</code></td>
                                    <td><span class="status-badge">staged</span></td>
                                </tr>
                                [% END %]
                                [% FOREACH f IN git_status.modified_files %]
                                <tr>
                                    <td><input type="checkbox" name="paths" value="[% f | html %]" data-git-file="1"></td>
                                    <td><code class="code-inline">[% f | html %]</code></td>
                                    <td><span class="status-badge">modified</span></td>
                                </tr>
                                [% END %]
                                [% FOREACH f IN git_status.untracked_files %]
                                <tr>
                                    <td><input type="checkbox" name="paths" value="[% f | html %]"
                                               data-git-file="1" data-git-untracked="1"></td>
                                    <td><code class="code-inline">[% f | html %]</code></td>
                                    <td><span class="status-badge">untracked</span></td>
                                </tr>
                                [% END %]
                            </tbody>
                        </table>

                        <p>
                            <input type="text" name="message" placeholder="Commit / stash message"
                                   class="form-control" data-git-message="1">
                        </p>

                        <div class="admin-form-actions">
                            <button type="button" class="admin-btn admin-btn-primary"
                                    data-git-action="stage">
                                <i class="fas fa-plus"></i> Stage
                            </button>
                            <button type="button" class="admin-btn"
                                    data-git-action="unstage">
                                <i class="fas fa-minus"></i> Unstage
                            </button>
                            <button type="button" class="admin-btn admin-btn-primary"
                                    data-git-action="commit"
                                    data-git-confirm="Commit currently staged changes?">
                                <i class="fas fa-check"></i> Commit
                            </button>
                            <button type="button" class="admin-btn"
                                    data-git-action="stash"
                                    data-git-confirm="Stash the selected file(s)?">
                                <i class="fas fa-box"></i> Stash Selected
                            </button>
                            <button type="button" class="admin-btn"
                                    data-git-action="gitignore"
                                    data-git-confirm="Add the selected untracked file(s) to .gitignore?">
                                <i class="fas fa-eye-slash"></i> Add to .gitignore
                            </button>
                            <button type="button" class="admin-btn admin-btn-danger"
                                    data-git-action="delete"
                                    data-git-confirm="Delete the selected file(s)? Tracked files are removed via git (recoverable); untracked files are permanently deleted.">
                                <i class="fas fa-trash"></i> Delete
                            </button>
                        </div>
                    </form>
                    [% ELSE %]
                        <p><i class="fas fa-check"></i> Working tree clean.</p>
                    [% END %]
                </div>
            </div>

            [%# ---------------- Recent commits ---------------- %]
            <div class="admin-panel">
                <div class="admin-panel-header">
                    <h3>Recent Commits</h3>
                </div>
                <div class="admin-panel-body">
                    [% IF recent_commits.size %]
                    <ul>
                        [% FOREACH cmt IN recent_commits %]
                        <li>
                            <code class="code-inline">[% cmt.hash | html %]</code>
                            [% cmt.message | html %]
                        </li>
                        [% END %]
                    </ul>
                    [% ELSE %]
                    <p>No commits found.</p>
                    [% END %]
                </div>
            </div>

            [%# ---------------- Branches ---------------- %]
            <div class="admin-panel">
                <div class="admin-panel-header">
                    <h3>Local Branches</h3>
                </div>
                <div class="admin-panel-body">
                    [% IF local_branches.size %]
                    <ul>
                        [% FOREACH b IN local_branches %]
                        <li>
                            <code class="code-inline">[% b | html %]</code>
                            [% IF b == current_branch %] <span class="status-badge">current</span>[% END %]
                        </li>
                        [% END %]
                    </ul>
                    [% ELSE %]
                    <p>No branches found.</p>
                    [% END %]
                </div>
            </div>

            [%# ---------------- Stashes ---------------- %]
            [% IF stash_list.size %]
            <div class="admin-panel">
                <div class="admin-panel-header">
                    <h3>Stashes ([% stash_list.size %])</h3>
                </div>
                <div class="admin-panel-body">
                    <ul>
                        [% FOREACH s IN stash_list %]
                        <li>
                            <code class="code-inline">[% s.ref | html %]</code>
                            [% s.message | html %]
                        </li>
                        [% END %]
                    </ul>
                    <div class="admin-form-actions">
                        <a href="[% c.uri_for('/admin/git_stash') %]" class="admin-btn admin-btn-sm">
                            Manage stashes
                        </a>
                    </div>
                </div>
            </div>
            [% END %]

        </div>
    </div>
</div>

[%# LEGACY MENU ONLY – static includes, no DB-driven menu, no toggle %]
<li class="horizontal-dropdown">
    <a href="[% c.stash.nav_back_url || c.session.nav_back_url || '/' %]" class="dropbtn nav-back-link" data-nav-back="1"><i class="icon-back" aria-hidden="true"></i>Back</a>
</li>
[%# CSC-20260909-2862: subscribable menus show only when the module is on for
    the site or the user (enabled_modules = site_modules ∪ user grants). Admins see all.
    Main, Login, Member and HelpDesk are always shown. %]
[% em = c.stash.enabled_modules || {} %]
[% INCLUDE 'Navigation/TopDropListMain.tt' %]
[% IF c.stash.show_features_nav || c.stash.SiteName == 'CSC' %][% INCLUDE 'Navigation/TopDropListFeatures.tt' %][% END %]
[% IF site_has_shop || c.stash.enabled_modules.ecommerce %][% INCLUDE 'Navigation/TopDropListShop.tt' %][% END %]
[% INCLUDE 'Navigation/TopDropListLogin.tt' %]
[% IF c.stash.show_hosted_nav %][% INCLUDE 'Navigation/TopDropListHosted.tt' %][% END %]
[% INCLUDE 'Navigation/TopDropListMember.tt' %]
[% IF is_admin || em.ency || c.stash.SiteName == 'ENCY' %][% INCLUDE 'Navigation/TopDropListENCY.tt' %][% END %]
[% IF is_admin || em.weather %][% INCLUDE 'Navigation/TopDropListWeather.tt' %][% END %]
[% IF is_admin %]
    [% INCLUDE 'Navigation/admintopmenu.tt' %]
[% END %]
[%# Planning: developer/editor/admin on all sites, or planning subscribed (site or user). %]
[% IF is_admin || c.stash.planning_staff || em.planning %][% INCLUDE 'Navigation/TopDropListPlanning.tt' %][% END %]
[% INCLUDE 'Navigation/TopDropListHelpDesk.tt' %]
[% IF is_admin || em.workshop %][% INCLUDE 'Navigation/TopDropListWorkshop.tt' %][% END %]
[% IF c.stash.can_beekeep %][% INCLUDE 'Navigation/TopDropListBeekeeping.tt' %][% END %]
[% IF c.stash.enabled_modules.item('brew') || c.stash.enabled_modules.brew || c.stash.brew_addon_active || c.stash.is_brew_host %]
    [% INCLUDE 'Navigation/TopDropListBrew.tt' %]
[% END %]
[% IF c.stash.enabled_modules.item('printing_3d') %]
    [% INCLUDE 'Navigation/TopDropList3d.tt' %]
[% END %]
[% META
        title = "Schema-compare PostgreSQL connection"
   description = "Make /admin/schema_compare able to see, connect to, CREATE, and deploy per-SiteName PostgreSQL accounting databases from Result classes. Schema-compare today is Maria-only; AccountingDB::provision_site is a separate PG path that already requires a template DB that does not exist yet."
   roles = "admin,developer"
   TemplateType = "Documentation"
   category = "database,schema-management,postgresql"
   page_version = "1.1"
   last_updated = "Wed Aug 26 2026 (v1.1 — opt-in, setup steps, merge handoff)"
   site_specific = "false"
   project_id = "289"
   project_code = "SCHEMAPG"
%]
[% PageVersion = 'Documentation/SchemaComparePostgresPlan.tt,v 1.00 2026/08/26 shanta Exp shanta ' %]
[% IF c.session.debug_mode == 1 %][% PageVersion %][% END %]

<div class="container">
    [% INCLUDE 'admin/documentation/_doc_header.tt'
        page_title   = 'Schema-compare PostgreSQL connection'
        site_name    = site_name
        user_role    = user_role
        last_updated = last_updated
        page_name    = page_name
        doc_project_id   = project_id
        doc_project_code = project_code %]


[% META
   title = "In-App Git: Worktree AI-Commit → Human Merge-to-Main Workflow"
   description = "Design for the Git subsystem so AI agents commit in a worktree, all testing happens there, and a human admin on the main instance (3001) reviews a unified diff through ONE shared diff-view component, then merges the worktree branch into main and pushes to GitHub. Same commit rules apply to any AI (in-app, Hermes, browser editor)."
   roles = "admin,developer,devops"
   TemplateType = "Documentation"
   category = "git,ai-systems,security,development-plan"
   project_id   = "238"
   project_code = "GITWT-NEW"
   page_version = "0.3"
   last_updated = "Wed Aug 13 2026"
   site_specific = "false"
%]

<div class="container">
    <h1 class="doc-h1">In-App Git: Worktree AI-Commit &rarr; Human Merge-to-Main</h1>


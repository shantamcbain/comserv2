[% META
  title = 'CSC Gateway Plan'
  description = 'Routing policy for OPNsense, Unbound, HAProxy, and Cloudflare. Dev never production. Starman :3001 is LAN/ZT only. Named access for devices with no hosts file.'
  roles = 'admin,developer'
  TemplateType = 'Documentation'
  category = 'Infrastructure'
  page_version = '1.2'
  last_updated = 'Sat Sep 26 2026'
  site_specific = 'false'
  project_id = '87'
  project_code = 'Gateway'
%]
[% PageVersion = 'Documentation/system/GatewayPlan.tt,v 1.2 2026/09/26 hermes-agent Exp shanta - Edge rules: no WAN :3001, no public ZT A default, named access without hosts' %]
[% IF c.session.debug_mode == 1 %][% PageVersion %][% END %]

<div class="container">
    [% INCLUDE 'admin/documentation/_doc_header.tt'
        page_title   = 'CSC Gateway Plan'
        site_name    = site_name
        user_role    = user_role
        last_updated = last_updated
        page_name    = page_name
        doc_project_id   = project_id
        doc_project_code = project_code %]

    <div id="toc" class="row doc-toc">
        <div class="col-100">
            <h2 class="doc-h2">Quick Navigation</h2>
            <p class="doc-muted">Jump to section:</p>
            <div class="doc-navrow">
                <a href="#now" class="doc-navlink">Now</a>

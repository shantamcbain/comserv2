[% META
   title = "Git Worktree System — New Isolated-Creation Backend (replaces Zenflow)"
   description = "Replace the dead Zenflow worktree registry with a self-hosted system rooted at ~/.comserv/worktrees/, driven by a single root/config/worktrees.json (read by both Perl and the planning tab). Retire the duplicated zenflow maps and hardcoded .zenflow path constants, and provide create_worktree so AI code creation gets an isolated branch/checkout/port on demand. ai and aichatsystem-ef4e migrate; main is untouched."
   roles = "admin,developer,devops"
   TemplateType = "Documentation"
   category = "git,ai-systems,infrastructure,development-plan"
   page_version = "0.1"
   last_updated = "Mon Aug 03 20:30:00 UTC 2026"
   project_id   = "238"
   project_code = "GITWT-NEW"
   site_specific = "false"
%]

<div class="container">
    <h1 style="color: var(--text-color); font-family: var(--header-font);">Git Worktree System — New Isolated-Creation Backend (replaces Zenflow)</h1>

    <div class="last-updated" style="color: var(--text-muted-color); font-size: var(--font-size-small);">
        Last Updated: 2026-08-03 |
        Version: 0.1 |
        Status: In-Process |
        Tracked in project: <a href="/project/details?project_id=238" style="color: var(--link-color);">#238 (GITWT-NEW)</a>
    </div>

    <!-- TABLE OF CONTENTS SECTION -->
    <div id="toc" class="row" style="margin: var(--spacing-large) 0; background-color: rgba(255,255,255,0.15); padding: var(--spacing-medium); border-left: 4px solid var(--primary-color); border-radius: 4px;">
        <div class="col-100">
            <h2 style="color: var(--text-color); font-family: var(--header-font); margin-top: 0;">Quick Navigation</h2>
            <p style="color: var(--text-muted-color); font-family: var(--body-font); font-size: var(--font-size-small);">Jump to section:</p>
            <div style="display: flex; flex-wrap: wrap; gap: var(--spacing-small);">
                <a href="#overview" style="color: var(--nav-text); text-decoration: none; padding: 4px 8px; border-radius: 3px; background-color: var(--nav-bg); display: inline-block;">Overview</a>
                <a href="#decisions" style="color: var(--nav-text); text-decoration: none; padding: 4px 8px; border-radius: 3px; background-color: var(--nav-bg); display: inline-block;">Decisions</a>

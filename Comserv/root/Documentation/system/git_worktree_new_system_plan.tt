[% META
   title = "Git Worktree System — New Isolated-Creation Backend (replaces Zenflow)"
   description = "Replace the dead Zenflow worktree registry with a self-hosted system rooted at ~/.comserv/worktrees/, driven by a single root/config/worktrees.json (read by both Perl and the planning tab). Provide a single in-app 'create branch' action that creates the git branch, pulls it into a worktree, registers it in worktrees.json, and refreshes the branch-servers list — all in one call. main is untouched until code is merged from a branch via the review-merge gate."
   roles = "admin,developer,devops"
   TemplateType = "Documentation"
   category = "git,ai-systems,infrastructure,development-plan"
   page_version = "0.2"
   last_updated = "Wed Aug 06 14:00:00 UTC 2026"
   project_id   = "238"
   project_code = "GITWT-NEW"
   site_specific = "false"
%]

<div class="container">
    <h1 style="color: var(--text-color); font-family: var(--header-font);">Git Worktree System — New Isolated-Creation Backend (replaces Zenflow)</h1>

    <div class="last-updated" style="color: var(--text-muted-color); font-size: var(--font-size-small);">
        Last Updated: 2026-08-06 |
        Version: 0.2 |
        Status: In-Process |
        Tracked in project: <a href="/project/details?project_id=238" style="color: var(--link-color);">#238 (GITWT-NEW)</a>
    </div>


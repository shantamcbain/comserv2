[% PageVersion = 'root/Documentation/hdry_partnumber_crosscheck.tt,v 0.01 2026/09/11 shanta Exp shanta ' %]
[% IF c.session.debug_mode == 1 %][% PageVersion %][% END %]
[% META title = 'HDRY Part-Number Cross-Check (PDF vs 3MF vs ZIP vs Inventory)'
       description = 'Reconciliation of HDRY System V3 part codes across the assembly manual, the 3MF plate exports, the Upgrade-2 ZIP, and the live inventory items.'
       category = '3d'
       roles = 'admin,manager'
       TemplateType = 'Documentation'
       last_updated = '2026-09-11'
       page_version = '0.01'
       site_specific = '0' %]

<div class="row">
    <div class="col-100">
        <h2 id="hdry-crosscheck" class="doc-h2">HDRY Part-Number Cross-Check</h2>
        <p class="doc-body">Reconciliation of every HDRY System V3 part code across the four sources you asked about:
        the <strong>assembly manual PDF</strong>, the <strong>3MF plate exports</strong>, the <strong>Upgrade-2 ZIP</strong>, and the
        <strong>live inventory items</strong> (read from the running app on :4003, no DB hand-edit). Goal: find what is in the
        drawings/files but missing from inventory, and vice-versa, before trusting the traveler.</p>

        <p class="doc-body"><strong>Sources used.</strong></p>
        <ul class="doc-ul">
            <li><code>192244_HDRY_System__Assembly_Manual.pdf</code> (103 pp, 1 Feb 2025) &mdash; printed-part codes + hardware counts.</li>
            <li><code>~/Downloads/hdry/*.3mf</code> &mdash; Module_1, Module_2, Doors, Dryer_Extras, AMS_Hydra_Rollers, HDry_Lite_Desicant_box, INT-HDRY-BLS01 side panel. Part names read from each 3MF's OrcaSlicer <code>Metadata/*.json</code> and <code>3D/3dmodel.model</code> object names.</li>
            <li><code>110529_HDRY_System__Upgrade_2.zip</code> &mdash; contains <code>HDRY System - Upgrade 2.3mf</code> + <code>Before_Upgrade 2_read_this.pdf</code>. The inner 3MF's part names could not be parsed from this session (binary/deflated config) &mdash; <span class="doc-warn">flagged unresolved below</span>.</li>
            <li>Live inventory: <code>GET /Inventory/items</code> on :4003 returned <strong>114</strong> HDRY/HW-* SKUs (INT-HDRY-*, HW-*, plus HDRY-wheel/Hydra sub-assemblies).</li>
        </ul>

        <h3 class="doc-h3">A. Printed structural parts &mdash; presence matrix</h3>
        <p class="doc-body">Legend: <span class="ok">Y</span> = present, <span class="miss">N</span> = absent, <span class="warn">?</span> = ambiguous.
        "3MF" = appears in at least one of the seven plate exports. "Inv" = SKU exists in inventory.</p>
        <table class="doc-table">
            <tr><th class="doc-th">Code</th><th class="doc-th">PDF</th><th class="doc-th">3MF</th><th class="doc-th">Inv</th><th class="doc-th">Notes</th></tr>
            [% # Module structure
               FOREACH row IN [
                 ['BBL01','Y','Y','Y','Bottom Back Left L1'],
                 ['BBL02','Y','Y','Y','Bottom Back Left L2'],
                 ['BBR01','Y','Y','Y','Bottom Back Right L1'],
                 ['BBR02','Y','Y','Y','Bottom Back Right L2'],
                 ['BBR03','Y','Y','Y','Bottom Back Right L3'],
                 ['BL01','Y','Y','Y','Back Left corner L1'],
                 ['BL02','Y','Y','Y','Back Left corner L2'],
                 ['BL03','Y','Y','Y','Back Left corner L3'],
                 ['BLS01','Y','Y','Y','Back Left Side panel L1'],
                 ['BLS02','Y','Y','Y','Back Left Side panel L2'],
                 ['BR01','Y','Y','Y','Back Right corner L1'],
                 ['BR02','Y','Y','Y','Back Right corner L2'],
                 ['BR03','Y','Y','Y','Back Right corner L3'],
                 ['BRS01','Y','Y','Y','Back Right Side L1'],
                 ['BRS02','Y','Y','Y','Back Right Side L2'],
                 ['FL01','Y','Y','Y','Front Left corner L1 (file often ships as FL03 geom)'],
                 ['FL02','Y','Y','Y','Front Left corner L2'],
                 ['FL03','Y','Y','Y','Front Left corner L3'],
                 ['FLS01','Y','Y','Y','Front Left Side panel L1'],
                 ['FLS02','Y','Y','Y','Front Left Side panel L2'],
                 ['FR01','Y','Y','Y','Front Right corner L1'],
                 ['FR02','Y','Y','Y','Front Right corner L2'],
                 ['FR03','Y','Y','Y','Front Right corner L3'],
                 ['FRS01','Y','Y','Y','Front Right Side L1'],
                 ['FRS02','Y','Y','Y','Front Right Side L2'],
                 ['FFL01','Y','Y','Y','Front Left panel (Sensor + no_Sensor variants in Doors 3MF)'],
                 ['FFL02','Y','Y','Y','Front Left panel L2'],
                 ['FFR01','Y','Y','Y','Front Right panel (Panel + no_panel variants)'],
                 ['FFR02','Y','Y','Y','Front Right panel L2'],
                 ['SBL01','Y','Y','Y','Spool bracket Left L1'],
                 ['SBL02','Y','Y','Y','Spool bracket Left L2'],
                 ['SBR01','Y','Y','Y','Spool bracket Right L1'],
                 ['SBR02','Y','Y','Y','Spool bracket Right L2'],
                 ['SBR03','Y','?','Y','Spool bracket R3 (PDF lists SBR03 x1; not on a plate we parsed)'],
                 ['SRC01','Y','Y','Y','Spool roller cross bar'],
                 ['SRL01','Y','Y','Y','Spool roller bar L'],
                 ['SRR01','Y','Y','Y','Spool roller bar R'],
                 ['B01','?','Y','Y','Board mount B01 (plate name, no PDF code)'],
                 ['B02','?','Y','Y','Board mount B02'],
                 ['B03','?','Y','Y','Board mount B03'],
                 ['B04','?','Y','Y','Board mount B04'],
                 ['BOARD','?','Y','Y','Board'],
                 ['BOARD-CAP','?','Y','Y','Board Cap Closed'],
                 ['SMOOTH-CAP','?','Y','Y','Smooth Cap'],
                 ['STEAM-CAP','?','Y','Y','Steam Cap'],
                 ['CONNECTOR-CUP','?','Y','Y','Connector Cup'],
                 ['T01','?','Y','Y','Tube/duct T01'],
                 ['T02','?','Y','Y','Tube/duct T02'],
                 ['T03','?','Y','Y','Tube/duct T03'],
                 ['T04','?','Y','Y','Tube/duct T04'],
                 ['REINFORCEMENT','?','Y','?','Reinforcement_small (plate name; inventory SKU not matched)'],
               ] %]
            <tr>
                <td class="doc-td"><code>[% row.0 %]</code></td>
                <td class="doc-td [% row.1 == 'Y' ? 'ok' : row.1 == 'N' ? 'miss' : 'warn' %]">[% row.1 %]</td>
                <td class="doc-td [% row.2 == 'Y' ? 'ok' : row.2 == 'N' ? 'miss' : 'warn' %]">[% row.2 %]</td>
                <td class="doc-td [% row.3 == 'Y' ? 'ok' : row.3 == 'N' ? 'miss' : 'warn' %]">[% row.3 %]</td>
                <td class="doc-td">[% row.4 %]</td>
            </tr>
            [% END %]
        </table>


                    <td class="doc-td"><code>INT-HDRY-SRL01</code></td>
                    <td class="doc-td">2</td>
                    <td class="doc-td"><input type="checkbox"> model+item</td>
                    <td class="doc-td"><input type="checkbox"> queued</td>
                </tr>
                <tr>
                    <td class="doc-td"><code>SRR01</code></td>
                    <td class="doc-td">Spool roller right</td>
                    <td class="doc-td"><a href="/static/images/3d/hdry/parts/110520_HDRY_System_V3__AMS__Hydra__Rollers/top_3.png" target="_blank"><img src="/static/images/3d/hdry/parts/110520_HDRY_System_V3__AMS__Hydra__Rollers/top_3.png" alt="SRR01" style="height:64px;border:1px solid #555;border-radius:4px"></a></td>
                    <td class="doc-td"><code>AMS/Hydra Rollers</code></td>

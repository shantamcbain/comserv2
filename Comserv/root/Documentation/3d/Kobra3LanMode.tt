[% META
    title = "Kobra 3 LAN Mode — discovery, state, control"
    description = "Stock Anycubic LAN Mode (not cloud, not Moonraker): discover :18910, attach [LAN_HOST] on an existing farm row, GET /info identity, signed POST /ctrl, MQTTS :9883 telemetry and pause/resume/stop."
    roles = "admin,developer"
    TemplateType = "Documentation"
    category = "3d-printing,lan-mode,printer-farm"
    last_updated = "2026-09-05"
    page_version = "0.2"
    site_specific = "false"
    project_id = "206"
    project_code = "3DPRINT"
%]
[% PageVersion = 'Documentation/3d/Kobra3LanMode.tt,v 0.2 2026/09/05 hermes-agent Exp - live .53 state + control page' %]
[% IF c.session.debug_mode == 1 %][% PageVersion %][% END %]

<div class="container">
    [% INCLUDE 'admin/documentation/_doc_header.tt'
        page_title   = 'Kobra 3 LAN Mode — discovery, state, control'
        site_name    = site_name
        user_role    = user_role
        last_updated = last_updated
        page_name    = page_name
        doc_project_id   = project_id
        doc_project_code = project_code %]

    <div id="toc" class="row doc-toc">
        <div class="col-100">
            <h2 class="doc-h2">Quick Navigation</h2>
            <div class="doc-navrow">
                <a href="#now" class="doc-navlink">Now</a>
                <a href="#network" class="doc-navlink">Network</a>
                <a href="#protocol" class="doc-navlink">Protocol</a>
                <a href="#code" class="doc-navlink">Code / URLs</a>

[% META
   title = "2026-08-14 — /planning/daily tab switching + Calendar tab embed fixes"
   description = "Fixed two defects on the rebuilt /planning/daily index: (1) returning to the Daily Priorities tab showed an empty panel because the inner content wrapper was a second .tab-content that lost its 'active' class on tab switch; (2) the Calendar tab iframe loaded the full wrapped page instead of just the calendar body because the embed flag was a valueless ?embed (empty-string param, false in Catalyst) so the bare-render branch was skipped. Also removed stale #daily-plan-guide anchors/guard left over from the pre-rebuild monolith."
   roles = "admin,developer"
   TemplateType = "Changelog"

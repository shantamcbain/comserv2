[% META
   title = "Git merge plan — single shared diff view + mandatory human approve before AI enters main"
   description = "2026-08-13: resolved the two open questions in git_worktree_merge_plan.tt (v0.1). The diff review UI is ONE shared component (seeded in the AI2 editor, reused by the Git Dashboard and merge-review) so there is one page + one code path to maintain. The human flow is view, edit, and approve: AI code may only live in the worktree; merge/push into main is blocked until an explicit human audit approval covers the current diff (todos #1991 / #1993)."
   roles = "admin,developer,devops"
   TemplateType = "Documentation"
   category = "git,ai-systems,security,changelog"
   page_version = "1.00"
   last_updated = "Wed Aug 13 2026"
   site_specific = "false"
   project_id = "238"
   project_code = "GITWT-NEW"
%]

<div class="container">

    <h1 class="doc-h1">Git merge plan — single shared diff view + mandatory human approve</h1>

    <div class="last-updated" doc-muted>
        Last Updated: 2026-08-13 | Version: 1.00 | Author: hermes | Status: Plan decision recorded (links to project #238)
    </div>

    <div id="toc" class="row doc-toc">
        <div class="col-100">
            <h2 class="doc-h2">Quick Navigation</h2>
            <div class="doc-navrow">
                <a href="#summary" class="doc-navlink">Summary</a>

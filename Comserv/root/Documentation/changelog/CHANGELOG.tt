    <li><code>/home/shanta/PycharmProjects/comserv2/Comserv/root/ENCY/index.tt</code></li>
</ul>

<h3>Documentation Files</h3>
<ul>
    <li><code>/home/shanta/PycharmProjects/comserv2/Comserv/root/Documentation/changelog/2025-04-git-pull-functionality.tt</code></li>
    <li><code>/home/shanta/PycharmProjects/comserv2/Comserv/root/Documentation/changelog/2025-04-documentation-template-refactoring.tt</code></li>
    <li><code>/home/shanta/PycharmProjects/comserv2/Comserv/root/Documentation/developer/navigation_system.tt</code></li>
    <li><code>/home/shanta/PycharmProjects/comserv2/Comserv/root/Documentation/developer/template_system.tt</code></li>
    <li><code>/home/shanta/PycharmProjects/comserv2/Comserv/root/Documentation/features/todo_system.tt</code></li>

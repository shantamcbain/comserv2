[% META title = 'Comserv Changelog' %]
[% PageVersion = 'Documentation/changelog/CHANGELOG.tt,v 3.00 2026/08/20 shanta Exp' %]
[% IF c.session.debug_mode == 1 %][% PageVersion %][% END %]

<h1>Comserv Changelog</h1>

<div class="doc-info">
    <p><strong>Policy (2026-08-20):</strong> Do not edit this file to add a note.
    Add a new fragment under <code>root/Documentation/changelog/entries/</code>
    named <code>YYYY-MM-DD-slug.inc</code>. The reader page is generated from
    those files so two branches adding notes do not conflict on the same TOC/tail.</p>
    <ul>
        <li><strong>Code changes</strong> → new <code>changelog/entries/*.inc</code> (this page at <code>/Documentation/CHANGELOG</code>)</li>
        <li><strong>Do not</strong> create standalone <code>YYYY-MM-DD-*.tt</code> pages (they become extra Documentation routes)</li>
        <li><strong>Member how-to</strong> → stable <code>Documentation/guides/*.tt</code></li>
        <li><strong>Pre-2026 dated files</strong> → read-only archive: <a href="/Documentation/all_changelog">all_changelog</a></li>
    </ul>
</div>

<div class="cl-toc">
<h2>Changelog Navigation</h2>
[% FOREACH g IN changelog_groups %]
<h3>[% g.year %]</h3>
<ul class="cl-toc-year">
[% FOREACH m IN g.months %]
<li><strong>[% m.month %]</strong><ul>
[% FOREACH e IN m.entries %]
<li><a href="#[% e.id %]">[% e.title | html %]</a></li>
[% END %]
</ul></li>
[% END %]
</ul>
[% END %]
</div>

[% FOREACH e IN changelog_entries %]
[% PROCESS $e.rel %]
[% END %]

   title = "2026-08-15 — Shared doc header INCLUDE with META-driven Project link"
   description = "Added a reusable documentation page header (root/admin/documentation/_doc_header.tt) that both .tt plan/template docs and .md docs render, pulling title / Current Site / User Role / Last Updated / Project (links to /project/details?project_id=N) / Documentation Home / Suggest Edit straight from the page META block + request context."
   roles = "admin,developer"

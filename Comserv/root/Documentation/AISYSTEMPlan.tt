   title = "AI System Use — coordinator plan"
   description = "Audit of AI plans/docs/todos and the ordered waves that systematically improve AI use on Comserv. Sequences AIMPS, V2MIG-on-touch, AGENTS, and Hermes focus settings without stealing those plans."
   roles = "admin,developer"
   TemplateType = "Documentation"
   category = "planning,ai"
   page_version = "1.03"
   last_updated = "2026-08-26"
   site_specific = "false"

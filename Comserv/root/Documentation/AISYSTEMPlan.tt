                <tr class="doc-tr-alt">
                    <td class="doc-td">W1.0 SuperGrok prepaid source — <a href="[% c.uri_for('/project/details') %]?project_id=282" class="doc-link">#282 AISYS-W1</a></td>
                    <td class="doc-td"><a href="[% c.uri_for('/todo/details') %]?record_id=2202" class="doc-link">#2202</a></td>

[% META
        title = "Docker & Kubernetes Plans — Coordinator"
   description = "Single coordinator for every Docker and Kubernetes plan in Comserv2: strategy, orchestration/HA, DB-to-K8s migration, deployment & secrets, container diagnostics, dev environment, and agent setup. Sequences them, names the overlaps with INFRA-HA / IMGSEC / DEPLOY_WORKFLOW, and links each sub-plan by its verified route."
   roles = "admin,developer,devops"
   TemplateType = "Documentation"
   category = "infrastructure,deployment,kubernetes,docker,coordination"
   page_version = "1.0"
   last_updated = "Sun Aug 23 2026"
   site_specific = "false"
   project_id = "271"
   project_code = "DOCKER-SYS"
%]
[% PageVersion = 'Documentation/DockerMasterPlan.tt,v 1.0 2026/08/23 hermes-agent Exp shanta - Coordinator linking all Docker/Kubernetes plans' %]
[% IF c.session.debug_mode == 1 %]
    [% PageVersion %]
[% END %]


[% META
   title = "Dryer Project — Import STL/PDF into Inventory + Print Queue"
   description = "Import the downloaded dryer STL+PDF files into Comserv2 as an internal (not-for-sale) 3D build: parent assembly item, per-part inventory + BOM, automated print-queue placement, and automatic stock-in on print completion."
   roles = "admin,developer"
   TemplateType = "Documentation"
   category = "3d-printing,planning,import,internal-build"
   page_version = "0.1"
   last_updated = "Tue Aug 19 2026"
   site_specific = "false"
   project_id   = "14"
   project_code = "DRYER-INT"
%]
[% PageVersion = 'Documentation/DryerProjectImportPlan.tt,v 0.1 2026/08/19 hermes-agent Exp - DocumentationTtTemplate-compliant plan for dryer internal 3D build import' %]
[% IF c.session.debug_mode == 1 %]
    [% PageVersion %]
[% END %]

<div class="container">
    [% INCLUDE 'admin/documentation/_doc_header.tt'
        page_title   = 'Dryer Project — Import STL/PDF into Inventory + Print Queue'
        site_name    = site_name
        user_role    = user_role
        last_updated = last_updated
        page_name    = page_name
        doc_project_id   = project_id
        doc_project_code = project_code %]


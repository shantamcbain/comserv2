                <li><a href="[% c.uri_for('/Documentation/V2MigrationPlan') %]" class="doc-link">V2MigrationPlan</a> — template/JS modernization</li>
                <li><a href="[% c.uri_for('/Documentation/AutonomousAgentsPlan') %]" class="doc-link">AutonomousAgentsPlan</a> — agent framework (#267)</li>
                <li><a href="[% c.uri_for('/Documentation/AIAgentOrchestrationPlan') %]" class="doc-link">AIAgentOrchestrationPlan</a> — Email + Secretary + notifications</li>
            </ul>

                    Todos:
                    <a href="[% c.uri_for('/todo') %]?project_id=296" class="doc-link">#296</a>.
                    All projects:
                    <a href="[% c.uri_for('/project') %]" class="doc-link">/project</a>.
                </p>
            </div>
            <table class="doc-table">
                <tr>
                    <th class="doc-th">Workstream (sub-project)</th>
                    <th class="doc-th">Tracking</th>
                    <th class="doc-th">Gate / done-when</th>
                </tr>
                <tr>
                    <td class="doc-td"><a href="[% c.uri_for('/project/details') %]?project_id=297" class="doc-link">#297 HK-ENABLE</a></td>
                    <td class="doc-td"><a href="[% c.uri_for('/todo/details') %]?record_id=2450" class="doc-link">#2450</a> ROLE EVAL → <a href="[% c.uri_for('/todo/details') %]?record_id=2453" class="doc-link">#2453</a> grant</td>
                    <td class="doc-td">Grant on → page visible; grant off → hidden</td>
                </tr>
                <tr class="doc-tr-alt">
                    <td class="doc-td"><a href="[% c.uri_for('/project/details') %]?project_id=298" class="doc-link">#298 HK-PANTRY</a></td>
                    <td class="doc-td"><a href="[% c.uri_for('/todo/details') %]?record_id=2457" class="doc-link">#2457</a> map/overlay; <a href="[% c.uri_for('/todo/details') %]?record_id=2458" class="doc-link">#2458</a> InventoryAccounting</td>
                    <td class="doc-td">Personal overlay qty + ENCY link used by planner</td>
                </tr>
                <tr>
                    <td class="doc-td"><a href="[% c.uri_for('/project/details') %]?project_id=299" class="doc-link">#299 HK-SYMPTOMS</a></td>
                    <td class="doc-td"><a href="[% c.uri_for('/todo/details') %]?record_id=2462" class="doc-link">#2462</a> → <a href="[% c.uri_for('/todo/details') %]?record_id=2463" class="doc-link">#2463</a></td>
                    <td class="doc-td">Resolved symptoms leave planner input</td>
                </tr>
                <tr class="doc-tr-alt">
                    <td class="doc-td"><a href="[% c.uri_for('/project/details') %]?project_id=300" class="doc-link">#300 HK-PLANNER</a></td>
                    <td class="doc-td"><a href="[% c.uri_for('/todo/details') %]?record_id=2467" class="doc-link">#2467</a> Util; <a href="[% c.uri_for('/todo/details') %]?record_id=2468" class="doc-link">#2468</a> AI</td>
                    <td class="doc-td">Menu ⊆ pantry; no meds that interfere with health</td>
                </tr>
                <tr>
                    <td class="doc-td"><a href="[% c.uri_for('/project/details') %]?project_id=301" class="doc-link">#301 HK-KNOWLEDGE</a></td>

   project_id = "296"
   project_code = "HEALTHKITCHEN"
%]
[% PageVersion = 'Documentation/HealthKitchenPlan.tt,v 0.03 2026/09/23 hermes-agent Exp shanta ' %]
[% IF c.session.debug_mode == 1 %]
    [% PageVersion %]
[% END %]

<div class="container">
    [% INCLUDE 'admin/documentation/_doc_header.tt'
        page_title   = 'Health Kitchen Plan'

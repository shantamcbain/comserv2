[% PageVersion = 'ai/usage.tt,v 0.16 2026/10/01 shanta Exp shanta ' %]
[% IF c.session.debug_mode == 1 %][% PageVersion %][% END %]
[%
  META
    title = 'AI Usage & Activity Monitor'
    description = 'SuperGrok five-number overview; agent cost-effectiveness (visible, not buried); window selector; Daily AI Eval link'
    category = 'AI'
    TemplateType = 'ApplicationTtTemplate'
    last_updated = '2026-10-01'
    page_version = '0.16'
%]

<div class="ai-usage-page" style="max-width:960px;margin:0 auto;padding:1rem;color:var(--text-color);">
  <h1 style="color:var(--primary-color);">AI Usage</h1>
  <p id="usage-live-stamp" class="doc-muted" data-usage-live="1">Loading…</p>
  [% IF is_admin %][% INCLUDE 'ai/_ai_admin_banner.tt' %][% INCLUDE 'ai/_admin_eval_links.tt' %][% END %]

  <nav aria-label="On this page" style="display:flex;flex-wrap:wrap;gap:8px;margin:0 0 12px;">
    <a href="#usage-overview" style="color:var(--link-color);">Overview</a>
    <a href="#usage-agents" style="color:var(--link-color);">Agents</a>
    <a href="#usage-tunnel" style="color:var(--link-color);">Focus</a>
    [% IF is_admin %]
    <a href="#agent-effectiveness" style="color:var(--link-color);">Effectiveness</a>
    <a href="#fallover" style="color:var(--link-color);">Fallover</a>
    <a href="[% c.uri_for('/ai/eval') %]" style="color:var(--link-color);">Eval reports</a>
    <a href="[% c.uri_for('/ai/eval/latest') %]" style="color:var(--link-color);font-weight:bold;">Latest eval report</a>
    <a href="#ai-health" style="color:var(--link-color);">Health &amp; preflight</a>
    <a href="#all-ai-usage" style="color:var(--link-color);">All AI usage</a>
    [% END %]
    <a href="#usage-charts" style="color:var(--link-color);">Charts</a>
    <a href="#usage-more" style="color:var(--link-color);">More</a>
  </nav>

  [%# Window selector. The controller always read ?days= but no control ever
    # submitted it, and the ledger was additionally pinned to 14 days, so no
    # view could show less than two weeks. Plain GET form: no inline JS.
    # action MUST be c.uri_for(c.action) — c.req.path has no leading slash, so
    # a bare path resolves relative to the current dir and doubles the segment
    # (/ai/usage -> /ai/ai/usage). %]
  <form method="get" action="[% c.uri_for(c.action) | html %]" style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:0 0 12px;">
    <label for="usage-days" class="doc-muted">Window</label>
    <select id="usage-days" name="days" class="form-control" style="width:auto;">
      [% FOREACH d IN [1, 3, 7, 14, 30, 90] %]
        <option value="[% d %]"[% IF filters.days == d %] selected[% END %]>last [% d %] day[% IF d != 1 %]s[% END %]</option>
      [% END %]
    </select>
    <button type="submit" class="btn btn-secondary">Apply</button>
  </form>

  <section id="usage-overview" aria-label="SuperGrok this week">
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin-bottom:8px;">
      <div class="card" style="flex:1;min-width:120px;border:1px solid var(--border-color);background:var(--card-bg, var(--bg-color));padding:12px;">
        <div class="doc-muted">Build % used</div>
        <div id="usage-kpi-build" style="font-size:1.8em;font-weight:600;">—</div>
      </div>
      <div class="card" style="flex:1;min-width:120px;border:1px solid var(--border-color);background:var(--card-bg, var(--bg-color));padding:12px;">
        <div class="doc-muted">Remaining</div>
        <div id="usage-kpi-remaining" style="font-size:1.8em;font-weight:600;">—</div>
      </div>
      <div class="card" style="flex:1;min-width:120px;border:1px solid var(--border-color);background:var(--card-bg, var(--bg-color));padding:12px;">
        <div class="doc-muted">Daily cap</div>
        <div id="usage-kpi-cap" style="font-size:1.8em;font-weight:600;">—</div>
      </div>
      <div class="card" style="flex:1;min-width:120px;border:1px solid var(--border-color);background:var(--card-bg, var(--bg-color));padding:12px;">
        <div class="doc-muted">Used today</div>
        <div id="usage-kpi-used-today" style="font-size:1.8em;font-weight:600;">—</div>
      </div>
      <div class="card" style="flex:1;min-width:120px;border:1px solid var(--border-color);background:var(--card-bg, var(--bg-color));padding:12px;">
        <div class="doc-muted">Days to reset</div>
        <div id="usage-kpi-days" style="font-size:1.8em;font-weight:600;">—</div>
      </div>
    </div>
    <p id="usage-sg-status" class="doc-muted">SuperGrok status loading…</p>
  </section>

  <section id="usage-agents" aria-label="Active agents">
    <h2 style="font-size:1.1em;">Agents</h2>
    <div id="usage-agent-cards" style="display:flex;flex-wrap:wrap;gap:10px;">
      <button type="button" class="card" data-tunnel="hermes"
              style="flex:1;min-width:160px;text-align:left;cursor:pointer;border:1px solid var(--border-color);background:var(--card-bg, var(--bg-color));padding:12px;color:var(--text-color);">
        <strong>Hermes</strong>
        <div class="doc-muted" data-agent-status="hermes">…</div>
        <div data-agent-detail="hermes">Click to focus</div>
      </button>
      <button type="button" class="card" data-tunnel="chat"
              style="flex:1;min-width:160px;text-align:left;cursor:pointer;border:1px solid var(--border-color);background:var(--card-bg, var(--bg-color));padding:12px;color:var(--text-color);">
        <strong>AI Chat</strong>
        <div class="doc-muted" data-agent-status="chat">…</div>
        <div data-agent-detail="chat">Click to focus</div>
      </button>
      <button type="button" class="card" data-tunnel="grok_bot"
              style="flex:1;min-width:160px;text-align:left;cursor:pointer;border:1px solid var(--border-color);background:var(--card-bg, var(--bg-color));padding:12px;color:var(--text-color);">
        <strong>Grok Bot</strong>
        <div class="doc-muted" data-agent-status="grok_bot">…</div>
        <div data-agent-detail="grok_bot">Click to focus</div>
      </button>
      <button type="button" class="card" data-tunnel="editor"
              style="flex:1;min-width:160px;text-align:left;cursor:pointer;border:1px solid var(--border-color);background:var(--card-bg, var(--bg-color));padding:12px;color:var(--text-color);">
        <strong>AI Editor</strong>
        <div class="doc-muted" data-agent-status="editor">…</div>
        <div data-agent-detail="editor">Click to focus</div>
      </button>
    </div>
  </section>

  <section id="usage-tunnel" class="card" style="margin:16px 0;border:1px solid var(--border-color);padding:12px;background:var(--card-bg, var(--bg-color));">
    <h2 style="margin-top:0;font-size:1.1em;">Focus</h2>
    <p id="usage-tunnel-empty" class="doc-muted">Click an agent. Only that slice opens here.</p>
    <div id="usage-tunnel-body" hidden></div>
  </section>

  [%# Effectiveness + Daily Eval must be visible without opening More.
      Buried in a collapsed details they were never seen this session. %]
  [% IF is_admin && ledger_monitor %]
  [% INCLUDE 'ai/usage_effectiveness_card.tt' %]
  [% END %]
  [% IF is_admin && eval_summary %][% INCLUDE 'ai/usage_eval_card.tt' %][% END %]
  [%# Model failover (AISYSTEM plan §5e) — admin only; controller only builds it for admins. %]
  [% IF is_admin && fallover %][% INCLUDE 'ai/usage_fallover_card.tt' %][% END %]
  [% IF is_admin && ai_health %][% INCLUDE 'ai/usage_health_card.tt' %][% INCLUDE 'ai/usage_unified_card.tt' %][% END %]

  <details id="usage-charts">
    <summary style="cursor:pointer;color:var(--link-color);">14-day token and API-call charts</summary>
    <p class="doc-muted">Empty days are zero. Same colours as the legend. Default is bar; choice is kept on refresh.</p>
    <div style="display:flex;gap:8px;flex-wrap:wrap;margin:8px 0;">
      <button type="button" class="btn btn-secondary" data-chart-type="bar">Bar</button>
      <button type="button" class="btn btn-secondary" data-chart-type="line">Line</button>
    </div>
    <div style="overflow-x:auto;">
      <canvas id="usage-tokens-chart" width="880" height="220" data-usage-chart="tokens"></canvas>
    </div>
    <div id="usage-source-legend" style="display:flex;flex-wrap:wrap;gap:8px;margin:8px 0 16px;"></div>
    <div style="overflow-x:auto;">
      <canvas id="usage-calls-chart" width="880" height="180" data-usage-chart="calls"></canvas>
    </div>
  </details>
  <script type="application/json" id="usage-chart-data">{"source_days":[]}</script>

  <details id="usage-more">
    <summary style="cursor:pointer;color:var(--link-color);">More (14-day totals, grok.com paste, admin)</summary>
    <div style="display:flex;gap:12px;flex-wrap:wrap;margin:12px 0;">
      <div class="card" style="flex:1;min-width:140px;border:1px solid var(--border-color);background:var(--card-bg, var(--bg-color));padding:12px;">
        <div class="doc-muted">API calls (14d)</div>
        <div id="usage-kpi-calls" style="font-size:1.4em;font-weight:600;">[% org.org_totals.hermes_calls || org.org_totals.calls || 0 %]</div>
        <div id="usage-kpi-calls-sub" class="doc-muted">Hermes + app</div>
      </div>
      <div class="card" style="flex:1;min-width:140px;border:1px solid var(--border-color);background:var(--card-bg, var(--bg-color));padding:12px;">
        <div class="doc-muted">Tokens (14d)</div>
        <div id="usage-kpi-tokens" style="font-size:1.4em;font-weight:600;">[% org.hermes.totals.tokens || 0 %]</div>
        <div id="usage-kpi-tokens-sub" class="doc-muted">incl. cache / reasoning</div>
      </div>
      <div class="card" style="flex:1;min-width:140px;border:1px solid var(--border-color);background:var(--card-bg, var(--bg-color));padding:12px;">
        <div class="doc-muted">OpenRouter</div>
        <div id="usage-kpi-or" style="font-size:1.4em;font-weight:600;">
          [% IF provider_status.openrouter.ok && provider_status.openrouter.remaining.defined %]
            $[% provider_status.openrouter.remaining %] left
          [% ELSIF provider_status.openrouter.ok %]
            used $[% provider_status.openrouter.usage || 0 %]
          [% ELSE %]
            …
          [% END %]
        </div>
        <div id="usage-kpi-or-sub" class="doc-muted">
          [% IF provider_status.openrouter.ok %]
            live from OpenRouter key · add money when empty
          [% ELSE %]
            [% provider_status.openrouter.error || 'fetched on page load (admin session)' %]
          [% END %]
        </div>
      </div>
    </div>
    <p class="doc-muted" style="margin:8px 0;"><a href="https://grok.com/" target="_blank" rel="noopener noreferrer" style="color:var(--link-color);">Open grok.com</a> → Settings → Usage if the Firefox add-on is not writing numbers.</p>
    <div style="display:flex;gap:8px;flex-wrap:wrap;align-items:end;">
      <label class="doc-muted">Build %<br>
        <input type="number" id="declare-grokcom-build" min="0" max="100" step="1" placeholder="38" style="width:4.5em;">
      </label>
      <label class="doc-muted">Chat %<br>
        <input type="number" id="declare-grokcom-chat" min="0" max="100" step="1" placeholder="1" style="width:4.5em;">
      </label>
      <button type="button" class="btn btn-secondary" data-declare-grokcom="1">Save grok.com %</button>
    </div>

    [% IF is_admin %]
    <p><a href="[% c.uri_for('/ai/eval') %]" style="color:var(--link-color);">Daily AI Eval Reports</a>
       · <a href="#agent-effectiveness" style="color:var(--link-color);">Agent effectiveness (this page)</a></p>
    [% END %]

    [% IF org.kill_switch.killed.size %]
    <table class="data-table">
      <thead><tr><th>Provider</th><th>Model</th><th></th></tr></thead>
      <tbody>
      [% FOREACH k IN org.kill_switch.killed %]
        <tr>
          <td>[% k.provider | html %]</td><td>[% k.model | html %]</td>
          <td><button type="button" class="btn" data-unkill-model="1"
                      data-provider="[% k.provider | html %]" data-model="[% k.model | html %]">Restore</button></td>
        </tr>
      [% END %]
      </tbody>
    </table>
    [% END %]
    <form id="usage-kill-form" style="display:flex;gap:8px;flex-wrap:wrap;align-items:end;margin:8px 0;">
      <label>Provider<br><input name="provider" type="text" placeholder="grok" required></label>
      <label>Model<br><input name="model" type="text" placeholder="grok-4.6" required></label>
      <label>Reason<br>
        <select name="reason">
          <option value="other">Other</option>
          <option value="leak">Leak</option>
          <option value="hallucinate">Hallucinate</option>
          <option value="thrash">Thrash</option>
        </select>
      </label>
      <button type="submit" class="btn btn-primary">Kill model</button>
    </form>
    <div id="usage-kill-result" class="doc-muted"></div>
    <button type="button" class="btn btn-secondary" data-check-grok="1">Check xAI (optional)</button>
    <input type="number" id="declare-xai-balance" class="form-control" step="0.01" placeholder="declare USD" style="width:120px;display:inline-block;" />
    <button type="button" class="btn btn-secondary" data-declare-grok="1">Declare</button>
    <div id="grok-live-result" class="doc-code" style="margin-top:10px;white-space:pre-wrap;"></div>
    [% IF is_admin && ledger_monitor %]
    <details><summary style="cursor:pointer;">Golden Data ledger</summary>[% INCLUDE 'ai/usage_ledger.tt' %]</details>
    [% END %]
  </details>
</div>

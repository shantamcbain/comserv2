[% META
    title = "Add API Key"
    category = "AI"
    roles = "user,developer,admin"
    description = "Add or edit API key for AI provider"
%]

<style>
.api-key-form-container {
    max-width: 700px;
    margin: 20px auto;
    padding: 20px;
}

.form-section {
    background: var(--nav-bg);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 25px;
    margin-bottom: 20px;
}

.form-section h2 {
    margin-top: 0;
    color: var(--text-color);
    border-bottom: 2px solid var(--accent-color);
    padding-bottom: 10px;
}

.form-group {
    margin-bottom: 20px;
}

.form-group label {
    display: block;
    margin-bottom: 8px;
    font-weight: bold;
    color: var(--text-color);
}

.form-group input[type="text"],
.form-group input[type="password"],
.form-group select {
    width: 100%;
    padding: 10px;
    border: 1px solid var(--border-color);
    border-radius: 4px;
    background: var(--background-color);
    color: var(--text-color);
    font-size: 14px;
    box-sizing: border-box;
}

.form-group input:focus,
.form-group select:focus {
    outline: none;
    border-color: var(--accent-color);
    box-shadow: 0 0 0 2px rgba(102, 126, 234, 0.1);
}

.form-help {
    display: block;
    margin-top: 5px;
    font-size: 12px;
    color: var(--text-muted-color);
}

.form-actions {
    display: flex;
    gap: 10px;
    margin-top: 25px;
    padding-top: 20px;
    border-top: 1px solid var(--border-color);
}

.btn {
    display: inline-block;
    padding: 10px 20px;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    text-decoration: none;
    font-size: 14px;
    transition: opacity 0.2s;
}

.btn-primary {
    background: var(--primary-color, #007bff);
    color: white;
}

.btn-secondary {
    background: #6c757d;
    color: white;
}

.btn:hover {
    opacity: 0.8;
}

.alert {
    padding: 15px;
    border-radius: 4px;
    margin-bottom: 20px;
}

.alert-success {
    background: #d4edda;
    border: 1px solid #c3e6cb;
    color: #155724;
}

.alert-danger {
    background: #f8d7da;
    border: 1px solid #f5c6cb;
    color: #721c24;
}

.alert-info {
    background: #d1ecf1;
    border: 1px solid #bee5eb;
    color: #0c5460;
}
</style>

<div class="api-key-form-container">
    <h1>[% IF key_id %]Edit[% ELSE %]Add[% END %] API Key</h1>
    
    [% IF status_msg %]
    <div class="alert alert-success">
        [% status_msg %]
    </div>
    [% END %]
    
    [% IF error_msg %]
    <div class="alert alert-danger">
        [% error_msg %]
    </div>
    [% END %]
    
    [% IF c.flash.status_msg %]
    <div class="alert alert-success">
        [% c.flash.status_msg %]
    </div>
    [% END %]
    
    [% IF c.flash.error_msg %]
    <div class="alert alert-danger">
        [% c.flash.error_msg %]
    </div>
    [% END %]
    
    <div class="alert alert-info">
        <strong>Security:</strong> Your API key will be encrypted using AES-256 before being stored in the database.
        The encryption key is stored securely in your environment configuration.
    </div>
    
    <div class="form-section">
        <h2>[% IF key_id %]Update[% ELSE %]Add New[% END %] API Key</h2>
        
        <form method="POST" action="[% c.uri_for('/ai/save_api_key') %]">
            [% IF key_id %]
            <input type="hidden" name="id" value="[% key_id %]">
            [% END %]
            
            [%# Oct 30 2026: any provider. Known list + Other (free slug). The key value is never sent back to this page. %]
            [% known_slugs = {} %][% FOREACH kp IN known_providers %][% known_slugs.${kp.0} = 1 %][% END %]
            <div class="form-group">
                <label for="service">AI Service Provider *</label>
                [% IF key_id %]
                <input type="text" id="service" value="[% service | html %]" disabled>
                <input type="hidden" name="service" value="[% service | html %]">
                <span class="form-help">Provider and key type cannot be changed when editing. Delete and add a new key instead.</span>
                [% ELSE %]
                <select id="service" name="service" required onchange="document.getElementById('service_other_group').style.display = (this.value === 'other') ? 'block' : 'none';">
                    <option value="">Select a provider...</option>
                    [% FOREACH kp IN known_providers %]
                    <option value="[% kp.0 | html %]" [% IF service == kp.0 %]selected[% END %]>[% kp.1 | html %]</option>
                    [% END %]
                    <option value="other">Other (type its name)</option>
                </select>
                <span class="form-help">Calls made with your own key are billed to your account with that provider.</span>
                [% END %]
            </div>
            [% UNLESS key_id %]
            <div class="form-group" id="service_other_group" style="display:none">
                <label for="service_other">Provider name (Other)</label>
                <input type="text" id="service_other" name="service_other" maxlength="64" pattern="[a-z0-9_.\-]{2,64}"
                       placeholder="e.g. mistral, together, my-vllm">
                <span class="form-help">2-64 characters: lowercase letters, digits, _ . -</span>
            </div>
            [% END %]
            <div class="form-group">
                <label for="key_type">Key type</label>
                [% IF key_id %]
                <input type="text" id="key_type" value="[% (key_type || 'chat') | html %]" disabled>
                [% ELSE %]
                <select id="key_type" name="key_type">
                    [% FOREACH kt IN key_types %]
                    <option value="[% kt | html %]" [% IF (key_type || 'chat') == kt %]selected[% END %]>[% kt | html %]</option>
                    [% END %]
                </select>
                <span class="form-help">chat = used for AI answers; management/billing = read usage and billing only.</span>
                [% END %]
            </div>
            <div class="form-group">
                <label for="base_url">Base URL (optional, OpenAI-compatible)</label>
                <input type="text" id="base_url" name="base_url" maxlength="255" value="[% base_url | html %]"
                       placeholder="https://api.example.com/v1">
                <span class="form-help">https only. http is allowed only for localhost or a private LAN address (e.g. http://192.168.1.50:11434/v1).
                    Leave empty for the provider's normal address.</span>
            </div>
            <div class="form-group">
                <label for="label">Label (optional)</label>
                <input type="text" id="label" name="label" maxlength="128" value="[% label | html %]" placeholder="e.g. my work key">
            </div>

            <div class="form-group">
                <label for="api_key">API Key *</label>
                <input type="password" id="api_key" name="api_key" autocomplete="off" [% UNLESS key_id %]required[% END %]
                       placeholder="[% IF key_id %]Enter new API key to update[% ELSE %]Enter your API key[% END %]">
                <span class="form-help">
                    [% IF key_id %]
                    Leave blank to keep existing key. Enter a new key to update.
                    [% ELSE %]
                    Your API key will be encrypted before storage.
                    [% END %]
                </span>
            </div>
            
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">
                    [% IF key_id %]Update Key[% ELSE %]Save Key[% END %]
                </button>
                <a href="[% c.uri_for('/ai/manage_api_keys') %]" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>

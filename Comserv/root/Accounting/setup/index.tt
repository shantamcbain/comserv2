[% INCLUDE Accounting/_acct_inv_nav.tt %]

[% IF c.flash.success_msg %]
<div style="background:#d1fae5;border:1px solid #86efac;border-radius:6px;padding:0.75rem 1rem;margin-bottom:1rem;">
    [% c.flash.success_msg | html %]
</div>
[% END %]

[% IF c.flash.error_msg %]
<div style="background:#fee2e2;border:1px solid #fca5a5;border-radius:6px;padding:0.75rem 1rem;margin-bottom:1rem;">
    [% c.flash.error_msg | html %]
</div>
[% END %]

<div class="app-container">
    <div class="page-header" style="display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.2rem;">
        <h1 style="margin:0;">📋 Accounting Setup — [% sitename | html %]</h1>
        <a href="/Accounting" class="btn btn-secondary" style="font-size:0.88rem;">← Accounting Dashboard</a>
    </div>

    [%# ── Step 1: Database Status ────────────────────────────────────── %]
    <div style="background:#f0fdf4;border:1px solid #86efac;border-radius:8px;padding:1rem 1.5rem;margin-bottom:1.5rem;">
        <h2 style="margin-top:0;color:#065f46;font-size:1.1rem;">✅ Accounting Database: Provisioned</h2>
        <p style="margin:0.5rem 0 0;font-size:0.9rem;color:#374151;">
            Connected to <code>[% db_name | html %]@[% db_host | html %]:[% db_port %]/[% db_name | html %]</code>
            <span style="background:#dbeafe;color:#1e40af;border-radius:4px;padding:1px 8px;font-size:0.78rem;margin-left:0.5rem;">[% jurisdiction | html %]/[% currency | html %]</span>
        </p>
    </div>

    [%# ── Step 2: Provisioned? ──────────────────────────────────────── %]
    [% IF provision_status eq 'provisioning' %]
    <div style="background:#fef9c3;border:1px solid #fde68a;border-radius:8px;padding:1rem 1.5rem;margin-bottom:1.5rem;">
        <strong style="color:#92400e;">⏳ Provisioning in progress…</strong>
        <p style="margin:0.5rem 0 0;font-size:0.9rem;color:#b45309;">
            PostgreSQL database is being created. Refresh in a minute or check the admin panel.
        </p>
    </div>

    [% ELSIF provision_status eq 'error' %]
    <div style="background:#fee2e2;border:1px solid #fca5a5;border-radius:8px;padding:1rem 1.5rem;margin-bottom:1.5rem;">
        <strong style="color:#991b1b;">❌ Provisioning Failed</strong>
        <p style="margin:0.5rem 0 0;font-size:0.9rem;color:#b45309;">
            [% provision_error | html %]
        </p>
    </div>

    [% ELSE %]
    [%# ── Step 3: Template Selector (Ph.1a S9) ──────────────────────────── %]
    <div style="background:#ffffff;border:1px solid #e5e7eb;border-radius:8px;padding:1rem 1.5rem;margin-bottom:1.5rem;">
        <h2 style="color:#1e40af;font-size:1rem;margin-top:0;">📂 Choose Chart Template</h2>
        <p style="margin:0.5rem 0;color:#374151;font-size:0.95rem;">
            Select a pre-built Chart of Accounts template tailored to your business model.
            Each base archetype covers multiple industries; you can add teaching/ecommerce overlays below.
        </p>

        <form method="post" action="/Accounting/setup/choose_template" style="margin-top:1rem;">
            <input type="hidden" name="action" value="choose">

            <div style="margin-bottom:1rem;">
                <label style="font-weight:500;color:#374151;margin-bottom:0.25rem;display:block;">Base Archetype</label>
                <select name="base_archetype" required style="width:100%;padding:0.5rem;border:1px solid #d1d5db;border-radius:6px;font-size:0.9rem;">
                    <option value="">-- Select a template --</option>
                    [% FOREACH a IN archetypes %]
                    <option value="[% a.id %]" [% IF chosen_base == a.id %]selected[% END %]>
                        [% a.label %][% IF a.description %] — [% a.description %][% END %]
                    </option>
                    [% END %]
                </select>
                <small style="color:#6b7280;margin-top:0.25rem;display:block;">
                    This is pre-selected for your site's business model. The system uses CRA GIFI bands for statutory compliance.
                </small>
            </div>

            <div style="margin-bottom:1rem;">
                <label style="font-weight:500;color:#374151;margin-bottom:0.25rem;display:block;">Capability Overlays (optional)</label>
                <div style="display:flex;gap:0.75rem;flex-wrap:wrap;">
                    <label style="display:flex;align-items:center;gap:0.5rem;background:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;padding:0.5rem 0.75rem;">
                        <input type="checkbox" name="overlays" value="teaching" [% IF 'teaching' IN selected_overlays %]checked[% END %]>
                        <span style="font-size:0.9rem;">Teaching (tuition, grants, donations)</span>
                    </label>
                    <label style="display:flex;align-items:center;gap:0.5rem;background:#f9fafb;border:1px solid #e5e7eb;border-radius:6px;padding:0.5rem 0.75rem;">
                        <input type="checkbox" name="overlays" value="ecommerce" [% IF 'ecommerce' IN selected_overlays %]checked[% END %]>
                        <span style="font-size:0.9rem;">E-Commerce (sales tax, shipping, COGS)</span>
                    </label>
                </div>
                <small style="color:#6b7280;margin-top:0.25rem;display:block;">
                    Activate overlays for your needs. Overlays combine with the base without number collisions.
                </small>
            </div>

            <div style="display:flex;gap:0.75rem;margin-top:1rem;">
                <button type="submit" class="btn btn-primary" style="flex:1;">
                    📊 Review & Seed Chart
                </button>
                <a href="/Accounting/setup/ai_generate" class="btn btn-outline-secondary" style="flex:1;text-align:center;">
                    🤖 Let AI Generate Template
                </a>
            </div>
        </form>
    </div>

    [%# ── Preview when a template is selected ─────────────────────────── %]
    [% IF merged_chart %]
    <div style="background:#ffffff;border:1px solid #e5e7eb;border-radius:8px;padding:1rem 1.5rem;margin-bottom:1.5rem;">
        <h3 style="color:#1e40af;font-size:1rem;margin-top:0;">📋 Preview: [% merged_chart.base.label %]</h3>
        <p style="margin:0.5rem 0;color:#374151;font-size:0.88rem;">
            [% IF merged_chart.overlays.size %]
                [% merged_chart.base.label | html %] + [% merged_chart.overlays.size %] overlay(s)
            [% ELSE %]
                Base archetype only
            [% END %] — [% merged_chart.rows.size %] chart entries
        </p>
        <table style="width:100%;border-collapse:collapse;font-size:0.82rem;">
            <thead><tr style="background:#f3f4f6;">
                <th style="text-align:left;padding:0.4rem;">Acc #</th>
                <th style="text-align:left;padding:0.4rem;">Description</th>
                <th style="text-align:center;padding:0.4rem;">Category</th>
                <th style="text-align:center;padding:0.4rem;">GIFI</th>
            </tr></thead>
            <tbody>
            [% FOREACH row IN merged_chart.rows %]
                <tr style="border-top:1px solid #f3f4f6;">
                    <td style="padding:0.4rem;font-family:monospace;">[% row.accno | html %]</td>
                    <td style="padding:0.4rem;">[% row.description | html %]</td>
                    <td style="padding:0.4rem;text-align:center;">
                        [% IF row.category == 'A' %]Asset[% ELSIF row.category == 'L' %]Liability[% ELSIF row.category == 'Q' %]Equity[% ELSIF row.category == 'I' %]Income[% ELSIF row.category == 'E' %]Expense[% END %]
                    </td>
                    <td style="padding:0.4rem;text-align:center;color:#6b7280;">
                        [% IF row.gifi_accno %}[% row.gifi_accno | html %][% ELSE %]–[% END %]
                    </td>
                </tr>
            [% END %]
            </tbody>
        </table>
        <p style="margin-top:0.75rem;font-size:0.8rem;color:#6b7280;">
            Previewed rows limited. Full chart seeded on your request. 
            [<a href="/Accounting/setup/seed_chart">Seed this chart to my database</a>]
        </p>
    </div>
    [% END %]
[% END %]

    [%# ── Step 4: Already seeded? ───────────────────────────────────── %]
    [% IF chart_seeded %]
    <div style="background:#f0fdf4;border:1px solid #86efac;border-radius:8px;padding:1rem 1.5rem;margin-bottom:1.5rem;">
        <h3 style="margin-top:0;color:#065f46;font-size:1rem;">✅ Chart of Accounts Seeded</h3>
        <p style="margin:0.5rem 0;color:#374151;font-size:0.9rem;">
            [% coa_count | numeric_format %] accounts loaded from <strong>[% chosen_base | html %]</strong>
            [% IF chosen_overlays.size %](with [% chosen_overlays.join(', ') | html %] overlay)% END %.
            You can <a href="/Accounting/coa">view and edit</a> entries, or <a href="/Accounting/setup">start the data import</a>.
        </p>
    </div>
    [% END %]

    [%# ── Admin-only: which sites are subscribed to accounting ─────────── %]
    [% IF subscribers.size %]
    <div style="background:#f8fafc;border:1px dashed #cbd5e1;border-radius:8px;padding:1rem 1.5rem;margin-bottom:1.5rem;">
        <h4 style="margin-top:0;color:#475569;font-size:0.92rem;">Sites subscribed to Accounting (CSC admin view)</h4>
        <p style="margin:0.4rem 0 0;font-size:0.85rem;color:#64748b;">
            [% subscribers.size %] site(s): [% subscribers.join(', ') | html %]
        </p>
    </div>
    [% END %]

</div>
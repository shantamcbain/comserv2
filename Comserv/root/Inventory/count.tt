[% PageVersion = 'Inventory/count.tt,v 0.01 2026/09/12' %]
[% IF c.session.debug_mode == 1 %][% PageVersion %][% END %]

<h1>📋 Physical Inventory Count</h1>
<p>Site: <strong>[% sitename %]</strong></p>

[% IF c.flash.success_msg %]<p class="success">[% c.flash.success_msg %]</p>[% END %]
[% IF c.flash.error_msg %]<p class="error">[% c.flash.error_msg %]</p>[% END %]

<form method="GET" action="/Inventory/count" style="margin-bottom:1rem;">
  <label>Category:
    <select name="category">
      <option value="">-- All Categories --</option>
      [% FOREACH cat IN categories %]
      <option value="[% cat %]"[% IF category == cat %] selected[% END %]>[% cat %]</option>
      [% END %]
    </select>
  </label>
  &nbsp;<input type="submit" value="Load Sheet">
  [% IF has_draft %]<span style="color:var(--success-color,#28a745);margin-left:0.5rem;">⤿ Draft resumed</span>[% END %]
</form>

[% IF rows.size == 0 %]
  <p>No active items for this filter.</p>
[% ELSE %]
<form method="POST" action="/Inventory/count/submit" id="count-form">
  <input type="hidden" name="category" value="[% category %]">
  <div style="margin-bottom:0.75rem;">
    <button type="submit" formaction="/Inventory/count/save" class="btn-order"
      onclick="return confirm('Save this count as a draft to resume later?');">💾 Save Draft</button>
    &nbsp;
    <button type="submit" class="btn-order"
      onclick="return confirm('Apply counted values to stock? System stock will be set to what you entered (duplicates merged).');">✅ Submit Count</button>
    <span style="font-size:0.8rem;color:#666;margin-left:0.5rem;">Enter found amount + unit. 1 each = 1000 g (1 kg spool). Difference updates stock up/down.</span>
  </div>

  <table border="1" cellpadding="5" cellspacing="0" style="border-collapse:collapse;width:100%;">
    <thead style="background:#f0f0f0;">
      <tr>
        <th>SKU</th>
        <th>Item (Barcode)</th>
        <th>Location</th>
        <th>System Qty (g)</th>
        <th>Found Qty</th>
        <th>Unit</th>
        <th>Found (g)</th>
        <th>Diff (g)</th>
        <th>Note</th>
      </tr>
    </thead>
    <tbody>
    [% FOREACH row IN rows %]
      [% SET fq = row.found_qty || '' %]
      [% SET fu = row.found_unit || 'g' %]
      [% SET factor = fu == 'kg' ? 1000 : (fu == 'each' ? 1000 : 1) %]
      [% SET found_g = fq != '' ? (fq * factor) : '' %]
      [% SET diff = found_g != '' ? (found_g - row.sys_g) : '' %]
      <tr>
        <td>[% row.sku %]</td>
        <td>[% row.name %] <br><small>[% row.barcode || '—' %] ([% row.barcode_type || '—' %])</small></td>
        <td>[% row.location_id || '—' %]</td>
        <td style="text-align:right;">[% row.sys_g %]</td>
        <td><input type="text" name="found_[% row.item_id %]_[% row.location_id %]" value="[% fq %]" size="8"
                 oninput="recalc(this, [% row.sys_g %], '[% row.item_id %]_[% row.location_id %]')"></td>
        <td>
          <select name="unit_[% row.item_id %]_[% row.location_id %]" onchange="recalc(this, [% row.sys_g %], '[% row.item_id %]_[% row.location_id %]')">
            <option value="g"[% IF fu == 'g' %] selected[% END %]>g</option>
            <option value="kg"[% IF fu == 'kg' %] selected[% END %]>kg</option>
            <option value="each"[% IF fu == 'each' %] selected[% END %]>each</option>
          </select>
        </td>
        <td style="text-align:right;" id="fg_[% row.item_id %]_[% row.location_id %]">[% found_g %]</td>
        <td style="text-align:right;[% IF diff != '' && diff < 0 %]color:#c00;[% ELSIF diff != '' && diff > 0 %]color:#080;[% END %]" id="df_[% row.item_id %]_[% row.location_id %]">[% diff %]</td>
        <td><input type="text" name="note_[% row.item_id %]_[% row.location_id %]" value="[% row.note %]" size="14"></td>
      </tr>
    [% END %]
    </tbody>
  </table>
  <p><em>[% rows.size %] row(s). Submit sets system stock to your entered values (grams); a physical_count transaction records the delta.</em></p>
</form>

<!-- Quick scan helper for count -->
<div style="margin: 0.5rem 0;">
  <label>Quick Scan / Lookup Barcode: 
    <input type="text" id="count-barcode-scan" placeholder="Scan or type barcode" style="width:200px;">
  </label>
  <button type="button" onclick="scanCountBarcode()">Find &amp; Focus</button>
  <small> (Enter barcode to highlight matching row. On phone: use a barcode scanner app then paste.)</small>
</div>

<!-- Camera section for count (reuse pattern) -->
<div style="margin:0.5rem 0; padding:0.5rem; border:1px solid var(--border-color); border-radius:4px; font-size:0.9em;">
  <strong>Camera (optional visual for count evidence)</strong><br>
  <small><strong>ZeroTier note:</strong> In-browser camera blocked on phones/tablets (no HTTPS). Use manual entry + File Manager for photos. The buttons will show a clear message.</small>
  <button type="button" id="count-start-cam">📷 Cam (desktop/HTTPS only)</button>
  <button type="button" id="count-capture">Capture</button>
  <video id="count-video" style="display:none;max-width:200px;"></video>
  <canvas id="count-canvas" style="display:none;"></canvas>
  <img id="count-preview" style="display:none;max-width:100px;">
</div>

<script>
function recalc(el, sys_g, key) {
  var row = el.closest('tr');
  var qty = parseFloat(row.querySelector('input[name^="found_"]').value) || 0;
  var unit = row.querySelector('select[name^="unit_"]').value;
  var factor = unit === 'kg' ? 1000 : (unit === 'each' ? 1000 : 1);
  var fg = qty * factor;
  var df = fg - sys_g;
  document.getElementById('fg_' + key).textContent = fg;
  var d = document.getElementById('df_' + key);
  d.textContent = df;
  d.style.color = df < 0 ? '#c00' : (df > 0 ? '#080' : '');
}

function scanCountBarcode() {
  var val = document.getElementById('count-barcode-scan').value.trim().toLowerCase();
  if (!val) return;
  var rows = document.querySelectorAll('#count-form tbody tr');
  rows.forEach(function(r) {
    r.style.background = '';
    var text = r.textContent.toLowerCase();
    if (text.indexOf(val) !== -1) {
      r.style.background = '#fff3cd';
      r.scrollIntoView({block: 'center'});
      var input = r.querySelector('input[name^="found_"]');
      if (input) input.focus();
    }
  });
}

// Basic camera for count (evidence photo)
// Note: getUserMedia requires HTTPS on most mobile devices (Android etc.). Will gracefully degrade.
(function() {
  var v = document.getElementById('count-video');
  var c = document.getElementById('count-canvas');
  var p = document.getElementById('count-preview');
  if (!v) return;

  function cameraSupported() {
    return !!(navigator.mediaDevices && navigator.mediaDevices.getUserMedia);
  }

  document.getElementById('count-start-cam').onclick = async function() {
    if (!cameraSupported()) {
      alert('Camera blocked on ZeroTier (no HTTPS). Use phone camera app + File Manager for photos on mobile.');
      return;
    }
    try {
      var s = await navigator.mediaDevices.getUserMedia({video:true});
      v.srcObject = s; v.style.display='block';
    } catch(e){ alert('Camera error: '+e.message || e); }
  };
  document.getElementById('count-capture').onclick = function() {
    if (!v.srcObject) return;
    c.width = v.videoWidth; c.height = v.videoHeight;
    c.getContext('2d').drawImage(v,0,0);
    p.src = c.toDataURL('image/jpeg');
    p.style.display = 'inline';
    alert('Photo captured for evidence. Save via File Manager to NFS and note in the item or count note.');
  };
})();
</script>

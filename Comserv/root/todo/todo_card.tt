[%# ============================================================
  Shared Todo Card — SINGLE SOURCE OF TRUTH for every todo list
  (todo.tt main list, day/week/month views, project tabs).

  Renders a global <details> container:
    • CLOSED by default — the summary row shows badges + subject
      + the standard action buttons (View / Log / Start / Done),
      so a closed card is fully actionable.
    • OPENING expands the details-page equivalent (fields +
      description + comments + actions).

  Styling reuses the STANDARD theme classes (Bootstrap utilities
  + todo.css .action-button / .log-button) so cards match the rest
  of the site. No per-page CSS, no new visual language.

  Required:
    tc - todo object (record_id, subject, priority, status, sitename, …)

  Optional context flags (used to control extra badges):
    tc_wrapper_id, tc_wrapper_extra_data, tc_rank, tc_icon_char,
    tc_icon_color, tc_is_audit_root, tc_is_stale, tc_stale_days,
    tc_is_blocking, tc_is_cross_blocker, tc_blocking_count,
    tc_blocking_names, tc_is_overdue, tc_due_today, tc_is_blocked,
    tc_blocker_subject, tc_show_done, tc_done_fn, tc_meta_extra,
    tc_est_mins, tc_open

  Calendar / drag integration (added for full cross-list unification):
    tc_drag_class  — extra class(es) on the outer .todo-card div so the
      calendar drag-and-drop bindings (todo_drag_drop.js selects
      .todo-item-day / .todo-item-shared / .todo-item-month) keep matching
      the card when it is rendered inside a calendar time-slot.
    tc_wrapper_extra — raw attributes appended to the outer div (e.g.
      data-todo-id / data-todo-date / data-is-recurring / draggable /
      positioning style) so the existing reschedule-on-drop logic keeps
      working. Kept separate from tc_wrapper_extra_data (its own slot).

  Outer-scope variables used automatically: is_admin, is_csc
  ============================================================ %]
[% tc_done_fn  = tc_done_fn || 'quickClose' -%]
[% SET tci_p   = tc.priority || 9 -%]
[% SET tci_status = tc.status -%]
[% SET tci_is_done = (tci_status == 3 OR tci_status == 4
    OR tci_status == 'DONE' OR tci_status == 'Completed'
    OR tci_status == 'completed' OR tci_status == 'Closed'
    OR tci_status == 'closed' OR tci_status == 'Done') -%]
[% SET tci_rid = tc.record_id -%]
[% SET tci_is_active = (tci_status == 5 OR active_todos.$tci_rid) -%]

[%# Status label (numeric → string, matching todo_row.tt) %]
[% SET tci_st_label = 'New' %]
[% SET tci_st_cls   = 'badge-secondary' %]
[% IF tci_is_active %]
    [% SET tci_st_label = 'Active' %][% SET tci_st_cls = 'badge-warning' %]
[% ELSIF tci_status == 2 %]
    [% SET tci_st_label = 'In Progress' %][% SET tci_st_cls = 'badge-info' %]
[% ELSIF tci_is_done %]
    [% SET tci_st_label = 'Done' %][% SET tci_st_cls = 'badge-success' %]
[% END %]

<div [% IF tc_wrapper_id %]id="[% tc_wrapper_id %]"[% END %]
     [% tc_wrapper_extra_data %][% IF tc_wrapper_extra %] [% tc_wrapper_extra %][% END %]
     class="todo-card[% IF tc_drag_class %] [% tc_drag_class %][% END %][% IF tci_is_done OR tc_is_blocked %] opacity-60[% END %]">
  <details [% IF tc_open %]open[% END %] class="card">
    [%# ── Closed summary row ── %]
    [% IF tc_calendar %]
    [%# Calendar-compact: TITLE first, then PRIORITY. The status/"New" badge is
        redundant when the card is fully visible, so it is omitted from the
        header. Action buttons live in the hover popup (todo-card-popup),
        which is not confined to the card window. %]
    <summary class="d-flex align-items-center p-1 todo-card-summary-cal">
      <a href="/todo/details?record_id=[% tc.record_id %]"
         class="todo-card-subject flex-grow-1 min-width-0">[% tc.subject || '(No subject)' | html %]</a>
      <span class="badge pri-[% tci_p %]">P[% tci_p %]</span>
      [% IF is_csc && tc.sitename && tc.sitename != 'CSC' %]<span class="badge badge-primary">[% tc.sitename | html %]</span>[% END %]
      [% IF tc_is_overdue %]<span class="badge badge-danger">OVR</span>[% END %]
    </summary>
    [%# Hover popup — not confined to the card — shows the action buttons %]
    <div class="todo-popup todo-card-popup">
      <div class="todo-popup-actions">
        <a href="/todo/details?record_id=[% tc.record_id %]" class="btn btn-sm btn-outline-primary">View</a>
        <a href="/log/log_form?todo_record_id=[% tc.record_id %]" class="btn btn-sm btn-outline-info">Log</a>
        [% IF tc_show_done && is_admin && !tci_is_done %]
          [% IF tci_is_active %]
          <button data-start-btn="1" data-record-id="[% tc.record_id %]" data-is-active="1" class="btn btn-sm btn-outline-warning" title="Work session open — click to close the log (todo stays open for more work)">⏸ Stop</button>
          [% ELSE %]
          <button data-start-btn="1" data-record-id="[% tc.record_id %]" data-is-active="0" class="btn btn-sm btn-outline-primary" title="Start working — creates a log entry, marks todo active">▶ Start</button>
          [% END %]
          <button data-done-btn="1" data-record-id="[% tc.record_id %]" data-is-active="[% tci_is_active ? '1' : '0' %]" class="btn btn-sm btn-outline-success">Done</button>
        [% ELSIF tc_show_done && is_admin %]
          <button data-done-btn="1" data-record-id="[% tc.record_id %]" data-is-active="0" class="btn btn-sm btn-outline-success">Done</button>
        [% END %]
        [% IF tc.sitename %]<div class="todo-popup-meta">[% tc.sitename | html %][% IF tc.developer %] · [% tc.developer | html %][% END %]</div>[% END %]
      </div>
    </div>
    [% ELSE %]
    [%# Standard summary (Focus Queue / project pages): badges + subject + buttons %]
    <summary class="d-flex align-items-center justify-content-between p-2">
      <div class="d-flex align-items-center flex-grow-1 min-width-0 todo-card-badges">
        <span class="badge pri-[% tci_p %]">P[% tci_p %]</span>
        <span class="badge [% tci_st_cls %]">[% tci_st_label %]</span>
        [% IF tc_is_audit_root %]<span class="badge badge-danger">AUDIT ROOT</span>[% END %]
        [% SET tci_occ = 0 %][% IF tc.occurrence_count && tc.occurrence_count > 1 %][% SET tci_occ = tc.occurrence_count %][% END %]
        [% IF tci_occ > 1 %]<span class="badge badge-danger" title="Recurred [% tci_occ %] times">↻ [% tci_occ %]×</span>[% END %]
        [% SET tci_type = tc.todo_type || 'task' %]
        [% IF tci_type == 'appointment' %]<span class="badge badge-primary" title="Appointment">📌</span>
        [% ELSIF tci_type == 'meeting' %]<span class="badge badge-primary" title="Meeting">🤝</span>
        [% ELSIF tci_type == 'event' %]<span class="badge badge-primary" title="Event">🎂</span>
        [% ELSIF tci_type == 'reminder' %]<span class="badge badge-warning" title="Reminder">🔔</span>[% END %]
        [% SET tci_subj_l = tc.subject.lower %]
        [% IF tc.is_recurring OR tci_subj_l.match('lunch') OR tci_subj_l.match('break') OR tci_subj_l.match('standup') %]<span class="badge badge-secondary" title="[% tc.recurrence_rule || 'recurring' %]">🔁</span>[% END %]
        [% IF tc_is_stale %]<span class="badge badge-warning" title="No activity for [% tc_stale_days %] days">⏳ [% tc_stale_days %]d</span>[% END %]
        [% IF tc_is_blocking %]<span class="badge badge-danger" title="Other tasks depend on this">🔒</span>[% END %]
        [% IF tc_is_cross_blocker && tc_is_blocking %]<span class="badge badge-primary" title="Unblocks [% tc_blocking_count %] task(s)">🔗[% tc_blocking_count %]</span>[% END %]
        [% IF tc_is_blocked %]<span class="badge badge-secondary" title="Waiting on: [% tc_blocker_subject %]">⏸</span>[% END %]
        [% IF tc_is_overdue %]<span class="badge badge-danger">🔴 OVR</span>
        [% ELSIF tc_due_today %]<span class="badge badge-warning">⚡</span>[% END %]
        [% IF is_csc && tc.sitename && tc.sitename != 'CSC' %]<span class="badge badge-primary">[% tc.sitename | html %]</span>[% END %]
        <a href="/todo/details?record_id=[% tc.record_id %]" class="todo-card-subject ml-1">[% tc.subject || '(No subject)' | html %]</a>
      </div>
      <div class="d-flex align-items-center flex-shrink-0 todo-card-actions">
        <a href="/todo/details?record_id=[% tc.record_id %]" class="btn btn-sm btn-outline-primary">View</a>
        <a href="/log/log_form?todo_record_id=[% tc.record_id %]" class="btn btn-sm btn-outline-info">Log</a>
        [% IF tc_show_done && is_admin && !tci_is_done %]
          [% IF tci_is_active %]
          <button data-start-btn="1" data-record-id="[% tc.record_id %]" data-is-active="1" class="btn btn-sm btn-outline-warning" title="Work session open — click to close the log (todo stays open for more work)">⏸ Stop</button>
          [% ELSE %]
          <button data-start-btn="1" data-record-id="[% tc.record_id %]" data-is-active="0" class="btn btn-sm btn-outline-primary" title="Start working — creates a log entry, marks todo active">▶ Start</button>
          [% END %]
          <button data-done-btn="1" data-record-id="[% tc.record_id %]" data-is-active="[% tci_is_active ? '1' : '0' %]" class="btn btn-sm btn-outline-success" title="[% tci_is_active ? 'Close log and mark todo done' : 'Mark done' %]">Done</button>
        [% ELSIF tc_show_done && is_admin %]
          <button data-done-btn="1" data-record-id="[% tc.record_id %]" data-is-active="0" class="btn btn-sm btn-outline-success" title="Mark done">Done</button>
        [% END %]
      </div>
    </summary>
    [% END %]

    [%# ── Open body: details-page equivalent ── %]
    <div class="card-body">
      <div class="row">
        [% IF tc.start_date %]
        <div class="col-md-3 col-sm-6 mb-2"><small class="text-muted d-block">Start Date</small>[% tc.start_date %]</div>
        [% END %]
        [% IF tc.due_date %]
        <div class="col-md-3 col-sm-6 mb-2"><small class="text-muted d-block">Due Date</small>[% tc.due_date %]</div>
        [% END %]
        [% IF tc.developer %]
        <div class="col-md-3 col-sm-6 mb-2"><small class="text-muted d-block">Assigned To</small>[% tc.developer | html %]</div>
        [% END %]
        [% IF tc.accumulative_time %]
        <div class="col-md-3 col-sm-6 mb-2"><small class="text-muted d-block">Accumulated Time</small>[% tc.accumulative_time %]</div>
        [% END %]
        [% IF tc.parent_todo %]
        <div class="col-md-3 col-sm-6 mb-2"><small class="text-muted d-block">Parent Todo</small><a href="/todo/details?record_id=[% tc.parent_todo %]">#[% tc.parent_todo %]</a></div>
        [% END %]
        [% IF tc.sitename %]
        <div class="col-md-3 col-sm-6 mb-2"><small class="text-muted d-block">Site</small>[% tc.sitename | html %]</div>
        [% END %]
        [% IF tc.project %]
        <div class="col-md-3 col-sm-6 mb-2"><small class="text-muted d-block">Project</small><a href="/project/details?project_id=[% tc.project.id %]">[% tc.project.name | html %]</a></div>
        [% END %]
      </div>

      [% IF tc.description %]
      <div class="mb-2"><small class="text-muted d-block">Description</small><div class="todo-card-pre border rounded p-2">[% tc.description | html %]</div></div>
      [% END %]

      [% IF tc.comments %]
      <div class="mb-2"><small class="text-muted d-block">Comments / Code context</small><div class="todo-card-pre border rounded p-2">[% tc.comments | html %]</div></div>
      [% END %]

      <div class="mt-2 pt-2 border-top">
        <a href="/log/log_form?todo_record_id=[% tc.record_id %]" class="btn btn-sm btn-info" target="_blank">📋 Log</a>
        <a href="/todo/details?record_id=[% tc.record_id %]" class="btn btn-sm btn-primary">Details</a>
        <a href="/todo/edit/[% tc.record_id %]" class="btn btn-sm btn-secondary">Edit</a>
      </div>
    </div>
  </details>
</div>

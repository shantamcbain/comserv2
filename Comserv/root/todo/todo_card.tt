[%# ============================================================
  Shared Todo Card — SINGLE SOURCE OF TRUTH for every todo list
  (todo.tt main list, day/week/month views, project tabs).

  Renders a global <details> container:
    • CLOSED by default — the summary row shows badges + subject
      + the standard action buttons (View / Log / Start / Done),
      so a closed card is fully actionable.
    • OPENING expands the details-page equivalent (fields +
      description + comments + actions).

  Styling reuses the STANDARD theme classes (Bootstrap utilities
  + todo.css .action-button / .log-button) so cards match the rest
  of the site. No per-page CSS, no new visual language.

  Required:
    tc - todo object (record_id, subject, priority, status, sitename, …)

  Optional context flags (used to control extra badges):
    tc_wrapper_id, tc_wrapper_extra_data, tc_rank, tc_icon_char,
    tc_icon_color, tc_is_audit_root, tc_is_stale, tc_stale_days,
    tc_is_blocking, tc_is_cross_blocker, tc_blocking_count,
    tc_blocking_names, tc_is_overdue, tc_due_today, tc_is_blocked,
    tc_blocker_subject, tc_show_done, tc_done_fn, tc_meta_extra,
    tc_est_mins, tc_open

  Outer-scope variables used automatically: is_admin, is_csc
  ============================================================ %]
[% tc_done_fn  = tc_done_fn || 'quickClose' -%]
[% SET tci_p   = tc.priority || 9 -%]
[% SET tci_status = tc.status -%]
[% SET tci_is_done = (tci_status == 3 OR tci_status == 4
    OR tci_status == 'DONE' OR tci_status == 'Completed'
    OR tci_status == 'completed' OR tci_status == 'Closed'
    OR tci_status == 'closed' OR tci_status == 'Done') -%]
[% SET tci_rid = tc.record_id -%]
[% SET tci_is_active = (tci_status == 5 OR active_todos.$tci_rid) -%]

[%# Status label (numeric → string, matching todo_row.tt) %]
[% SET tci_st_label = 'New' %]
[% SET tci_st_cls   = 'badge-secondary' %]
[% IF tci_is_active %]
    [% SET tci_st_label = 'Active' %][% SET tci_st_cls = 'badge-warning' %]
[% ELSIF tci_status == 2 %]
    [% SET tci_st_label = 'In Progress' %][% SET tci_st_cls = 'badge-info' %]
[% ELSIF tci_is_done %]
    [% SET tci_st_label = 'Done' %][% SET tci_st_cls = 'badge-success' %]
[% END %]

<div [% IF tc_wrapper_id %]id="[% tc_wrapper_id %]"[% END %]
     [% tc_wrapper_extra_data %]
     class="todo-card[% IF tci_is_done OR tc_is_blocked %] opacity-60[% END %]">
  <details [% IF tc_open %]open[% END %] class="card">
    [%# ── Closed summary row = badges + subject + standard action buttons ── %]
    <summary class="d-flex align-items-center justify-content-between p-2">
      <div class="d-flex align-items-center flex-grow-1 min-width-0" style="gap:4px;">

        [%# Priority badge %]
        <span class="badge pri-[% tci_p %]">P[% tci_p %]</span>

        [%# Status badge %]
        <span class="badge [% tci_st_cls %]">[% tci_st_label %]</span>

        [%# Audit / occurrence / type / flag badges (compact, standard .badge) %]
        [% IF tc_is_audit_root %]
        <span class="badge badge-danger">AUDIT ROOT</span>
        [% END %]

        [% SET tci_occ = 0 %]
        [% IF tc.occurrence_count && tc.occurrence_count > 1 %][% SET tci_occ = tc.occurrence_count %][% END %]
        [% IF tci_occ > 1 %]
        <span class="badge badge-danger" title="Recurred [% tci_occ %] times">↻ [% tci_occ %]×</span>
        [% END %]

        [% SET tci_type = tc.todo_type || 'task' %]
        [% IF tci_type == 'appointment' %]
        <span class="badge badge-primary" title="Appointment">📌</span>
        [% ELSIF tci_type == 'meeting' %]
        <span class="badge badge-primary" title="Meeting">🤝</span>
        [% ELSIF tci_type == 'event' %]
        <span class="badge badge-primary" title="Event">🎂</span>
        [% ELSIF tci_type == 'reminder' %]
        <span class="badge badge-warning" title="Reminder">🔔</span>
        [% END %]

        [% SET tci_subj_l = tc.subject.lower %]
        [% IF tc.is_recurring OR tci_subj_l.match('lunch') OR tci_subj_l.match('break') OR tci_subj_l.match('standup') %]
        <span class="badge badge-secondary" title="[% tc.recurrence_rule || 'recurring' %]">🔁</span>
        [% END %]

        [% IF tc_is_stale %]
        <span class="badge badge-warning" title="No activity for [% tc_stale_days %] days">⏳ [% tc_stale_days %]d</span>
        [% END %]
        [% IF tc_is_blocking %]
        <span class="badge badge-danger" title="Other tasks depend on this">🔒</span>
        [% END %]
        [% IF tc_is_cross_blocker && tc_is_blocking %]
        <span class="badge badge-primary" title="Unblocks [% tc_blocking_count %] task(s)">🔗[% tc_blocking_count %]</span>
        [% END %]
        [% IF tc_is_blocked %]
        <span class="badge badge-secondary" title="Waiting on: [% tc_blocker_subject %]">⏸</span>
        [% END %]
        [% IF tc_is_overdue %]
        <span class="badge badge-danger">🔴 OVR</span>
        [% ELSIF tc_due_today %]
        <span class="badge badge-warning">⚡</span>
        [% END %]
        [% IF is_csc && tc.sitename && tc.sitename != 'CSC' %]
        <span class="badge badge-primary">[% tc.sitename %]</span>
        [% END %]

        [%# Subject link %]
        <a href="/todo/details?record_id=[% tc.record_id %]"
           class="text-truncate font-weight-bold ml-1"
           style="max-width:360px; color: var(--text-color); [% IF tci_is_done %]text-decoration:line-through;[% END %]"
           title="[% tc.subject | html %]">
          [% tc.subject || '(No subject)' %]
        </a>
      </div>

      [%# Action buttons — same as todo_row.tt, always visible in the closed card %]
      <div class="d-flex align-items-center flex-shrink-0" style="gap:4px;">
        <a href="/todo/details?record_id=[% tc.record_id %]"
           class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size:0.75em;">View</a>

        <a href="/log/log_form?todo_record_id=[% tc.record_id %]"
           class="btn btn-sm btn-outline-info py-0 px-2" style="font-size:0.75em;">Log</a>

        [% IF tc_show_done && is_admin && !tci_is_done %]
          [% IF tci_is_active %]
          <button data-start-btn="1" data-record-id="[% tc.record_id %]"
                  class="btn btn-sm btn-outline-warning py-0 px-2" style="font-size:0.75em;"
                  title="Session active — click to close session">⏸ Active</button>
          [% ELSE %]
          <button data-start-btn="1" data-record-id="[% tc.record_id %]"
                  class="btn btn-sm btn-outline-primary py-0 px-2" style="font-size:0.75em;"
                  title="Start working — creates a log entry">▶ Start</button>
          [% END %]
          <button data-done-btn="1" data-record-id="[% tc.record_id %]" data-is-active="[% tci_is_active ? '1' : '0' %]"
                  class="btn btn-sm btn-outline-success py-0 px-2" style="font-size:0.75em;"
                  title="[% tci_is_active ? 'Close log and mark todo done' : 'Mark done' %]">Done</button>
        [% ELSIF tc_show_done && is_admin %]
          <button data-done-btn="1" data-record-id="[% tc.record_id %]" data-is-active="0"
                  class="btn btn-sm btn-outline-success py-0 px-2" style="font-size:0.75em;" title="Mark done">Done</button>
        [% END %]
      </div>
    </summary>

    [%# ── Open body: details-page equivalent ── %]
    <div class="card-body">
      <div class="row">
        [% IF tc.start_date %]
        <div class="col-md-3 col-sm-6 mb-2"><small class="text-muted d-block">Start Date</small>[% tc.start_date %]</div>
        [% END %]
        [% IF tc.due_date %]
        <div class="col-md-3 col-sm-6 mb-2"><small class="text-muted d-block">Due Date</small>[% tc.due_date %]</div>
        [% END %]
        [% IF tc.developer %]
        <div class="col-md-3 col-sm-6 mb-2"><small class="text-muted d-block">Assigned To</small>[% tc.developer %]</div>
        [% END %]
        [% IF tc.accumulative_time %]
        <div class="col-md-3 col-sm-6 mb-2"><small class="text-muted d-block">Accumulated Time</small>[% tc.accumulative_time %]</div>
        [% END %]
        [% IF tc.parent_todo %]
        <div class="col-md-3 col-sm-6 mb-2"><small class="text-muted d-block">Parent Todo</small><a href="/todo/details?record_id=[% tc.parent_todo %]">#[% tc.parent_todo %]</a></div>
        [% END %]
        [% IF tc.sitename %]
        <div class="col-md-3 col-sm-6 mb-2"><small class="text-muted d-block">Site</small>[% tc.sitename %]</div>
        [% END %]
      </div>

      [% IF tc.description %]
      <div class="mb-2"><small class="text-muted d-block">Description</small><div class="border rounded p-2 bg-light" style="white-space:pre-wrap;word-break:break-word;">[% tc.description %]</div></div>
      [% END %]

      [% IF tc.comments %]
      <div class="mb-2"><small class="text-muted d-block">Comments / Code context</small><div class="border rounded p-2 bg-light" style="white-space:pre-wrap;word-break:break-word;">[% tc.comments %]</div></div>
      [% END %]

      <div class="mt-2 pt-2 border-top">
        <a href="/log/log_form?todo_record_id=[% tc.record_id %]" class="btn btn-sm btn-info" target="_blank">📋 Log</a>
        <a href="/todo/details?record_id=[% tc.record_id %]" class="btn btn-sm btn-primary">Details</a>
        <a href="/todo/edit/[% tc.record_id %]" class="btn btn-sm btn-secondary">Edit</a>
      </div>
    </div>
  </details>
</div>

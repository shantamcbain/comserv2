
[% META title = 'Project Details' %]

[% IF success_message %]
<div class="success-message">
    [% success_message %]
</div>
[% END %]

[% IF error_msg %]
<div class="error-message">
    [% error_msg %]
</div>
[% END %]

[% MACRO display_project_details(project, level) BLOCK %]
    [% SET indent = '' %]
    [% FOREACH i IN [1..level] %]
        [% indent = indent _ '    ' %]
    [% END %]

    <div class="project-details" style="margin-left: [% level * 20 %]px;">
        <h[% level + 1 %]>[% IF level > 0 %]Sub-Project: [% END %][% project.name %]</h[% level + 1 %]>

        <table class="project-details-table" style="margin:12px 0;">
            <tr><th style="width:200px;">Field</th><th>Value</th></tr>
            <tr><td><strong>ID</strong></td><td>[% project.id %]</td></tr>
            <tr><td><strong>Record ID</strong></td><td>[% project.record_id OR '—' %]</td></tr>
            <tr><td><strong>Site</strong></td><td>[% project.sitename OR '—' %]</td></tr>
            <tr><td><strong>Project Code</strong></td><td>[% project.project_code OR '—' %]</td></tr>
            <tr><td><strong>Status</strong></td><td>[% project.status OR '—' %]</td></tr>
            <tr><td><strong>Description</strong></td><td>[% project.description OR '—' %]</td></tr>
            <tr><td><strong>Start Date</strong></td><td>[% project.start_date OR '—' %]</td></tr>
            <tr><td><strong>End Date</strong></td><td>[% project.end_date OR '—' %]</td></tr>
            <tr><td><strong>Project Size</strong></td><td>[% project.project_size OR '—' %]</td></tr>
            <tr><td><strong>Est. Man Hours</strong></td><td>[% project.estimated_man_hours OR '—' %]</td></tr>
            <tr><td><strong>Developer</strong></td><td>[% project.developer_name OR '—' %]</td></tr>
            <tr><td><strong>Client</strong></td><td>[% project.client_name OR '—' %]</td></tr>
            <tr><td><strong>Parent Project ID</strong></td><td>[% project.parent_id OR '—' %]</td></tr>
            <tr><td><strong>Posted By</strong></td><td>[% project.username_of_poster OR '—' %]</td></tr>
            <tr><td><strong>Group</strong></td><td>[% project.group_of_poster OR '—' %]</td></tr>
            <tr><td><strong>Date Posted</strong></td><td>[% project.date_time_posted OR '—' %]</td></tr>
            <tr><td><strong>Comments</strong></td><td>[% project.comments OR '—' %]</td></tr>
        </table>

        [% INCLUDE todo/ProjectTodosList.tt project=project level=level %]

        <!-- Actions for this project level -->
        <div class="project-actions">
            <a href="/project/editproject?project_id=[% project.id %]" class="button">
                <button type="button">Edit [% IF level > 0 %]Sub-[% END %]Project</button>
            </a>

            <form action="/project/addproject" method="GET" style="display:inline;">
                <input type="hidden" name="parent_id" value="[% project.id %]">
                <button type="submit">Add Sub-Project</button>
            </form>

            <form action="/todo/addtodo" method="GET" style="display:inline;">
                <input type="hidden" name="project_id" value="[% project.id %]">
                <button type="submit">Add Todo</button>
            </form>
        </div>

        [% IF project.sub_projects && project.sub_projects.size > 0 %]
            [% FOREACH sub_project IN project.sub_projects %]
                [% display_project_details(sub_project, level + 1) %]
            [% END %]
        [% ELSIF level == 0 %]
            <p>No sub-projects found. <a href="/project/addproject?parent_id=[% project.id %]">Add a sub-project</a></p>
        [% END %]
    </div>
[% END %]
[% PageVersion = 'todo/projectdetails.tt,v 0.02 2026/02/06 shanta Exp shanta ' %]
[% IF c.session.debug_mode == 1 %]
    <div style="background: #f0f0f0; padding: 10px; margin: 10px; border: 1px solid #ccc;">
        <h4>Debug Info:</h4>
        <p><strong>PageVersion:</strong> [% PageVersion %]</p>
        <p><strong>Project defined:</strong> [% project ? 'YES' : 'NO' %]</p>
        [% IF project %]
        <p><strong>Project ID:</strong> [% project.id %]</p>
        <p><strong>Project Name:</strong> [% project.name %]</p>
        <p><strong>Todos count:</strong> [% project.todos.size || 0 %]</p>
        <p><strong>Sub-projects count:</strong> [% project.sub_projects.size || 0 %]</p>
        [% END %]
        <p><strong>Error message:</strong> [% error_msg || 'None' %]</p>
        <p><strong>Success message:</strong> [% success_message || 'None' %]</p>
    </div>
[% END %]

[% IF !project %]
<div class="error-message">
    <h2>No Project Data Available</h2>
    <p>Unable to load project details. The project variable is empty or undefined.</p>
    <p><a href="/project">Return to Projects List</a></p>
</div>
[% ELSE %]
<div class="project-container">
    <!-- Display the main project and all its sub-projects recursively -->
    [% display_project_details(project, 0) %]
</div>

<div class="ai-chat-activity-panel" style="margin-top:20px; border:1px solid var(--border-color, #ddd); border-radius:4px; padding:16px; background: var(--bg-secondary, #fafafa);">
    <h3 style="margin-top:0;">AI Chat Activity</h3>
    <div id="ai-project-conversations" data-project-id="[% project.id %]">
        <p style="color:#888; font-size:0.9em;">Loading conversations&hellip;</p>
    </div>
    <div style="margin-top:10px;">
        <a href="/ai?project_id=[% project.id %]" class="button button-primary" style="font-size:0.9em;">Chat about this project</a>
        <a href="/ai/conversations?project_id=[% project.id %]" class="button button-secondary" style="font-size:0.9em; margin-left:8px;">View all project conversations</a>
    </div>
</div>

[%# The AI-conversations fetch is delegated in root/static/js/project/project-conversations.js
    (loaded via root/js_load.tt on /project/ routes). It binds to [data-project-id]
    so no inline <script> is needed here. The #ai-project-conversations div above
    already carries data-project-id. %]
[% END %]

<!-- Display total accumulated time for all projects -->
<h3>Total Accumulated Time for All Projects: [% total_accumulated_time %]</h3>

<!-- Button to go back to the project list -->
<button type="button" onclick="window.location.href='/project';">Back to Projects</button>

<!-- Enhanced styling for project details is loaded via additional_css
     (root/static/css/components/project-details.css) — theme-aware, no inline <style>. -->


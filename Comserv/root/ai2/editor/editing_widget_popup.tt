[%# root/ai2/editor/editing_widget_popup.tt
   PyCharm-like AI Code Editor popup – HTML + TT only.
   All JS moved to external files under static/js/ai2editor/
%]
<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <title>[% page_title | html %]</title>

    <!-- PyCharm-style dark theme (inline minimal CSS) -->
    <style>
        body { font-family: system-ui, sans-serif; margin:0; display:flex; flex-direction:column; height:100vh; background:#1e1f22; color:#ddd; }
        .header { background:#2b2b2b; color:#fff; padding:6px 12px; display:flex; align-items:center; gap:12px; border-bottom:1px solid #555; }
        .header select, .header button { font-size:0.9em; }
        select { background:#313335; color:#ddd; border:1px solid #555; padding:2px 6px; border-radius:3px; }
        .main { display:flex; flex:1; overflow:hidden; position:relative; }
        .sidebar { width:64px; background:#313335; color:#bbb; padding:12px 0; border-right:1px solid #555; display:flex; flex-direction:column; align-items:center; gap:2px; }
        .sidebar-icon { width:52px; padding:8px 0 4px; display:flex; flex-direction:column; align-items:center; justify-content:center; border-radius:6px; cursor:pointer; font-size:11px; color:#aaa; transition:background .1s; position:relative; }
        .sidebar-icon:hover { background:#3c3f41; }
        .sidebar-icon.active { background:#0e639c; color:white; }
        .sidebar-icon .icon { font-size:20px; margin-bottom:2px; }
        .sidebar-icon .label { font-size:9px; text-align:center; line-height:1.1; }
        .file-tree { list-style:none; padding:0; margin:0; }
        .file-tree li { padding:2px 12px; cursor:pointer; display:flex; align-items:center; gap:6px; }
        .file-tree li:hover { background:#3c3f41; }
        .file-tree li.active { background:#0e639c; color:white; }
        .commit-btn { margin:0 12px; width:calc(100%-24px); background:#0e639c; color:white; border:none; padding:6px; border-radius:3px; cursor:pointer; font-size:12px; }
        .commit-panel { background:#2b2b2b; margin:8px 12px; padding:8px; border-radius:4px; }
        .commit-panel textarea { width:100%; height:60px; background:#1e1f22; color:#ddd; border:1px solid #555; border-radius:3px; font-size:12px; resize:vertical; }
        .commit-panel button { margin-top:6px; width:100%; background:#0e639c; color:white; border:none; padding:4px 10px; border-radius:3px; cursor:pointer; font-size:12px; }
        .commit-panel button#cancel-commit-btn { background:#555; }
        .terminal { background:#1e1f22; font-family:monospace; font-size:11px; padding:6px 12px; margin:0 12px; border:1px solid #444; border-radius:3px; }
        .status-bar { background:#007acc; color:white; font-size:11px; padding:2px 8px; display:flex; justify-content:space-between; }
    </style>
</head>
<body>
    <!-- Top Header -->
    <div class="header">
        <label>Branch:
            <select id="branch-select">
                [% FOREACH b IN branches %]
                    <option [% IF b == 'main' %]selected[% END %]>[% b | html %]</option>
                [% END %]
            </select>
        </label>
        <button id="merge-main-btn" style="background:#2e7d32;color:white;border:none;padding:4px 10px;border-radius:3px;cursor:pointer;">Merge</button>

        <label style="margin-left:auto">Model:
            <select id="model-select">
                [% FOREACH m IN recommended_models %]
                    <option [% IF m == selected_model %]selected[% END %]>[% m | html %]</option>
                [% END %]
            </select>
        </label>

        <label style="margin-left:12px">Editor:
            <select id="editor-select">
                <option value="ace">Ace</option>
                <option value="richtext">Rich Text</option>
            </select>
        </label>

        <button id="refresh-btn" style="margin-left:12px;background:#0e639c;color:white;border:none;padding:4px 10px;border-radius:3px;cursor:pointer;">
            ↻ Refresh
        </button>
    </div>

    <div class="main">
        <!-- Left Sidebar Icons -->
        <div class="sidebar" id="sidebar-icons">
            <div class="sidebar-icon" data-panel="projects" title="Projects">
                <div class="icon">📁</div>
                <div class="label">Project</div>
            </div>
            <div class="sidebar-icon" data-panel="git" title="Git">
                <div class="icon">🔀</div>
                <div class="label">Git</div>
            </div>
            <div class="sidebar-icon" data-panel="terminal" title="Terminal">
                <div class="icon">💻</div>
                <div class="label">Terminal</div>
            </div>
            <div class="sidebar-icon" data-panel="review" title="Review & Merge">
                <div class="icon">🔍</div>
                <div class="label">Review</div>
            </div>
            <div class="sidebar-icon" data-panel="hermes" title="Hermes Dashboard">
                <div class="icon">🤖</div>
                <div class="label">Hermes</div>
            </div>
            <div class="sidebar-icon" data-panel="settings" title="Settings">
                <div class="icon">⚙️</div>
                <div class="label">Settings</div>
            </div>
        </div>

        <!-- Sidebar Panels Container -->
        <div id="sidebar-panels" style="position:relative; width:220px; flex:0 0 auto; background:#2b2b2b; border-right:1px solid #555; display:none; overflow:auto; z-index:10;">
            <!-- Panels populated by popup.js -->
            <div id="panel-projects" class="sidebar-panel" style="display:none; padding:12px;">
                <h4 style="margin:0 0 8px 0; font-size:12px; color:#aaa;">PROJECTS</h4>
                <!-- Live project file tree (all files) + changed files at top
                     are rendered by static/js/ai2editor/project-tree.js into
                     #ai2-changed-files (below) and a generated #ai2-project-tree. -->
                <div id="ai2-changed-files" style="margin-top:4px;"></div>
            </div>

            <div id="panel-git" class="sidebar-panel" style="display:none; padding:0; width:100%; background:#2b2b2b; font-size:13px;">
                <!-- The editor and Git desktop intentionally share one implementation. -->
                <iframe src="/admin/git" title="Git Dashboard"
                        style="width:100%;height:calc(100vh - 42px);min-height:620px;border:0;background:#1e1f22;"></iframe>
            </div>

            <div id="panel-terminal" class="sidebar-panel" style="display:none; padding:12px;">
                <h4 style="margin:0 0 8px 0; font-size:12px; color:#aaa;">TERMINAL</h4>
                <div class="terminal" style="height:120px; overflow:auto;">
                    $ git status<br>
                    On branch main<br>
                    Your branch is up to date.
                </div>
            </div>

            <div id="panel-review" class="sidebar-panel" style="display:none; padding:0; width:340px; background:#2b2b2b; font-size:13px; overflow:auto;">
                <div style="padding:12px;">
                    <h4 style="margin:0 0 8px 0; font-size:12px; color:#aaa;">REVIEW &amp; MERGE WORKTREE</h4>
                    <p style="font-size:11px;color:#888;margin:0 0 8px;">AI commits in the worktree; you merge to main here.</p>
                    <select id="review-branch" style="width:100%;background:#313335;color:#ddd;border:1px solid #555;padding:4px;border-radius:3px;margin-bottom:8px;">
                        <option value="">— select worktree branch —</option>
                    </select>
                    <div style="display:flex;gap:8px;margin-bottom:8px;">
                        <button id="review-load-btn" style="flex:1;background:#0e639c;color:#fff;border:none;padding:6px;border-radius:4px;cursor:pointer;">Load Diff</button>
                        <button id="review-testgate-btn" style="flex:1;background:#555;color:#fff;border:none;padding:6px;border-radius:4px;cursor:pointer;">Run Tests</button>
                    </div>
                    <div id="review-testgate-out" style="font-size:11px;color:#888;white-space:pre-wrap;margin-bottom:8px;"></div>
                    <pre id="review-diff" style="background:#1e1f22;color:#9cdcfe;padding:8px;border:1px solid #444;border-radius:4px;height:200px;overflow:auto;white-space:pre-wrap;font-size:11px;"></pre>
                    <div style="display:flex;gap:8px;margin-top:8px;">
                        <button id="review-merge-btn" style="flex:1;background:#2e7d32;color:#fff;border:none;padding:8px;border-radius:4px;cursor:pointer;">Merge → main</button>
                        <button id="review-push-btn" style="flex:1;background:#1565c0;color:#fff;border:none;padding:8px;border-radius:4px;cursor:pointer;">Push GitHub</button>
                    </div>
                    <div id="review-status" style="font-size:11px;margin-top:8px;color:#ff9;white-space:pre-wrap;"></div>
                </div>
            </div>

            <div id="panel-hermes" class="sidebar-panel" style="display:none; padding:0; width:420px; background:#2b2b2b; overflow:auto;">
                <div style="padding:8px;">
                    <h4 style="margin:0 0 6px 0; font-size:12px; color:#aaa;">HERMES DASHBOARD</h4>
                    <p style="font-size:11px;color:#888;margin:0 0 6px;">Embedded Hermes web view (set HERMES_DASHBOARD_URL to enable).</p>
                    [% IF c.config.hermes_dashboard_url %]
                        <iframe src="[% c.config.hermes_dashboard_url | html %]" style="width:100%;height:420px;border:1px solid #555;border-radius:4px;"></iframe>
                    [% ELSE %]
                        <iframe id="hermes-iframe" src="" style="width:100%;height:420px;border:1px solid #555;border-radius:4px;display:none;"></iframe>
                        <div id="hermes-placeholder" style="color:#888;font-size:12px;padding:12px;">No Hermes dashboard URL configured. Set <code>HERMES_DASHBOARD_URL</code> in the app config or pass <code>?hermes=URL</code> to this page.</div>
                    [% END %]
                </div>
            </div>

            <div id="panel-settings" class="sidebar-panel" style="display:none; padding:12px; font-size:12px;">
                <h4 style="margin:0 0 8px 0; font-size:12px; color:#aaa;">EDITOR SETTINGS</h4>
                <label style="display:block;margin:4px 0;">Theme:
                    <select id="theme-select"><option value="dark">Dark (PyCharm)</option></select>
                </label>
                <label style="display:block;margin:4px 0;">Font Size:
                    <select id="font-size"><option value="14" selected>14px</option></select>
                </label>
            </div>
        </div>

        <!-- Main Editor Area (row: code on left, diff rail on right) -->
        <div class="editor-area" style="flex:1; display:flex; flex-direction:row; min-width:0;">
            <!-- Left: editor (tabs + Ace) -->
            <div class="editor-main" style="flex:1; display:flex; flex-direction:column; min-width:0;">
                <div class="editor-tabs" style="background:#2b2b2b; padding:4px 8px; color:#aaa; display:flex; align-items:center; justify-content:space-between;">
                    <span id="file-tab-label" style="font-size:12px;">[% IF file_to_load %][% file_to_load | html %][% ELSE %]No file loaded[% END %]</span>
                    <span style="display:flex;align-items:center;gap:8px;">
                        <span id="file-status" style="font-size:11px;color:#888;"></span>
                        <button id="editor-diff-btn" type="button" title="Show this file's git diff (right panel)" style="background:#3c3f41;color:#ddd;border:1px solid #555;border-radius:3px;cursor:pointer;font-size:11px;padding:2px 8px;">Diff</button>
                        <button id="save-btn" style="background:#0e639c;color:white;border:none;padding:4px 12px;border-radius:3px;cursor:pointer;font-size:12px;display:none;">Save</button>
                    </span>
                </div>
                <div class="editor-content" style="flex:1; position:relative; min-height:0;">
                    <div id="ace-editor" style="width:100%;height:100%;"></div>
                </div>
            </div>
            <!-- Right rail: diff panes (AI suggestion + git diff) sit BESIDE the editor -->
            <div id="editor-right-rail" style="flex:0 0 42%; min-width:260px; max-width:70vw; display:flex; flex-direction:column; border-left:1px solid #555; overflow:auto;">
                <!-- AI Diff Pane -->
                <div id="ai-diff-pane" class="diff-pane" style="flex:0 0 auto; max-height:38vh; background:#2b2b2b; color:#0f0; padding:8px; border-bottom:1px solid #555; font-size:0.85em; overflow:auto; display:none;">
                    <strong style="color:#9cdcfe;">AI Suggestion</strong>
                    <span id="ai-diff-status" style="color:#888; font-size:0.9em;"></span>
                    <pre id="ai-diff-content" style="white-space:pre-wrap; margin:6px 0; color:#0f0;"></pre>
                    <div style="margin-top:8px">
                        <button id="ai-approve-btn" type="button" style="background:#2e7d32;color:white;border:none;padding:4px 12px;border-radius:3px;cursor:pointer;">Approve</button>
                        <button id="ai-reject-btn" type="button" style="background:#555;color:white;border:none;padding:4px 12px;border-radius:3px;cursor:pointer;">Reject</button>
                    </div>
                </div>
                <!-- git diff pane (injected by ai2editor/file-diff.js into this rail) -->
            </div>
        </div>

        <!-- Right Chat Sidebar (resizable + detachable) -->
        <div id="ai-chat-sidebar" class="chat-sidebar" style="width:var(--ai-chat-w,320px); min-width:220px; max-width:70vw; background:#313335; color:#ddd; display:flex; flex-direction:column; border-left:1px solid #555; position:relative;">
            <!-- Resize handle (drag left edge to resize) -->
            <div id="ai-chat-resize" title="Drag to resize" style="position:absolute; left:-3px; top:0; bottom:0; width:6px; cursor:col-resize; z-index:5;"></div>
            <div class="chat-header" style="padding:6px 10px; background:#2b2b2b; font-weight:bold; display:flex; align-items:center; justify-content:space-between;">
                <span>AI Chat (Hy3)</span>
                <span style="display:flex; gap:4px;">
                    <button id="ai-chat-todo" type="button" title="Add a todo for this page’s project" style="background:transparent;border:1px solid #555;color:#aaa;border-radius:3px;cursor:pointer;font-size:11px;padding:1px 6px;">📝 Todo</button>
                    <button id="ai-chat-detach" type="button" title="Open chat in its own window" style="background:transparent;border:1px solid #555;color:#aaa;border-radius:3px;cursor:pointer;font-size:11px;padding:1px 6px;">⤢ Detach</button>
                    <button id="ai-chat-clear" type="button" title="Clear chat" style="background:transparent;border:1px solid #555;color:#aaa;border-radius:3px;cursor:pointer;font-size:11px;padding:1px 6px;">Clear</button>
                    <button id="ai-chat-close" type="button" title="Hide chat (reopen from the 💬 button)" style="background:transparent;border:1px solid #555;color:#aaa;border-radius:3px;cursor:pointer;font-size:11px;padding:1px 6px;">✕</button>
                </span>
            </div>
            <div id="chat-messages" class="chat-messages" style="flex:1; padding:8px; overflow:auto; font-size:0.9em;">
                <div><strong>AI:</strong> How can I help with this file?</div>
            </div>
            <div class="chat-input" style="padding:6px; border-top:1px solid #555; display:flex; gap:6px;">
                <input id="ai-chat-input" type="text" style="flex:1" placeholder="Ask AI about this file...">
                <button id="ai-chat-send" type="button" style="background:#0e639c;color:white;border:none;padding:4px 10px;border-radius:3px;cursor:pointer;">Send</button>
            </div>
        </div>

        <!-- Floating reopen button: shown only when the chat sidebar is closed -->
        <button id="ai-chat-reopen" type="button" title="Show AI chat"
                style="display:none; position:absolute; right:8px; top:50%; transform:translateY(-50%); z-index:30;
                       background:#0e639c; color:#fff; border:none; border-radius:50%; width:38px; height:38px;
                       cursor:pointer; font-size:18px; box-shadow:0 0 6px rgba(0,0,0,0.5);">💬</button>
    </div>

    <!-- Status bar -->
    <div class="status-bar">
        <span id="auto-refresh-status">Auto-refresh: ON (4s)</span>
        <span id="last-modified" style="color:#a0d2ff;"></span>
    </div>

    <!-- Scripts loaded centrally via js_load.tt -->
        [% INCLUDE js_load.tt %]

    [% IF file_to_load %]
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                var filePath = '[% file_to_load | html %]';
                // Expose the opened file so ai2editor/file-diff.js can auto-show
                // its diff when the editor is opened from the Git Dashboard Diff
                // button (no extra click needed).
                window.AI2_FILE_TO_LOAD = filePath;
                var fileName = filePath.split('/').pop();
                var editor = null;
                var hasChanges = false;
                var saveBtn = document.getElementById('save-btn');
                var statusEl = document.getElementById('file-status');
                var tabLabel = document.getElementById('file-tab-label');

                function setStatus(msg, isError) {
                    if (statusEl) {
                        statusEl.textContent = msg;
                        statusEl.style.color = isError ? '#f66' : '#888';
                    }
                }

                function updateDirtyState() {
                    if (!editor) return;
                    hasChanges = true;
                    if (saveBtn) saveBtn.style.display = 'inline-block';
                    if (tabLabel) tabLabel.innerHTML = '<span style="color:#ff6;">●</span> ' + fileName;
                    setStatus('Unsaved changes');
                }

                function tryLoad() {
                    if (window.AI2EditorCore && typeof AI2EditorCore.loadFileContent === 'function') {
                        AI2EditorCore.loadFileContent(filePath).then(function(data) {
                            if (data && data.content !== undefined) {
                                if (window.ace && ace.edit) {
                                    editor = ace.edit('ace-editor');
                                    editor.setValue(data.content, -1);
                                    editor.clearSelection();
                                    editor.session.on('change', function() {
                                        if (!hasChanges) updateDirtyState();
                                    });
                                } else {
                                    var el = document.getElementById('ace-editor');
                                    if (el) el.textContent = data.content;
                                }
                                if (tabLabel) tabLabel.textContent = fileName;
                                setStatus('Loaded');
                                // Make Save available now that a file is loaded
                                // (it also appears on edit via updateDirtyState).
                                if (saveBtn) saveBtn.style.display = 'inline-block';
                            }
                        }).catch(function(err) {
                            console.error('[AI2] Failed to load file:', err);
                            setStatus('Error loading: ' + filePath, true);
                        });
                    } else {
                        setTimeout(tryLoad, 300);
                    }
                }

                // Save button handler
                if (saveBtn) {
                    saveBtn.addEventListener('click', function() {
                        if (!editor) return;
                        var content = editor.getValue();
                        saveBtn.disabled = true;
                        saveBtn.textContent = 'Saving...';
                        setStatus('Saving...');

                        fetch('/ai2/save_file', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ path: filePath, content: content })
                        })
                        .then(function(res) { return res.json(); })
                        .then(function(data) {
                            saveBtn.disabled = false;
                            saveBtn.textContent = 'Save';
                            if (data.success) {
                                hasChanges = false;
                                saveBtn.style.display = 'none';
                                if (tabLabel) tabLabel.textContent = fileName;
                                setStatus('Saved');
                            } else {
                                var msg = 'Save failed: ' + (data.error || 'unknown error');
                                if (data.detail) {
                                    msg += ' — ' + data.detail.replace(/\n/g, ' | ');
                                }
                                setStatus(msg, true);
                            }
                        })
                        .catch(function(err) {
                            saveBtn.disabled = false;
                            saveBtn.textContent = 'Save';
                            setStatus('Save error: ' + err.message, true);
                        });
                    });
                }

                tryLoad();
            });
        </script>
    [% END %]
</body>
</html>

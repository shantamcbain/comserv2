[%# ai2/right_dock_terminal.tt — PyCharm-style terminal dock (no_wrapper fragment) %]
<div style="height:100%;display:flex;flex-direction:column;background:#2b2b2b;color:#ddd;font-size:13px;">
    <div style="padding:8px 12px;background:#313335;border-bottom:1px solid #444;display:flex;align-items:center;justify-content:space-between;">
        <span style="font-weight:500;">Terminal</span>
        <button type="button"
                onclick="document.getElementById('aew-right-dock').innerHTML='';document.body.classList.remove('aew-right-open')"
                style="background:none;border:none;color:#888;font-size:1.2em;cursor:pointer;"
                title="Close">✕</button>
    </div>
    <div style="flex:1;overflow:auto;padding:10px 12px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;line-height:1.45;background:#1e1f22;color:#c8e6c9;">
        <div id="ai2-right-dock-terminal-status" style="color:#888;margin-bottom:8px;">
            Status: placeholder — interactive shell wiring comes later.
        </div>
        <div id="ai2-right-dock-terminal-out" style="white-space:pre-wrap;">
$ # AI2 dock terminal
$ echo "Ready."
Ready.
$ _
        </div>
    </div>
    <div style="padding:6px 10px;border-top:1px solid #444;background:#313335;color:#888;font-size:11px;">
        Local shell integration not connected yet.
    </div>
</div>

[%# ai2/right_dock_settings.tt — PyCharm-style settings dock (no_wrapper fragment) %]
<div style="height:100%;display:flex;flex-direction:column;background:#2b2b2b;color:#ddd;font-size:13px;">
    <div style="padding:8px 12px;background:#313335;border-bottom:1px solid #444;display:flex;align-items:center;justify-content:space-between;">
        <span style="font-weight:500;">Settings</span>
        <button type="button"
                onclick="document.getElementById('aew-right-dock').innerHTML='';document.body.classList.remove('aew-right-open')"
                style="background:none;border:none;color:#888;font-size:1.2em;cursor:pointer;"
                title="Close">✕</button>
    </div>
    <div style="flex:1;overflow:auto;padding:12px;">
        <h4 style="margin:0 0 10px 0;font-size:12px;color:#aaa;">EDITOR SETTINGS</h4>
        <label style="display:block;margin:6px 0;font-size:12px;">Theme:
            <select id="theme-select" style="display:block;width:100%;margin-top:4px;background:#313335;color:#ddd;border:1px solid #555;padding:4px 6px;border-radius:3px;">
                <option value="dark" selected>Dark (PyCharm)</option>
                <option value="light">Light</option>
            </select>
        </label>
        <label style="display:block;margin:10px 0 6px;font-size:12px;">Font Size:
            <select id="font-size" style="display:block;width:100%;margin-top:4px;background:#313335;color:#ddd;border:1px solid #555;padding:4px 6px;border-radius:3px;">
                <option value="12">12px</option>
                <option value="13">13px</option>
                <option value="14" selected>14px</option>
                <option value="15">15px</option>
                <option value="16">16px</option>
                <option value="18">18px</option>
            </select>
        </label>
        <p style="margin:14px 0 0;font-size:11px;color:#888;">
            Mirrors the in-editor Settings panel fields (<code>theme-select</code>, <code>font-size</code>).
        </p>
    </div>
</div>

[% PageVersion = 'remotedb/change_password.tt,v 0.01 2026/08/27 hermes-agent Exp shanta ' %]
[% IF c.session.debug_mode == 1 %][% PageVersion %][% END %]

<div class="app-container">

<div class="page-header">
    <h1>Change database password</h1>
    <div class="form-actions">
        <a href="[% c.uri_for('/remotedb/detail') %]/[% conn_name | uri %]" class="btn btn-secondary">Back to details</a>
        <a href="[% c.uri_for('/remotedb') %]" class="btn btn-secondary">All servers</a>
    </div>
</div>

[% IF success_msg %]<div class="success-message">[% success_msg | html %]</div>[% END %]
[% IF error_msg %]<div class="error-message">[% error_msg | html %]</div>[% END %]

<div class="content-container">
<div class="content-primary">
<div class="form-container">

<p class="page-subtitle">Slot <code>[% conn_name | html %]</code>
   — [% conn.config.username | html %]@[% conn.config.host | html %]:[% conn.config.port | html %]
   / [% conn.config.database | html %]</p>

<p class="doc-warning">The password is never shown and is not written to logs.
This does not create <code>db_config.json.backup.*</code> files (those leaked into git).</p>

[% IF sibling_slots.size > 0 %]
<p>Other slots currently store the same password:
[% FOREACH s IN sibling_slots %]<code>[% s | html %]</code>[% UNLESS loop.last %], [% END %][% END %].</p>
[% END %]

<form method="post" action="[% c.uri_for('/remotedb/change_password') %]/[% conn_name | uri %]" class="app-form" autocomplete="off">

    <div class="form-section">
        <h3>Passwords</h3>
        <div class="form-row">
            <div class="form-field">
                <label for="current_password">Current password *</label>
                <input type="password" id="current_password" name="current_password" class="form-input" required autocomplete="current-password">
            </div>
        </div>
        <div class="form-row">
            <div class="form-field">
                <label for="new_password">New password * (min 12 characters)</label>
                <input type="password" id="new_password" name="new_password" class="form-input" required minlength="12" autocomplete="new-password">
            </div>
        </div>
        <div class="form-row">
            <div class="form-field">
                <label for="new_password_confirm">Confirm new password *</label>
                <input type="password" id="new_password_confirm" name="new_password_confirm" class="form-input" required minlength="12" autocomplete="new-password">
            </div>
        </div>
    </div>

    <div class="form-section">
        <h3>Scope</h3>
        <div class="form-row">
            <div class="form-field">
                <label>
                    <input type="checkbox" name="apply_siblings" value="1" checked>
                    Also update other slots that currently store the same password
                </label>
            </div>
        </div>
        <div class="form-row">
            <div class="form-field">
                <label>
                    <input type="checkbox" name="rotate_server" value="1">
                    Also change the MariaDB/MySQL user (<code>ALTER USER USER()</code>)
                </label>
                <small>Leave unchecked to update stored config only. Checking this will break other running workers until they pick up the new password.</small>
            </div>
        </div>
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Change password</button>
        <a href="[% c.uri_for('/remotedb/detail') %]/[% conn_name | uri %]" class="btn btn-secondary">Cancel</a>
    </div>
</form>

</div>
</div>
</div>
</div>

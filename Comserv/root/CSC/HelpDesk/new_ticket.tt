[% META title = 'Create New Support Ticket' %]

[% PageVersion = 'CSC/HelpDesk/new_ticket.tt,v 0.02 2026/03/26 shanta Exp shanta ' %]


[% IF c.session.debug_mode == 1 %]

 <br>[% PageVersion %]</br>

 [% IF debug_msg %]<div class="debug-message">[% debug_msg %]</div>[% END %]

<meta name="viewport" content="width=device-width, initial-scale=1">

[% END %]


<script>

    window.HELPDESK_PRESCREEN = true;

    window.HELPDESK_PRESCREEN_PAGE_PATH  = '/HelpDesk/ticket/new';

    window.HELPDESK_PRESCREEN_PAGE_TITLE = 'Support Ticket Pre-screening';

</script>


<div class="helpdesk-container">

    <h1>Create New Support Ticket</h1>


    <div id="hd-prescreen-banner" class="hd-prescreen-banner">

        <div class="hd-prescreen-icon">🤖</div>

        <div class="hd-prescreen-text">

            <strong>Get instant help from our AI assistant</strong><br>

            Describe your issue in the chat below — the AI may be able to solve it right away

            without needing to submit a ticket.

        </div>

        <button type="button" id="hd-open-ai-btn" class="btn btn-ai">

            💬 Ask AI Assistant

        </button>

    </div>


    <div class="hd-divider">

        <span>— or —</span>

    </div>


    <div id="hd-ticket-toggle" class="hd-ticket-toggle">

        <button type="button" id="hd-show-form-btn" class="btn btn-secondary">

            📝 Skip AI — Submit Ticket Directly

        </button>

    </div>


    <div id="ticket-form-section" class="ticket-form" style="display:[% IF error_msg %]block[% ELSE %]none[% END %];">
[%# Validation feedback: banner + field highlight + focus (HelpDesk forms). %]
[% IF error_msg %]
<div class="hd-alert-error hd-form-error" role="alert" id="hd-form-error"
     style="border:2px solid #c62828;background:#fdecea;color:#b71c1c;padding:10px 14px;border-radius:6px;margin:0 0 12px;">
    <strong>Your request was not sent.</strong> [% error_msg | html %]
</div>
[% END %]
[% IF success_msg %]
<div class="hd-alert-success" role="status" style="border:2px solid #2e7d32;background:#edf7ed;color:#1b5e20;padding:10px 14px;border-radius:6px;margin:0 0 12px;">[% success_msg | html %]</div>
[% END %]


        <h2>New Support Ticket</h2>

        <form method="post" action="[% c.uri_for('/HelpDesk/ticket/submit') %]">

            <!-- Honeypot field - bots fill this, humans don't see it -->

            <div class="form-group honeypot-field" style="display:none; position:absolute; left:-9999px;">

                <label for="website">Website</label>

                <input type="text" id="website" name="website" value="" tabindex="-1" autocomplete="off">

            </div>

            [%# Math challenge for guests. Never render blank "What is + ?". %]
            <input type="hidden" name="hd_ft" value="[% hd_fill_token | html %]">
            [%# CSC-20260928-9565: guests must leave a contact email so staff can reply. %]
            [% IF is_public_guest || !c.session.user_id %]
            <div class="form-group">
                <label for="guest_name">Your Name</label>
                <input type="text" id="guest_name" name="guest_name" class="form-control" maxlength="100"
                       value="[% (guest_name || c.req.params.guest_name) | html %]" autocomplete="name" required>
            </div>
            <div class="form-group">
                <label for="email">Your Email (so we can reply)</label>
                <input type="email" id="email" name="email" class="form-control" maxlength="255"
                       value="[% (guest_email_in || c.req.params.email) | html %]" autocomplete="email" required>
            </div>
            [% END %]
            [% IF turnstile_site_key %]
            <div class="form-group turnstile-challenge">
                <div class="cf-turnstile" data-sitekey="[% turnstile_site_key | html %]"></div>
                <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
            </div>
            [% ELSE %]
            [% IF is_public_guest || !c.session.user_id %]
            <div class="form-group math-challenge">
                [% IF math_a && math_b %]
                <label for="math_challenge_ans">Security Question: What is [% math_a %] + [% math_b %]?</label>
                <input type="number" id="math_challenge_ans" name="math_challenge_ans"
                       class="form-control" required min="4" max="18" step="1"
                       inputmode="numeric" autocomplete="off"
                       placeholder="Enter the sum">
                [% ELSIF num1 && num2 %]
                <label for="math_challenge_ans">Security Question: What is [% num1 %] + [% num2 %]?</label>

                <input type="number" id="math_challenge_ans" name="math_challenge_ans"
                       class="form-control" required min="4" max="18" step="1"
                       inputmode="numeric" autocomplete="off"
                       placeholder="Enter the sum">
                [% ELSE %]
                <p class="error">Security check could not be loaded. Please <a href="[% c.uri_for('/HelpDesk/ticket/new') %]">reload this page</a> before submitting.</p>
                [% END %]
            </div>
            [% END %]
            [% END %]


            <div class="form-group">

                <label for="subject">Subject:</label>

                <input type="text" id="subject" name="subject" value="[% c.req.params.subject | html %]" class="form-control" required

                       placeholder="Brief description of your issue">

            </div>


            <div class="form-group">

                <label for="category">Category:</label>

                <select id="category" name="category" class="form-control" required>

                    <option value="">-- Select a Category --</option>

                    <option value="technical"[% IF c.req.params.category %][% IF c.req.params.category == 'technical' %] selected[% END %][% ELSE %][% END %]>Technical Issue</option>

                    <option value="billing"[% IF c.req.params.category %][% IF c.req.params.category == 'billing' %] selected[% END %][% ELSE %][% END %]>Billing Question</option>

                    <option value="account"[% IF c.req.params.category %][% IF c.req.params.category == 'account' %] selected[% END %][% ELSE %][% END %]>Account Management</option>

                    <option value="feature"[% IF c.req.params.category %][% IF c.req.params.category == 'feature' %] selected[% END %][% ELSE %][% END %]>Feature Request</option>

                    <option value="other"[% IF c.req.params.category %][% IF c.req.params.category == 'other' %] selected[% END %][% ELSE %][% END %]>Other</option>

                </select>

            </div>


            <div class="form-group">

                <label for="priority">Priority:</label>

                <select id="priority" name="priority" class="form-control" required>

                    <option value="">-- Select Priority --</option>

                    <option value="low"[% IF c.req.params.priority %][% IF c.req.params.priority == 'low' %] selected[% END %][% ELSE %][% END %]>Low</option>
                    <option value="medium"[% IF c.req.params.priority %][% IF c.req.params.priority == 'medium' %] selected[% END %][% ELSE %] selected[% END %]>Medium</option>
                    [%# Guests: no high/critical in UI (server also clamps). Staff see full scale. %]
                    [% UNLESS is_public_guest || !c.session.user_id %]
                    <option value="high"[% IF c.req.params.priority %][% IF c.req.params.priority == 'high' %] selected[% END %][% ELSE %][% END %]>High</option>

                    <option value="critical"[% IF c.req.params.priority %][% IF c.req.params.priority == 'critical' %] selected[% END %][% ELSE %][% END %]>Critical</option>
                    [% END %]
                </select>

            </div>


            <div class="form-group">

                <label for="description">Description:</label>

                <textarea id="description" name="description" class="form-control" rows="6" required

                          placeholder="Provide as much detail as possible about your issue...">[% c.req.params.description | html %]</textarea>

            </div>


            <div class="form-group">

                <label for="attachment">Attachment (optional):</label>

                <input type="file" id="attachment" name="attachment" class="form-control-file">

            </div>


            <div class="form-actions">

                <button type="submit" class="btn btn-primary">Submit Ticket</button>

                <a href="[% c.uri_for('/HelpDesk') %]" class="btn btn-secondary">Cancel</a>

            </div>

        </form>

    </div>

</div>


<script>

(function() {

    var openBtn  = document.getElementById('hd-open-ai-btn');

    var showBtn  = document.getElementById('hd-show-form-btn');

    var formSec  = document.getElementById('ticket-form-section');


    if (openBtn) {

        openBtn.addEventListener('click', function() {

            if (typeof window.openHelpDeskChat === 'function') {

                window.openHelpDeskChat();

            } else {

                var toggleBtn = document.querySelector('.chat-button');

                if (toggleBtn) toggleBtn.click();

            }

            openBtn.textContent = '💬 AI Chat is open below ↘';

            openBtn.disabled = true;

        });

    }


    if (showBtn) {

        showBtn.addEventListener('click', function() {

            formSec.style.display = 'block';

            formSec.scrollIntoView({ behavior: 'smooth', block: 'start' });

            showBtn.style.display = 'none';

            var stillNeedLink = document.getElementById('hd-still-need-link');

            if (stillNeedLink) stillNeedLink.style.display = 'none';

        });

    }


    window.showHelpDeskTicketForm = function() {

        formSec.style.display = 'block';

        formSec.scrollIntoView({ behavior: 'smooth', block: 'start' });

        if (showBtn) showBtn.style.display = 'none';

    };


    (function() {

        var qp = new URLSearchParams(window.location.search);

        if (qp.get('from_chat')) {

            var subjectEl = document.getElementById('subject');

            var descEl    = document.getElementById('description');

            var catEl     = document.getElementById('category');

            var priEl     = document.getElementById('priority');

            if (subjectEl && qp.get('subject')) subjectEl.value = qp.get('subject');

            if (descEl    && qp.get('description')) descEl.value = qp.get('description');

            if (catEl     && qp.get('category')) {

                var opt = catEl.querySelector('option[value="' + qp.get('category') + '"]');

                if (!opt) {

                    opt = document.createElement('option');

                    opt.value = qp.get('category');

                    opt.textContent = qp.get('category').charAt(0).toUpperCase() + qp.get('category').slice(1);

                    catEl.appendChild(opt);

                }

                catEl.value = qp.get('category');

            }

            if (priEl && qp.get('priority')) priEl.value = qp.get('priority');

            formSec.style.display = 'block';

            if (showBtn) showBtn.style.display = 'none';

            formSec.scrollIntoView({ behavior: 'smooth', block: 'start' });

        }

    })();

})();

</script>


<style>

    .helpdesk-container {

        max-width: 800px;

        margin: 0 auto;

        padding: 20px;

    }


    .hd-prescreen-banner {

        display: flex;

        align-items: center;

        gap: 16px;

        background-color: var(--secondary-color, #f0f8ff);

        border: 1px solid var(--border-color, #cce0ff);

        border-left: 4px solid var(--nav-bg, #ccffff);

        border-radius: 6px;

        padding: 16px 20px;

        margin-bottom: 20px;

    }


    .hd-prescreen-icon {

        font-size: 2em;

        flex-shrink: 0;

    }


    .hd-prescreen-text {

        flex: 1;

        font-size: 0.95em;

        color: var(--text-color, #333);

        line-height: 1.5;

    }


    .hd-divider {

        text-align: center;

        color: var(--text-muted-color, #888);

        margin: 16px 0;

        font-size: 0.9em;

    }


    .hd-ticket-toggle {

        text-align: center;

        margin-bottom: 24px;

    }


    .ticket-form {

        background-color: var(--secondary-color, #f8f9fa);

        padding: 24px;

        border-radius: 6px;

        border: 1px solid var(--border-color, #ddd);

        margin-top: 10px;

    }


    .ticket-form h2 {

        margin-top: 0;

        margin-bottom: 20px;

        font-size: 1.2em;

        color: var(--text-color, #333);

    }


    .form-group {

        margin-bottom: 20px;

    }


    .form-control {

        width: 100%;

        padding: 8px;

        border: 1px solid var(--button-border, #ced4da);

        border-radius: 4px;

        background-color: var(--background-color, #fff);

        color: var(--text-color, #333);

        font-family: inherit;

        box-sizing: border-box;

    }


    .form-control-file {

        padding: 8px 0;

    }


    label {

        display: block;

        margin-bottom: 5px;

        font-weight: bold;

        color: var(--text-color, #333);

    }


    .form-actions {

        margin-top: 30px;

    }


    .btn {

        display: inline-block;

        padding: 8px 16px;

        text-decoration: none;

        border-radius: 4px;

        margin-right: 10px;

        cursor: pointer;

        font-family: inherit;

        font-size: 0.95em;

        border: 1px solid transparent;

    }


    .btn-ai {

        background-color: var(--nav-bg, #ccffff);

        color: var(--nav-text, var(--text-color, #000));

        border-color: var(--border-color, #aaa);

        white-space: nowrap;

    }

    .btn-ai:hover:not(:disabled) { opacity: 0.85; }

    .btn-ai:disabled { opacity: 0.5; cursor: default; }


    .btn-primary {

        background-color: var(--button-bg, #f2f2f2);

        color: var(--button-text, #000);

        border-color: var(--button-border, #ccc);

    }

    .btn-primary:hover { background-color: var(--button-hover-bg, #e0e0e0); }


    .btn-secondary {

        background-color: var(--secondary-color, #e9ecef);

        color: var(--text-color, #333);

        border-color: var(--button-border, #ccc);

    }

    .btn-secondary:hover { opacity: 0.85; }


    .debug-message {

        background-color: #f8d7da;

        color: #721c24;

        padding: 10px;

        margin-bottom: 20px;

        border-radius: 4px;

    }

</style>

[% IF error_msg %]
<style>.hd-field-error{border:2px solid #c62828 !important;}.hd-field-msg{color:#b71c1c;font-size:.9em;display:block;margin-top:3px;}</style>
<script>
(function(){
  var f = "[% hd_error_field | html %]", msg = document.getElementById('hd-form-error');
  var el = f && f !== 'form' && f !== 'turnstile' ? document.getElementById(f) : null;
  if (el) {
    el.classList.add('hd-field-error');
    var s = document.createElement('span'); s.className = 'hd-field-msg';
    s.textContent = msg ? msg.textContent.replace('Your request was not sent.','').trim() : '';
    el.insertAdjacentElement('afterend', s);
    try { el.focus(); } catch(e) {}
  } else if (msg) { msg.scrollIntoView(); }
})();
</script>
[% END %]

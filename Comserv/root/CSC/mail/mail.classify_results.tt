[% META title = 'Classification Results' %]
[% IF debug_mode == 1 %][% PageVersion = '/CSC/mail/mail.classify_results.tt,v 0.01 2026/09/12 shanta Exp shanta ' %][% END %]

<div class="classification-results">
    <h1>Classification Results</h1>
    
    [% IF classification_result %]
        <div class="alert alert-success">
            Classification complete. <strong>[% classification_result.metadata.total_messages_scanned %]</strong> messages scanned.
        </div>
        
        <div class="category-summary">
            [% FOREACH cat IN classification_result.categories.keys %]
                <div class="category-badge" style="background-color: var(--primary-color);">
                    [% classification_result.categories.$cat.label %]: [% classification_result.categories.$cat.count %]
                </div>
            [% END %]
        </div>
    [% ELSE %]
        <div class="alert alert-warning">No results.</div>
    [% END %]
    
    <p><a href="[% c.uri_for('/mail/invoice/api') %]">View Classified Invoices</a></p>
</div>

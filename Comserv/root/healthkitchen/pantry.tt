[% META
   title = "Health Kitchen pantry"
   description = "Personal pantry overlay; optional link to site inventory SKUs"
   roles = "user,admin"
   TemplateType = "Application"
   category = "HealthKitchen"
   page_version = "0.02"
   last_updated = "2026-10-18"
%]
[% PageVersion = 'healthkitchen/pantry.tt,v 0.01 2026/09/23 hermes-agent Exp shanta ' %]
[% IF c.session.debug_mode == 1 %][% PageVersion %][% END %]

<div class="app-container">
    [% INCLUDE 'healthkitchen/_disclaimer.tt' %]
    <div class="page-header">
        <h1>Pantry</h1>
        <p>
            <a href="[% c.uri_for('/healthkitchen') %]">Health Kitchen</a>
            ·
            <a href="[% c.uri_for('/healthkitchen/recipes') %]">Recipes</a>
            ·
            <a href="[% c.uri_for('/healthkitchen/symptoms') %]">Symptoms</a>
        </p>
    </div>

    [% IF c.flash.success_msg %]<div class="alert alert-success">[% c.flash.success_msg | html %]</div>[% END %]
    [% IF c.flash.error_msg %]<div class="alert alert-danger">[% c.flash.error_msg | html %]</div>[% END %]

    [% IF hk_has_inventory %]
        <p>This site has inventory. The list below is <strong>inventory stock</strong> (food/consumable SKUs). Recipe “made” deducts those SKUs so the purchase short list can reorder. The form adds a personal overlay row if you need something not yet in inventory.</p>
    [% ELSE %]
        <p>No inventory package on this site. Add foods by name and quantity. Recipe “made” deducts these rows only.</p>
    [% END %]

    [% IF !hk_pantry_ready %]
        <div class="alert alert-warning">Create table <code>HealthKitchen::UserPantryQty</code> via Schema Compare first.</div>
    [% ELSE %]
        <form method="post" action="[% c.uri_for('/healthkitchen/pantry') %]" class="content-section">
            <p>
                <label>Name <input type="text" name="name" required /></label>
                <label>Qty <input type="number" name="qty" step="0.001" value="0" /></label>
                <label>Unit <input type="text" name="unit" value="each" /></label>
                <label>Reorder at <input type="number" name="reorder_point" step="0.001" value="0" /></label>
                [% IF hk_has_inventory %]
                    <label>Inventory item id (optional) <input type="number" name="inventory_item_id" /></label>
                [% END %]
                <button type="submit" class="btn btn-primary">Save pantry item</button>
            </p>
        </form>

        [% IF hk_link_ready %]
        <form method="get" action="[% c.uri_for('/healthkitchen/pantry') %]" class="content-section">
            <h2>Find ENCY entry to link</h2>
            <label>Type
                <select name="ency_type">
                    [% FOREACH t IN ['herb','animal','constituent'] %]
                        <option value="[% t %]" [% IF hk_ency_type == t %]selected[% END %]>[% t %]</option>
                    [% END %]
                </select>
            </label>
            <label>Name <input type="text" name="ency_q" value="[% hk_ency_q | html %]" placeholder="e.g. Oregano, carvacrol, Beef" /></label>
            <button type="submit" class="btn btn-secondary">Search</button>
            [% IF hk_ency_q.defined %]
                [% IF hk_ency_results.size %]
                    <p>[% hk_ency_results.size %] match(es); choose one in an item’s “Link” box below.</p>
                [% ELSE %]
                    <p class="doc-muted">No [% hk_ency_type | html %] matches “[% hk_ency_q | html %]”.</p>
                [% END %]
            [% END %]
        </form>
        [% ELSE %]
            <div class="alert alert-warning">Create tables <code>HealthKitchen::InventoryEncyLink</code> and <code>HealthKitchen::ItemProduct</code> via Schema Compare to link herbs/animals/constituents and store brand/UPC/size.</div>
        [% END %]

        [% IF hk_pantry && hk_pantry.size %]
            <table class="table">
                <tr><th>Name</th><th>Qty</th><th>Unit</th><th>Reorder</th><th>Source</th><th>SKU</th><th>ENCY</th><th>Product</th></tr>
                [% FOREACH p IN hk_pantry %]
                    <tr>
                        <td>[% p.name | html %]</td>
                        <td>[% p.qty | html %]</td>
                        <td>[% p.unit | html %]</td>
                        <td>[% p.reorder_point | html %]</td>
                        <td>[% p.via | html %]</td>
                        <td>[% p.sku || p.inventory_item_id || '—' | html %]</td>
                        <td>
                            [% IF !hk_link_ready %][% IF p.herb_id %]<a href="[% c.uri_for('/ENCY/Herb') %]/[% p.herb_id %]">herb #[% p.herb_id %]</a>[% END %][% IF p.animal_id %] animal #[% p.animal_id %][% END %][% END %]
                            [% FOREACH l IN p.ency_links %]
                                <div>
                                    [% l.type | html %]: <a href="[% c.uri_for(l.path) %]">[% l.label | html %]</a>
                                    <form method="post" action="[% c.uri_for('/healthkitchen/pantry_link') %]" style="display:inline">
                                        <input type="hidden" name="hk_action" value="unlink" />
                                        <input type="hidden" name="link_id" value="[% l.id %]" />
                                        <button type="submit" class="btn btn-sm btn-secondary" title="Remove link">×</button>
                                    </form>
                                </div>
                            [% END %]
                            [% IF hk_link_ready && p.item_key_id %]
                                <form method="post" action="[% c.uri_for('/healthkitchen/pantry_link') %]">
                                    <input type="hidden" name="hk_action" value="link" />
                                    <input type="hidden" name="item_kind" value="[% p.item_kind %]" />
                                    <input type="hidden" name="item_id" value="[% p.item_key_id %]" />
                                    <input type="hidden" name="entity_type" value="[% hk_ency_type | html %]" />
                                    [% IF hk_ency_results.size %]
                                        <select name="entity_id">
                                            [% FOREACH e IN hk_ency_results %]<option value="[% e.id %]">[% e.label | html %]</option>[% END %]
                                        </select>
                                        <button type="submit" class="btn btn-sm btn-primary">Link [% hk_ency_type | html %]</button>
                                    [% ELSE %]
                                        <span class="doc-muted">Search above to link.</span>
                                    [% END %]
                                </form>
                            [% END %]
                        </td>
                        <td>
                            [% IF p.product.brand %][% p.product.brand | html %]<br />[% END %]
                            [% IF p.product.upc %]UPC [% p.product.upc | html %]<br />[% END %]
                            [% IF p.product.size_value %][% p.product.size_value | html %] [% p.product.size_unit | html %][% END %]
                            [% IF hk_product_ready && p.item_key_id %]
                                <details><summary>Edit</summary>
                                <form method="post" action="[% c.uri_for('/healthkitchen/pantry_link') %]">
                                    <input type="hidden" name="hk_action" value="product" />
                                    <input type="hidden" name="item_kind" value="[% p.item_kind %]" />
                                    <input type="hidden" name="item_id" value="[% p.item_key_id %]" />
                                    <label>Brand <input type="text" name="brand" value="[% p.product.brand | html %]" /></label>
                                    <label>UPC <input type="text" name="upc" value="[% p.product.upc | html %]" placeholder="8 36676 00001 9" /></label>
                                    <label>Size <input type="text" name="size" value="[% IF p.product.size_value %][% p.product.size_value %] [% p.product.size_unit %][% END %]" placeholder="10 ml" /></label>
                                    <button type="submit" class="btn btn-sm btn-primary">Save</button>
                                </form>
                                </details>
                            [% END %]
                        </td>
                    </tr>
                [% END %]
            </table>
        [% ELSE %]
            <p class="doc-muted">Pantry is empty.</p>
        [% END %]
    [% END %]
</div>

[% META
   title = "Health Kitchen"
   description = "Personal pantry, ENCY-linked foods, and wellness menus from active symptoms"
   roles = "user,admin"
   TemplateType = "Application"
   category = "HealthKitchen"
   page_version = "0.03"
   last_updated = "2026-10-29"
%]
[% PageVersion = 'healthkitchen/index.tt,v 0.03 2026/10/29 hermes-agent Exp shanta - embed the day view filtered to the kitchen schedule' %]
[% IF c.session.debug_mode == 1 %][% PageVersion %][% END %]

<div class="app-container">
    [% INCLUDE 'healthkitchen/_disclaimer.tt' %]
    <div class="page-header">
        <h1>Health Kitchen</h1>
        <p class="doc-muted">Personal wellness planner — not diagnosis or treatment. Menus use your pantry and ENCY knowledge only.</p>
    </div>

    [% IF c.flash.success_msg %]<div class="alert alert-success">[% c.flash.success_msg | html %]</div>[% END %]
    [% IF c.flash.error_msg %]<div class="alert alert-danger">[% c.flash.error_msg | html %]</div>[% END %]

    <p>
        <a href="[% c.uri_for('/healthkitchen/pantry') %]" class="btn btn-primary">Pantry</a>
        <a href="[% c.uri_for('/healthkitchen/recipes') %]" class="btn btn-primary">Recipes</a>
        <a href="[% c.uri_for('/healthkitchen/mealplans') %]" class="btn btn-primary">Meal plans</a>
        <a href="[% c.uri_for('/healthkitchen/nutrition') %]" class="btn btn-primary">Nutrition</a>
        <a href="[% c.uri_for('/healthkitchen/history') %]" class="btn btn-secondary">Health history</a>
        <a href="[% c.uri_for('/healthkitchen/symptoms') %]" class="btn btn-primary">Symptoms</a>
        <a href="[% c.uri_for('/ENCY') %]" class="btn btn-secondary">ENCY</a>
    </p>

    <div class="content-section">
        <h2>Today [% IF hk_today.plan_date %]<span class="doc-muted">[% hk_today.plan_date | html %]</span>[% END %]</h2>
        <iframe title="Today" src="[% c.uri_for('/todo/day') %][% IF hk_today.plan_date %]/[% hk_today.plan_date %][% END %]?embed=1&amp;filter=schedule" style="width:100%;height:72vh;border:1px solid var(--border-color);border-radius:4px;background:var(--bg-color);"></iframe>
        [% IF !hk_today.ready %]
            <div class="alert alert-warning">Health plan tables are not on this database yet. Admin: Schema Compare for <code>HealthKitchen::UserHealthPlan</code>.</div>
        [% ELSIF hk_today.plan %]
            <p class="doc-muted">[% hk_today.plan.trust_summary | html %]
                <a href="[% c.uri_for('/healthkitchen/plan') %]/[% hk_today.plan.id %]">Open plan</a>
            </p>
            <h3>Menu</h3>
            [% IF hk_today.plan.slots.size %]
                <ul>
                    [% FOREACH s IN hk_today.plan.slots %]
                        <li><strong>[% s.meal_slot | html %]</strong> &mdash; [% s.free_text | html %]</li>
                    [% END %]
                </ul>
            [% ELSE %]
                <p class="doc-muted">No in-pantry match for the active symptoms. Off-pantry items are not added to the menu.</p>
            [% END %]
            <h3>Activities</h3>
            [% INCLUDE 'healthkitchen/_activities.tt' hk_plan = hk_today.plan %]
            <form method="post" action="[% c.uri_for('/healthkitchen') %]">
                <input type="hidden" name="hk_action" value="build_today" />
                <button type="submit" class="btn btn-secondary">Rebuild from pantry</button>
            </form>
        [% ELSE %]
            <p class="doc-muted">No menu saved yet. Build a general menu now. Symptoms and chart data tighten it later. They are not required to start.</p>
            <form method="post" action="[% c.uri_for('/healthkitchen') %]">
                <input type="hidden" name="hk_action" value="build_today" />
                <button type="submit" class="btn btn-primary">Build today's menu</button>
            </form>
        [% END %]
    </div>

    <div class="content-section">
        [% IF hk_has_inventory %]
            <p><strong>Mode:</strong> site inventory is on. Marking a recipe as made deducts SKU stock so the inventory short list can reorder. Accounting invoices are not required.</p>
        [% ELSE %]
            <p><strong>Mode:</strong> personal pantry only (no inventory/accounting package). Marking a recipe as made deducts your pantry rows. The need-buy list below is yours — not AP invoices.</p>
        [% END %]

        [% IF !hk_pantry_ready || !hk_recipe_ready %]
            <div class="alert alert-warning">
                Pantry/recipe tables are not on this database yet. Admin: Schema Compare → Create Table for
                <code>HealthKitchen::UserPantryQty</code>,
                <code>HealthKitchen::InventoryEncyMap</code>,
                and (if missing) <code>Recipe</code> / <code>RecipeLine</code>.
            </div>
        [% END %]

        <h2>Need to buy</h2>
        [% IF hk_short && hk_short.size %]
            <ul>
                [% FOREACH n IN hk_short %]
                    <li>[% n.name | html %]
                        [% IF n.qty %] — [% n.qty | html %][% IF n.unit %] [% n.unit | html %][% END %][% END %]
                        <span class="doc-muted">([% n.via | html %])</span>
                    </li>
                [% END %]
            </ul>
        [% ELSE %]
            <p class="doc-muted">Nothing flagged yet.</p>
        [% END %]

        <h2>Your recipes</h2>
        [% IF hk_recipes && hk_recipes.size %]
            <ul>
                [% FOREACH r IN hk_recipes %]
                    <li>[% r.name | html %]</li>
                [% END %]
            </ul>
            [% IF hk_recipe_n > 5 %]
                <p class="doc-muted">[% hk_recipe_n %] recipes. <a href="[% c.uri_for('/healthkitchen/recipes') %]">See all</a>.</p>
            [% END %]
        [% ELSE %]
            <p class="doc-muted">No food recipes yet. Open Recipes to seed the morning turmeric coffee.</p>
        [% END %]

        <form method="post" action="[% c.uri_for('/membership/disable_addon') %]">
            <input type="hidden" name="service_name" value="healthkitchen" />
            <button type="submit" class="btn btn-sm btn-secondary">Remove Health Kitchen from my account</button>
        </form>
    </div>
</div>

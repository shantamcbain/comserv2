use strict; use warnings; use Test::More;
use Comserv::Util::AI::OpenRouterPrices;
use Comserv::Util::AI::HermesOverrunGuard;
my $P = { 'tencent/hy4-preview' => [1e-6, 2e-6, 1e-7], 'x/y' => [1e-6, 1e-6, undef] };
is(Comserv::Util::AI::OpenRouterPrices::usd_for($P, 'a/b:free', 1e6, 1e6, 0), 0, ':free is $0');
ok(!defined Comserv::Util::AI::OpenRouterPrices::usd_for($P, 'nope/x', 1, 1, 0), 'unknown undef');
is(sprintf('%.4f', Comserv::Util::AI::OpenRouterPrices::usd_for($P, 'tencent/hy4-preview', 1_000_000, 100_000, 400_000)), '0.8400', 'cache priced at cache_read');
is(sprintf('%.2f', Comserv::Util::AI::OpenRouterPrices::usd_for($P, 'openrouter/x/y', 1e6, 0, 5e5)), '1.00', 'no cache_read -> prompt rate');
my $G = 'Comserv::Util::AI::HermesOverrunGuard';
my $sg_ok  = { mode => 'openrouter', daily_budget => { over => 0, switch_off => 0, week_off => 0, remaining_today_pct => '3.0' } };
my $sg_out = { mode => 'openrouter', daily_budget => { over => 1, remaining_today_pct => '0.0' } };
ok($G->can('supergrok_budget_left')->($sg_ok), 'budget left even when mode=openrouter');
ok(!$G->can('supergrok_budget_left')->($sg_out), 'over -> no budget');
ok(!$G->can('supergrok_budget_left')->({ %$sg_ok, locked => 1 }), 'locked -> no');
my @o = $G->can('candidate_order')->('caps', undef, $sg_ok);
is($o[0]{default}, 'grok-4.7', 'caps + budget: grok-4.7 first');
@o = $G->can('candidate_order')->('caps', undef, $sg_out);
like($o[0]{default}, qr/:free/, 'caps no budget: free first (old behaviour)');
@o = $G->can('candidate_order')->('thrash', undef, $sg_ok);
is($o[0]{default}, 'grok-build-0.1', 'thrash unchanged');
ok('tencent/hy4-preview' =~ $Comserv::Util::AI::HermesOverrunGuard::PAID_WATCH_RE, 'hy4-preview watched');
ok('deepseek/deepseek-v4-pro' =~ $Comserv::Util::AI::HermesOverrunGuard::PAID_WATCH_RE, 'v4-pro still watched');
my $d = $G->can('decide')->(openrouter => { ok => 1, day_usd => 1.2 }, v4pro_recent => 1, watch_model => 'tencent/hy4-preview', thrash_by_class => {}, limits => {}, thrash => {}, state => {});
ok(grep({ /OpenRouter tencent\/hy4-preview active near cap/ } @{ $d->{reasons} || [] }), 'reason names hy4-preview') or diag explain $d;
ok($G->can('supergrok_budget_left')->({ mode => 'openrouter', deferred_mode => 'grok', remaining => 95, daily_budget => undef }), 'no pacing: deferred grok + remaining -> yes');
ok(!$G->can('supergrok_budget_left')->({ mode => 'openrouter', remaining => 95 }), 'no pacing, guard wants openrouter -> no');
done_testing;

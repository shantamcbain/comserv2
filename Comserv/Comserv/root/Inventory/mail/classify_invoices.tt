[% PAGE_VERSION = 'mail/classify_invoices.tt,v 0.01 2025/10/14 shanta Exp shanta ' %]
[% IF c.session.debug_mode == 1 %][% PAGE_VERSION %][% END %]

[% INCLUDE 'ApplicationTtTemplate' -
   title = 'Email Invoice Processing'
   description = 'Configure and monitor email invoice classification'
   category = 'email_processing'
   roles = ['admin', 'user']
   TemplateType = 'inventory'
   last_updated = '2025-10-14'
   page_version = '0.01'
   site_specific = 1
%]

[% SET page_title = 'Email Invoice Processing' -%]
[% SET current_page = 'email_config' -%]

<div class="email-invoice-container">
    <div class="page-header">
        <h1>📧 Email Invoice Processing</h1>
        <p class="subtitle">Configure and monitor email invoice classification for <%= $c.session.SiteName || 'CSC' %></p>
    </div>

    <div class="email-processing-layout">
        <!-- Configuration Panel -->
        <div class="config-panel">
            <h2>⚙️ Processing Configuration</h2>
            
            <div class="config-section">
                <h3>📁 Email Source</h3>
                <div class="config-option">
                    <label>
                        <input type="radio" name="email_source" value="maildir" checked>
                        <span>Maildir (Local Mail Server)</span>
                    </label>
                    <p class="help-text">Process emails from the local mail directory</p>
                </div>
                
                <div class="config-option">
                    <label>
                        <input type="radio" name="email_source" value="imap">
                        <span>IMAP Server</span>
                    </label>
                    <p class="help-text">Connect to remote IMAP email server</p>
                </div>
            </div>

            <div class="config-section">
                <h3>🎯 Processing Rules</h3>
                <div class="rule-toggle">
                    <label>
                        <input type="checkbox" id="skip_personal" checked>
                        <span>Skip personal emails</span>
                    </label>
                </div>
                
                <div class="rule-toggle">
                    <label>
                        <input type="checkbox" id="process_all_sites" checked>
                        <span>Process for all sites (including global)</span>
                    </label>
                </div>
                
                <div class="rule-toggle">
                    <label>
                        <input type="checkbox" id="auto_process">
                        <span>Auto-process new emails</span>
                    </label>
                </div>
            </div>

            <div class="config-section">
                <h3>📧 Email Targets</h3>
                <div class="target-list">
                    <div class="target-item">
                        <input type="checkbox" id="target_all" checked>
                        <label for="target_all">All Sites (global filter)</label>
                    </div>
                    <div class="target-item">
                        <input type="checkbox" id="target_current" checked>
                        <label for="target_current"><?= $c.session.SiteName || 'CSC' ?></label>
                    </div>
                </div>
            </div>

            <div class="config-actions">
                <button class="btn-primary" onclick="processEmails()">
                    🔄 Process Emails Now
                </button>
                <button class="btn-secondary" onclick="showTestPanel()">
                    🧪 Test Processing
                </button>
                <button class="btn-secondary" onclick="exportConfig()">
                    💾 Export Config
                </button>
            </div>
        </div>

        <!-- Status Panel -->
        <div class="status-panel">
            <h2>📊 Processing Status</h2>
            
            <div class="status-widget">
                <h3>📈 Today's Results</h3>
                <div class="stat-grid">
                    <div class="stat-item">
                        <div class="stat-value" id="processed-today">0</div>
                        <div class="stat-label">Invoices Processed</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value" id="emails-scanned">0</div>
                        <div class="stat-label">Emails Scanned</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value" id="personal-skipped">0</div>
                        <div class="stat-label">Personal Skipped</div>
                    </div>
                    <div class="stat-item">
                        <div class="stat-value" id="processing-errors">0</div>
                        <div class="stat-label">Errors</div>
                    </div>
                </div>
            </div>

            <div class="status-widget">
                <h3>🔄 Recent Activity</h3>
                <div class="activity-log" id="activity-log">
                    <div class="log-entry empty">
                        <span class="log-time">No recent activity</span>
                        <span class="log-message">Start processing emails to see activity</span>
                    </div>
                </div>
            </div>

            <div class="status-widget">
                <h3>📁 Email Directory Status</h3>
                <div class="directory-status">
                    <div class="dir-item">
                        <span class="dir-name">Maildir:/var/mail/invoice</span>
                        <span class="dir-status status-good">✅ Active</span>
                    </div>
                    <div class="dir-item">
                        <span class="dir-name">Size: 2.3MB</span>
                        <span class="dir-status status-info">📊 Cached</span>
                    </div>
                </div>
            </div>

            <div class="status-widget">
                <h3>⚡ Quick Actions</h3>
                <div class="quick-actions">
                    <button class="btn-small" onclick="triggerFullScan()">
                        🔍 Full Scan
                    </button>
                    <button class="btn-small" onclick="showConfigHistory()">
                        📜 Config History
                    </button>
                    <button class="btn-small" onclick="downloadLogs()">
                        📄 Download Logs
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Test Panel (Hidden by default) -->
    <div class="test-panel" id="test-panel" style="display: none;">
        <div class="test-panel-header">
            <h2>🧪 Email Processing Test</h2>
            <button class="btn-close" onclick="hideTestPanel()">&times;</button>
        </div>
        
        <div class="test-content">
            <div class="test-section">
                <h3>Test Email Source</h3>
                <select id="test-email-source">
                    <option value="sample">Sample Email</option>
                    <option value="maildir">Actual Maildir</option>
                </select>
            </div>
            
            <div class="test-section">
                <h3>Test Processing Rules</h3>
                <textarea id="test-rules" placeholder="Enter test processing rules..." rows="4"></textarea>
            </div>
            
            <div class="test-actions">
                <button class="btn-primary" onclick="runTest()">🚀 Run Test</button>
                <button class="btn-secondary" onclick="hideTestPanel()">❌ Cancel</button>
            </div>
        </div>
    </div>

    <!-- JavaScript for email processing functionality -->
    <script>
        // Email processing configuration
        const emailConfig = {
            siteName: '<?= $c.session.SiteName || 'CSC' ?>',
            source: 'maildir',
            skipPersonal: true,
            processAllSites: true,
            autoProcess: false,
            targets: ['all', '<?= $c.session.SiteName || 'CSC' ?>']
        };

        // Process emails function
        function processEmails() {
            const button = event?.target || document.querySelector('.btn-primary');
            button.disabled = true;
            button.textContent = '🔄 Processing...';
            
            // Simulate API call
            setTimeout(() => {
                updateStatus(5, 12, 2, 0);
                addActivityLog('Processing completed successfully', 'success');
                button.disabled = false;
                button.textContent = '🔄 Process Emails Now';
            }, 2000);
        }

        // Update status display
        function updateStatus(processed, scanned, personal, errors) {
            document.getElementById('processed-today').textContent = processed;
            document.getElementById('emails-scanned').textContent = scanned;
            document.getElementById('personal-skipped').textContent = personal;
            document.getElementById('processing-errors').textContent = errors;
        }

        // Add activity log entry
        function addActivityLog(message, type = 'info') {
            const log = document.getElementById('activity-log');
            const entry = document.createElement('div');
            entry.className = 'log-entry';
            entry.innerHTML = `
                <span class="log-time">${new Date().toLocaleTimeString()}</span>
                <span class="log-message ${type}">${message}</span>
            `;
            log.insertBefore(entry, log.firstChild);
        }

        // Show test panel
        function showTestPanel() {
            document.getElementById('test-panel').style.display = 'block';
        }

        // Hide test panel
        function hideTestPanel() {
            document.getElementById('test-panel').style.display = 'none';
        }

        // Test processing
        function runTest() {
            const button = event?.target || document.querySelector('.btn-primary');
            button.disabled = true;
            button.textContent = '🔄 Testing...';
            
            setTimeout(() => {
                addActivityLog('Test completed successfully', 'success');
                button.disabled = false;
                button.textContent = '🚀 Run Test';
            }, 1500);
        }

        // Export configuration
        function exportConfig() {
            const config = JSON.stringify(emailConfig, null, 2);
            const blob = new Blob([config], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = 'email-config.json';
            a.click();
            URL.revokeObjectURL(url);
            addActivityLog('Configuration exported', 'info');
        }

        // Trigger full scan
        function triggerFullScan() {
            addActivityLog('Starting full email scan...', 'info');
            processEmails();
        }

        // Show config history
        function showConfigHistory() {
            addActivityLog('Configuration history displayed', 'info');
        }

        // Download logs
        function downloadLogs() {
            addActivityLog('Logs downloaded', 'info');
        }

        // Initialize page
        document.addEventListener('DOMContentLoaded', function() {
            addActivityLog('Email processing interface loaded', 'success');
        });
    </script>

    <style>
        .email-invoice-container {
            max-width: 1400px;
            margin: 0 auto;
            padding: 20px;
        }

        .page-header {
            text-align: center;
            margin-bottom: 30px;
            padding: 20px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 12px;
        }

        .page-header h1 {
            margin: 0 0 10px 0;
            font-size: 2.5em;
        }

        .subtitle {
            opacity: 0.9;
            font-size: 1.1em;
        }

        .email-processing-layout {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 30px;
            margin-bottom: 30px;
        }

        .config-panel, .status-panel {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .config-section, .status-widget {
            margin-bottom: 25px;
        }

        .config-section h3, .status-widget h3 {
            color: #2c3e50;
            margin-bottom: 15px;
            padding-bottom: 10px;
            border-bottom: 2px solid #ecf0f1;
        }

        .config-option, .rule-toggle {
            display: flex;
            align-items: center;
            margin-bottom: 10px;
            padding: 10px;
            background: #f8f9fa;
            border-radius: 6px;
        }

        .config-option input, .rule-toggle input {
            margin-right: 10px;
        }

        .help-text {
            color: #7f8c8d;
            font-size: 0.9em;
            margin-top: 5px;
        }

        .target-list {
            display: grid;
            gap: 10px;
        }

        .target-item {
            display: flex;
            align-items: center;
            padding: 8px;
            background: #e8f4fd;
            border-radius: 4px;
        }

        .config-actions {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
            margin-top: 20px;
        }

        .btn-primary, .btn-secondary, .btn-small, .btn-close {
            padding: 12px 20px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-secondary {
            background: #6c757d;
            color: white;
        }

        .stat-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        .stat-item {
            text-align: center;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 8px;
        }

        .stat-value {
            font-size: 2em;
            font-weight: bold;
            color: #2c3e50;
        }

        .stat-label {
            color: #7f8c8d;
            font-size: 0.9em;
            margin-top: 5px;
        }

        .activity-log {
            max-height: 300px;
            overflow-y: auto;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            padding: 10px;
        }

        .log-entry {
            display: flex;
            justify-content: space-between;
            padding: 8px;
            border-bottom: 1px solid #e9ecef;
        }

        .log-entry.empty {
            color: #7f8c8d;
            font-style: italic;
        }

        .log-time {
            font-weight: 600;
        }

        .log-message {
            color: #495057;
        }

        .log-message.success {
            color: #28a745;
        }

        .log-message.error {
            color: #dc3545;
        }

        .directory-status {
            display: grid;
            gap: 10px;
        }

        .dir-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px;
            background: #f8f9fa;
            border-radius: 6px;
        }

        .dir-status {
            padding: 4px 8px;
            border-radius: 4px;
            font-size: 0.9em;
        }

        .status-good {
            background: #d4edda;
            color: #155724;
        }

        .status-info {
            background: #d1ecf1;
            color: #0c5460;
        }

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 10px;
        }

        .btn-small {
            padding: 8px 12px;
            font-size: 0.9em;
        }

        .test-panel {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            z-index: 1000;
            max-width: 600px;
            width: 90%;
        }

        .test-panel-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid #dee2e6;
        }

        .btn-close {
            background: #dc3545;
            color: white;
            padding: 8px 12px;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            font-family: monospace;
            resize: vertical;
        }

        @media (max-width: 1200px) {
            .email-processing-layout {
                grid-template-columns: 1fr;
            }
        }
    </style>
</div>
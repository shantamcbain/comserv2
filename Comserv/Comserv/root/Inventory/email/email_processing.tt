[% PageVersion = 'email/email_processing.tt,v 0.01 2025/10/14 shanta Exp shanta ' %]
[% IF c.session.debug_mode == 1 %][% PageVersion %][% END %]

[% INCLUDE 'DocumentationTtTemplate' -
   title = 'Email Invoice Processing System'
   description = 'Complete email invoice classification and processing system'
   category = 'inventory'
   roles = ['admin', 'user']
   TemplateType = 'application'
   last_updated = '2025-10-14'
   page_version = '0.01'
   site_specific = 1
%]

[% SET page_title = 'Email Invoice Processing System' -%]
[% SET current_page = 'email_processing' -%]

<div class="email-system-container">
    <div class="system-header">
        <h1>📧 Comserv Email Invoice Processing System</h1>
        <p class="subtitle">Advanced email classification and invoice extraction for <%= $c.session.SiteName || 'CSC' %></p>
    </div>

    <div class="system-overview">
        <div class="overview-card">
            <div class="card-icon">📊</div>
            <h3>Processing Statistics</h3>
            <div class="stats-grid">
                <div class="stat-item">
                    <div class="stat-number" id="total-emails">0</div>
                    <div class="stat-label">Total Processed</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number" id="valid-invoices">0</div>
                    <div class="stat-label">Valid Invoices</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number" id="processing-rate">0%</div>
                    <div class="stat-label">Success Rate</div>
                </div>
                <div class="stat-item">
                    <div class="stat-number" id="processing-queue">0</div>
                    <div class="stat-label">Queue Length</div>
                </div>
            </div>
        </div>

        <div class="overview-card">
            <div class="card-icon">⚙️</div>
            <h3>Configuration Status</h3>
            <div class="status-info">
                <div class="status-item">
                    <span class="status-label">Mail Server:</span>
                    <span class="status-value" id="mail-server-status">Not Configured</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Processing Rules:</span>
                    <span class="status-value" id="rules-status">Loading...</span>
                </div>
                <div class="status-item">
                    <span class="status-label">Last Sync:</span>
                    <span class="status-value" id="last-sync">Never</span>
                </div>
            </div>
        </div>

        <div class="overview-card">
            <div class="card-icon">🔄</div>
            <h3>Quick Actions</h3>
            <div class="quick-actions">
                <button class="action-btn primary" onclick="startEmailProcessing()">
                    <span class="btn-icon">🚀</span>
                    <span class="btn-text">Start Processing</span>
                </button>
                <button class="action-btn secondary" onclick="showEmailConfiguration()">
                    <span class="btn-icon">⚙️</span>
                    <span class="btn-text">Configure Email</span>
                </button>
                <button class="action-btn secondary" onclick="downloadProcessedEmails()">
                    <span class="btn-icon">📄</span>
                    <span class="btn-text">Download Results</span>
                </button>
                <button class="action-btn info" onclick="showProcessingLog()">
                    <span class="btn-icon">📋</span>
                    <span class="btn-text">View Log</span>
                </button>
            </div>
        </div>
    </div>

    <div class="system-tabs">
        <div class="tab-navigation">
            <button class="tab-btn active" onclick="showTab('processing')">📧 Processing</button>
            <button class="tab-btn" onclick="showTab('configuration')">⚙️ Configuration</button>
            <button class="tab-btn" onclick="showTab('history')">📊 History</button>
            <button class="tab-btn" onclick="showTab('settings')">🔧 Settings</button>
        </div>

        <div class="tab-content active" id="tab-processing">
            <div class="processing-interface">
                <div class="processing-panel">
                    <h3>🔄 Email Processing Queue</h3>
                    <div class="queue-container" id="email-queue">
                        <div class="queue-header">
                            <span class="header-item">Priority</span>
                            <span class="header-item">From</span>
                            <span class="header-item">Subject</span>
                            <span class="header-item">Status</span>
                            <span class="header-item">Actions</span>
                        </div>
                        <div class="queue-items" id="queue-items">
                            <div class="queue-item empty">
                                <span class="item-priority">Normal</span>
                                <span class="item-from">No emails in queue</span>
                                <span class="item-subject">Start processing to see emails</span>
                                <span class="item-status">
                                    <span class="status-badge waiting">Waiting</span>
                                </span>
                                <span class="item-actions">
                                    <button class="action-mini" onclick="processEmailItem(this)">Process</button>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="processing-panel">
                    <h3>📊 Processing Statistics</h3>
                    <div class="stats-dashboard">
                        <div class="stat-chart">
                            <h4>Processing Trends</h4>
                            <div class="chart-container" id="processing-chart">
                                <!-- Chart will be rendered here -->
                                <div class="chart-placeholder">
                                    <p>Processing statistics visualization</p>
                                </div>
                            </div>
                        </div>
                        <div class="stat-summary">
                            <h4>Summary</h4>
                            <div class="summary-items">
                                <div class="summary-item">
                                    <span class="summary-label">Emails Processed Today:</span>
                                    <span class="summary-value" id="today-count">0</span>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label">Invoices Extracted:</span>
                                    <span class="summary-value" id="invoices-count">0</span>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label">Average Processing Time:</span>
                                    <span class="summary-value" id="avg-processing-time">0s</span>
                                </div>
                                <div class="summary-item">
                                    <span class="summary-label">Error Rate:</span>
                                    <span class="summary-value error" id="error-rate">0%</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-content" id="tab-configuration">
            <div class="configuration-interface">
                <div class="config-section">
                    <h3>📧 Email Server Configuration</h3>
                    <form class="config-form" id="email-config-form">
                        <div class="form-grid">
                            <div class="form-group">
                                <label for="smtp-server">SMTP Server:</label>
                                <input type="text" id="smtp-server" name="smtp_server" 
                                       value="imap.gmail.com" placeholder="imap.example.com">
                            </div>
                            <div class="form-group">
                                <label for="smtp-port">Port:</label>
                                <input type="number" id="smtp-port" name="smtp_port" 
                                       value="993" placeholder="993">
                            </div>
                            <div class="form-group">
                                <label for="smtp-username">Username:</label>
                                <input type="text" id="smtp-username" name="smtp_username" 
                                       value="invoice@company.com" placeholder="user@domain.com">
                            </div>
                            <div class="form-group">
                                <label for="smtp-password">Password:</label>
                                <input type="password" id="smtp-password" name="smtp_password" 
                                       value="••••••••" placeholder="Enter password">
                            </div>
                            <div class="form-group">
                                <label for="imap-folder">IMAP Folder:</label>
                                <input type="text" id="imap-folder" name="imap_folder" 
                                       value="INBOX" placeholder="INBOX">
                            </div>
                            <div class="form-group">
                                <label for="email-from">From Address:</label>
                                <input type="email" id="email-from" name="email_from" 
                                       value="invoices@company.com" placeholder="invoices@domain.com">
                            </div>
                        </div>
                        
                        <div class="form-section">
                            <h4>Processing Rules</h4>
                            <div class="rule-options">
                                <div class="rule-option">
                                    <label>
                                        <input type="checkbox" id="skip-personal" checked>
                                        <span>Skip Personal Emails</span>
                                    </label>
                                </div>
                                <div class="rule-option">
                                    <label>
                                        <input type="checkbox" id="skip-promotional" checked>
                                        <span>Skip Promotional Emails</span>
                                    </label>
                                </div>
                                <div class="rule-option">
                                    <label>
                                        <input type="checkbox" id="process-receipts-only" checked>
                                        <span>Process Receipt Invoices Only</span>
                                    </label>
                                </div>
                                <div class="rule-option">
                                    <label>
                                        <input type="checkbox" id="auto-process" checked>
                                        <span>Auto-process New Emails</span>
                                    </label>
                                </div>
                            </div>
                        </div>
                        
                        <div class="form-section">
                            <h4>Target Sites</h4>
                            <div class="target-options">
                                <div class="target-option">
                                    <label>
                                        <input type="radio" name="target_sites" value="all" checked>
                                        <span>All Sites (including global)</span>
                                    </label>
                                </div>
                                <div class="target-option">
                                    <label>
                                        <input type="radio" name="target_sites" value="current">
                                        <span>Current Site Only (<%= $c.session.SiteName || 'CSC' %>)</span>
                                    </label>
                                </div>
                                <div class="target-option">
                                    <label>
                                        <input type="radio" name="target_sites" value="custom">
                                        <span>Custom Sites (select below)</span>
                                    </label>
                                </div>
                            </div>
                            <div class="custom-targets" id="custom-targets" style="display: none;">
                                <label>Select Sites:</label>
                                <select multiple id="site-list">
                                    <option value="csc">CSC</option>
                                    <option value="abc">ABC Corp</option>
                                    <option value="xyz">XYZ Industries</option>
                                </select>
                            </div>
                        </div>
                        
                        <div class="form-actions">
                            <button type="button" class="btn-primary" onclick="saveEmailConfiguration()">
                                💾 Save Configuration
                            </button>
                            <button type="button" class="btn-secondary" onclick="testEmailConnection()">
                                🧪 Test Connection
                            </button>
                            <button type="button" class="btn-secondary" onclick="exportConfiguration()">
                                📄 Export Configuration
                            </button>
                        </div>
                    </form>
                </div>

                <div class="config-panel">
                    <h3>📊 System Status</h3>
                    <div class="status-indicators">
                        <div class="status-indicator">
                            <span class="indicator-label">Mail Server:</span>
                            <span class="indicator-value">
                                <span class="status-dot good"></span>
                                <span>Connected</span>
                            </span>
                        </div>
                        <div class="status-indicator">
                            <span class="indicator-label">Processing Rules:</span>
                            <span class="indicator-value">
                                <span class="status-dot good"></span>
                                <span>Loaded (3 rules)</span>
                            </span>
                        </div>
                        <div class="status-indicator">
                            <span class="indicator-label">Last Sync:</span>
                            <span class="indicator-value">
                                <span class="status-dot warning"></span>
                                <span>2 minutes ago</span>
                            </span>
                        </div>
                        <div class="status-indicator">
                            <span class="indicator-label">Queue Status:</span>
                            <span class="indicator-value">
                                <span class="status-dot error"></span>
                                <span>0 items</span>
                            </span>
                        </div>
                    </div>
                    
                    <div class="system-health">
                        <h4>System Health</h4>
                        <div class="health-metrics">
                            <div class="health-metric">
                                <div class="metric-header">
                                    <span>CPU Usage</span>
                                    <span>45%</span>
                                </div>
                                <div class="metric-bar">
                                    <div class="bar-fill" style="width: 45%"></div>
                                </div>
                            </div>
                            <div class="health-metric">
                                <div class="metric-header">
                                    <span>Memory Usage</span>
                                    <span>67%</span>
                                </div>
                                <div class="metric-bar">
                                    <div class="bar-fill" style="width: 67%"></div>
                                </div>
                            </div>
                            <div class="health-metric">
                                <div class="metric-header">
                                    <span>Disk Space</span>
                                    <span>78%</span>
                                </div>
                                <div class="metric-bar">
                                    <div class="bar-fill" style="width: 78%"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-content" id="tab-history">
            <div class="history-interface">
                <div class="history-controls">
                    <div class="control-group">
                        <label>Date Range:</label>
                        <select id="date-range">
                            <option value="today">Today</option>
                            <option value="yesterday">Yesterday</option>
                            <option value="week">This Week</option>
                            <option value="month">This Month</option>
                            <option value="all">All Time</option>
                        </select>
                    </div>
                    <div class="control-group">
                        <label>Filter by Status:</label>
                        <select id="status-filter">
                            <option value="all">All Statuses</option>
                            <option value="completed">Completed</option>
                            <option value="processing">Processing</option>
                            <option value="error">Error</option>
                            <option value="pending">Pending</option>
                        </select>
                    </div>
                    <button class="btn-primary" onclick="refreshHistory()">🔄 Refresh</button>
                </div>

                <div class="history-timeline">
                    <div class="timeline-header">
                        <span class="time-col">Time</span>
                        <span class="event-col">Event</span>
                        <span class="source-col">Source</span>
                        <span class="result-col">Result</span>
                        <span class="actions-col">Actions</span>
                    </div>
                    <div class="timeline-events" id="timeline-events">
                        <!-- Timeline events will be populated here -->
                        <div class="timeline-event">
                            <div class="event-time">14:58</div>
                            <div class="event-content">
                                <span class="event-icon">📧</span>
                                <span class="event-title">Email processing completed successfully</span>
                            </div>
                            <div class="event-source">Maildir</div>
                            <div class="event-result">
                                <span class="result-badge success">5 invoices</span>
                            </div>
                            <div class="event-actions">
                                <button class="action-link" onclick="viewEventDetails(1)">View Details</button>
                            </div>
                        </div>
                        <div class="timeline-event">
                            <div class="event-time">14:45</div>
                            <div class="event-content">
                                <span class="event-icon">⚠️</span>
                                <span class="event-title">Email processing error occurred</span>
                            </div>
                            <div class="event-source">SMTP Server</div>
                            <div class="event-result">
                                <span class="result-badge error">Connection Failed</span>
                            </div>
                            <div class="event-actions">
                                <button class="action-link" onclick="viewEventDetails(2)">View Details</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="tab-content" id="tab-settings">
            <div class="settings-interface">
                <div class="settings-section">
                    <h3>🔧 System Settings</h3>
                    
                    <div class="setting-group">
                        <h4>Processing Settings</h4>
                        <div class="setting-options">
                            <div class="setting-option">
                                <label>
                                    <input type="checkbox" id="auto-start" checked>
                                    <span>Auto-start processing on system startup</span>
                                </label>
                            </div>
                            <div class="setting-option">
                                <label>
                                    <input type="checkbox" id="backup-enabled" checked>
                                    <span>Enable automatic backup of processed emails</span>
                                </label>
                            </div>
                            <div class="setting-option">
                                <label>
                                    <input type="checkbox" id="error-notification" checked>
                                    <span>Send email notifications on errors</span>
                                </label>
                            </div>
                            <div class="setting-option">
                                <label>
                                    <input type="checkbox" id="success-notification">
                                    <span>Send email notifications on successful processing</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="setting-group">
                        <h4>Security Settings</h4>
                        <div class="setting-options">
                            <div class="setting-option">
                                <label>
                                    <input type="checkbox" id="require-auth" checked>
                                    <span>Require authentication for email access</span>
                                </label>
                            </div>
                            <div class="setting-option">
                                <label>
                                    <input type="checkbox" id="encrypt-emails" checked>
                                    <span>Encrypt sensitive email data</span>
                                </label>
                            </div>
                        </div>
                    </div>
                    
                    <div class="setting-actions">
                        <button class="btn-primary" onclick="saveSystemSettings()">💾 Save Settings</button>
                        <button class="btn-secondary" onclick="resetSettings()">🔄 Reset to Defaults</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal Panels -->
    <div class="modal-panel" id="email-config-modal" style="display: none;">
        <div class="modal-header">
            <h3>📧 Email Configuration</h3>
            <button class="btn-close" onclick="hideModal('email-config-modal')">×</button>
        </div>
        <div class="modal-content">
            <!-- Email configuration form will be loaded here -->
            <p>Email configuration form will be available here...</p>
        </div>
    </div>

    <div class="modal-panel" id="processing-log-modal" style="display: none;">
        <div class="modal-header">
            <h3>📋 Processing Log</h3>
            <button class="btn-close" onclick="hideModal('processing-log-modal')">×</button>
        </div>
        <div class="modal-content">
            <!-- Processing log will be displayed here -->
            <div class="log-container" id="processing-log">
                <div class="log-entry">
                    <div class="log-time">14:58</div>
                    <div class="log-content">
                        <span class="log-level info">INFO</span>
                        <span class="log-message">Email processing started</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // Email Processing System JavaScript
        const emailSystem = {
            currentTab: 'processing',
            processingQueue: [],
            processingStats: {
                total: 0,
                completed: 0,
                processing: 0,
                error: 0,
                successRate: 0
            }
        };

        // Initialize the system
        function initEmailSystem() {
            console.log('Initializing Email Processing System...');
            loadProcessingStats();
            updateQueueDisplay();
        }

        // Tab management
        function showTab(tabName) {
            // Hide all tabs
            document.querySelectorAll('.tab-content').forEach(tab => {
                tab.classList.remove('active');
            });
            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.classList.remove('active');
            });
            
            // Show selected tab
            document.getElementById(`tab-${tabName}`).classList.add('active');
            event.target.classList.add('active');
            
            emailSystem.currentTab = tabName;
        }

        // Processing functions
        function startEmailProcessing() {
            console.log('Starting email processing...');
            // Simulate adding emails to processing queue
            addEmailToQueue({
                id: Date.now(),
                from: 'invoices@company.com',
                subject: 'Monthly Invoice - January 2024',
                priority: 'high',
                status: 'processing'
            });
            
            updateStats();
        }

        function addEmailToQueue(email) {
            emailSystem.processingQueue.push(email);
            updateQueueDisplay();
            updateStats();
        }

        function updateQueueDisplay() {
            const queueContainer = document.getElementById('queue-items');
            if (queueContainer) {
                if (emailSystem.processingQueue.length === 0) {
                    queueContainer.innerHTML = `
                        <div class="queue-item empty">
                            <span class="item-priority">Normal</span>
                            <span class="item-from">No emails in queue</span>
                            <span class="item-subject">Start processing to see emails</span>
                            <span class="item-status">
                                <span class="status-badge waiting">Waiting</span>
                            </span>
                            <span class="item-actions">
                                <button class="action-mini" onclick="processEmailItem(this)">Process</button>
                            </span>
                        </div>
                    `;
                } else {
                    queueContainer.innerHTML = emailSystem.processingQueue.map(email => `
                        <div class="queue-item">
                            <span class="item-priority">
                                ${email.priority === 'high' ? '🔴 High' : email.priority === 'medium' ? '⚡ Medium' : 'Normal'}
                            </span>
                            <span class="item-from">${email.from}</span>
                            <span class="item-subject">${email.subject}</span>
                            <span class="item-status">
                                <span class="status-badge ${email.status}">${email.status}</span>
                            </span>
                            <span class="item-actions">
                                <button class="action-mini" onclick="processEmailItem(this, ${email.id})">Process</button>
                            </span>
                        </div>
                    `).join('');
                }
            }
        }

        function processEmailItem(button, emailId) {
            const email = emailSystem.processingQueue.find(e => e.id === emailId);
            if (email) {
                email.status = 'processing';
                updateQueueDisplay();
                updateStats();
                
                // Simulate processing
                setTimeout(() => {
                    email.status = 'completed';
                    email.result = Math.floor(Math.random() * 10) + 1; // Random number of invoices
                    updateQueueDisplay();
                    updateStats();
                }, 2000);
            }
        }

        function updateStats() {
            const completed = emailSystem.processingQueue.filter(e => e.status === 'completed').length;
            const total = emailSystem.processingQueue.length;
            const error = emailSystem.processingQueue.filter(e => e.status === 'error').length;
            
            emailSystem.processingStats.total = total;
            emailSystem.processingStats.completed = completed;
            emailSystem.processingStats.error = error;
            emailSystem.processingStats.successRate = total > 0 ? ((completed / total) * 100) : 0;
            
            document.getElementById('total-emails').textContent = total;
            document.getElementById('valid-invoices').textContent = completed;
            document.getElementById('processing-rate').textContent = emailSystem.processingStats.successRate.toFixed(1) + '%';
            document.getElementById('processing-queue').textContent = emailSystem.processingQueue.filter(e => e.status === 'processing').length;
        }

        // Email configuration functions
        function showEmailConfiguration() {
            showModal('email-config-modal');
        }

        function hideModal(modalId) {
            document.getElementById(modalId).style.display = 'none';
        }

        function showModal(modalId) {
            // Hide all modals
            document.querySelectorAll('.modal-panel').forEach(modal => {
                modal.style.display = 'none';
            });
            document.getElementById(modalId).style.display = 'block';
        }

        // Navigation functions
        function saveEmailConfiguration() {
            console.log('Saving email configuration...');
            // Here you would send the configuration to the server
            showNotification('Email configuration saved successfully', 'success');
        }

        function testEmailConnection() {
            console.log('Testing email connection...');
            // Simulate connection test
            setTimeout(() => {
                showNotification('Email connection test successful', 'success');
            }, 1000);
        }

        function exportConfiguration() {
            console.log('Exporting email configuration...');
            // Here you would export the configuration
            showNotification('Email configuration exported successfully', 'success');
        }

        function refreshHistory() {
            console.log('Refreshing history...');
            // Here you would refresh the history data
            showNotification('History refreshed successfully', 'info');
        }

        function saveSystemSettings() {
            console.log('Saving system settings...');
            showNotification('System settings saved successfully', 'success');
        }

        function resetSettings() {
            if (confirm('Are you sure you want to reset all settings to defaults?')) {
                console.log('Resetting settings...');
                showNotification('Settings reset to defaults', 'info');
            }
        }

        function showNotification(message, type = 'info') {
            const notification = document.createElement('div');
            notification.className = `notification ${type}`;
            notification.textContent = message;
            notification.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                padding: 15px 20px;
                background: ${type === 'success' ? '#d4edda' : '#d1ecf1'};
                color: ${type === 'success' ? '#155724' : '#0c5460'};
                border: 1px solid ${type === 'success' ? '#c3e6cb' : '#bee5eb'};
                border-radius: 6px;
                z-index: 1000;
                animation: slideIn 0.3s ease;
            `;
            document.body.appendChild(notification);
            
            setTimeout(() => {
                notification.style.animation = 'slideOut 0.3s ease';
                setTimeout(() => {
                    document.body.removeChild(notification);
                }, 300);
            }, 3000);
        }

        // CSS animations
        const style = document.createElement('style');
        style.textContent = `
            @keyframes slideIn {
                from { transform: translateX(100%); }
                to { transform: translateX(0); }
            }
            @keyframes slideOut {
                from { transform: translateX(0); }
                to { transform: translateX(100%); }
            }
        `;
        document.head.appendChild(style);

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            initEmailSystem();
            console.log('Email Processing System loaded successfully');
        });
    </script>

    <style>
        .email-system-container {
            max-width: 1600px;
            margin: 0 auto;
            padding: 20px;
        }

        .system-header {
            text-align: center;
            margin-bottom: 30px;
            padding: 30px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
            border-radius: 12px;
        }

        .system-header h1 {
            margin: 0 0 10px 0;
            font-size: 2.5em;
        }

        .subtitle {
            opacity: 0.9;
            font-size: 1.2em;
        }

        .system-overview {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 20px;
            margin-bottom: 30px;
        }

        .overview-card {
            background: white;
            border-radius: 12px;
            padding: 25px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .overview-card .card-icon {
            font-size: 2.5em;
            margin-bottom: 15px;
        }

        .overview-card h3 {
            color: #2c3e50;
            margin-bottom: 20px;
        }

        .stats-grid {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        .stat-item {
            text-align: center;
            padding: 15px;
            background: #f8f9fa;
            border-radius: 8px;\n            border-left: 4px solid #667eea;
        }

        .stat-number {
            font-size: 2em;
            font-weight: bold;
            color: #2c3e50;
            margin-bottom: 5px;
        }

        .stat-label {
            color: #7f8c8d;
            font-size: 0.9em;
        }

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 10px;
            margin-top: 20px;
        }

        .action-btn {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
            padding: 15px;
            border: 2px solid #dee2e6;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .action-btn:hover {
            border-color: #667eea;
            background: #e9ecef;
            transform: translateY(-3px);
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        .action-btn.primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .action-btn.secondary {
            background: #6c757d;
            color: white;
        }

        .action-btn.info {
            background: #17a2b8;
            color: white;
        }

        .action-icon {
            font-size: 1.5em;
        }

        .action-text {
            font-weight: 600;
        }

        .system-tabs {
            background: white;
            border-radius: 12px;
            padding: 20px;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .tab-navigation {
            display: flex;
            gap: 10px;
            margin-bottom: 20px;
            border-bottom: 2px solid #dee2e6;
        }

        .tab-btn {
            padding: 12px 24px;
            border: none;
            background: none;
            cursor: pointer;
            font-weight: 600;
            color: #6c757d;
            border-bottom: 2px solid transparent;
            transition: all 0.3s ease;
        }

        .tab-btn.active {
            color: #667eea;
            border-bottom-color: #667eea;
        }

        .tab-btn:hover {
            color: #5a67d8;
        }

        .tab-content {
            display: none;
        }

        .tab-content.active {
            display: block;
        }

        .processing-interface, .configuration-interface, .history-interface, .settings-interface {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
            gap: 20px;
        }

        .processing-panel, .config-panel, .history-panel, .settings-panel {
            background: #f8f9fa;
            border-radius: 8px;
            padding: 20px;
            border-left: 4px solid #667eea;
        }

        .processing-panel h3, .config-panel h3, .history-panel h3, .settings-panel h3 {
            color: #2c3e50;
            margin-bottom: 15px;
        }

        .queue-container {
            border: 1px solid #dee2e6;
            border-radius: 8px;
            overflow: hidden;
        }

        .queue-header {
            display: grid;
            grid-template-columns: 100px 1fr 1fr 100px 100px;
            gap: 10px;
            padding: 15px;
            background: #e9ecef;
            font-weight: 600;
        }

        .queue-items {
            max-height: 400px;
            overflow-y: auto;
        }

        .queue-item {
            display: grid;
            grid-template-columns: 100px 1fr 1fr 100px 100px;
            gap: 10px;
            padding: 15px;
            border-bottom: 1px solid #dee2e6;
            align-items: center;
        }

        .queue-item:hover {
            background: #f8f9fa;
        }

        .queue-item.empty {
            text-align: center;
            color: #7f8c8d;
            font-style: italic;
            padding: 40px;
        }

        .status-badge {
            display: inline-block;
            padding: 4px 12px;
            border-radius: 20px;
            font-size: 0.9em;
            font-weight: 600;
        }

        .status-badge.waiting { background: #fff3cd; color: #856404; }
        .status-badge.processing { background: #cce5ff; color: #004085; }
        .status-badge.completed { background: #d4edda; color: #155724; }
        .status-badge.error { background: #f8d7da; color: #721c24; }

        .action-mini {
            padding: 4px 8px;
            border: 1px solid #dee2e6;
            background: white;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.9em;
        }

        .action-mini:hover {
            background: #e9ecef;
            border-color: #667eea;
        }

        .form-group {
            margin-bottom: 15px;
        }

        .form-group label {
            display: block;
            margin-bottom: 5px;
            font-weight: 600;
            color: #495057;
        }

        .form-group input, .form-group select, .form-group textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #dee2e6;
            border-radius: 6px;
            font-size: 14px;
        }

        .form-group input:focus, .form-group select:focus, .form-group textarea:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
        }

        .form-section {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #dee2e6;
        }

        .form-section h4 {
            color: #2c3e50;
            margin-bottom: 15px;
        }

        .rule-options, .target-options {
            display: grid;
            gap: 10px;
        }

        .rule-option, .target-option {
            display: flex;
            align-items: center;
            padding: 12px;
            background: #f8f9fa;
            border-radius: 8px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .rule-option:hover, .target-option:hover {
            background: #e9ecef;
            transform: translateX(5px);
        }

        .custom-targets {
            margin-top: 15px;
            padding: 15px;
            background: #e8f4fd;
            border-radius: 8px;
            border: 1px solid #bee5eb;
        }

        .setting-options {
            display: grid;
            gap: 10px;
        }

        .setting-option {
            display: flex;
            align-items: center;
            padding: 12px;
            background: #f8f9fa;
            border-radius: 8px;
        }

        .btn-primary, .btn-secondary {
            padding: 12px 24px;
            border: none;
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .btn-primary {
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            color: white;
        }

        .btn-secondary {
            background: #6c757d;
            color: white;
        }

        .modal-panel {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            background: white;
            border-radius: 12px;
            padding: 30px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            z-index: 1000;
            max-width: 800px;
            width: 90%;
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            padding-bottom: 15px;
            border-bottom: 2px solid #dee2e6;
        }

        .btn-close {
            background: #dc3545;
            color: white;
            border: none;
            border-radius: 50%;
            width: 40px;
            height: 40px;
            cursor: pointer;
            font-size: 1.2em;
        }

        @media (max-width: 1200px) {
            .system-overview {
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            }

            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .quick-actions {
                grid-template-columns: repeat(2, 1fr);
            }

            .processing-interface, .configuration-interface, .history-interface, .settings-interface {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 768px) {
            .stats-grid {
                grid-template-columns: repeat(2, 1fr);
            }

            .quick-actions {
                grid-template-columns: repeat(2, 1fr);
            }

            .tab-navigation {
                flex-direction: column;
            }
        }
    </style>
</div>
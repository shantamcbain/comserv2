  "comment": "Old /cgi-bin URL map. Script keys are lowercase, relative to /cgi-bin/. Rules run in order; first hit wins. Targets are same-host paths, or \"410\". Values are matched lowercase. session_id is always ignored. A target may be an object keyed by lowercase site= value, with \"*\" as fallback.",
  "default": "410",
  "scripts": {
    "index.cgi": {
      "rules": [
        {
          "param": "submit_logon",
          "to": "410"
        },
        {
          "param": "procedure",
          "values": {
            "winterizingyard": "/page/wintering-yard-fall-2026",
            "contactview": "/HelpDesk/contact",
            "wintervisits": {
              "bmaster": "https://beemaster.ca/page/core_autumn_stores_interior_bc",
              "*": "/page/wintering-yard-fall-2026"
            },
            "yardmanagementsystem": "/BMaster"
          },
          "else": "410"
        },
        {
          "param": "page",
          "values": {
            "homeview": "/",
            "firstvisit": "/",
            "swarmcontrol": {
              "bmaster": "https://beemaster.ca/page/core_swarm_control",
              "*": "/BMaster/education"
            },
            "hiveevaluation": {
              "bmaster": "https://beemaster.ca/page/core_struggling_small_hive",
              "*": "/BMaster/education"
            },
            "hiveevaluationlost": {
              "bmaster": "https://beemaster.ca/page/core_disease_screen_signs",
              "*": "/BMaster/education"
            },
            "disease": {
              "bmaster": "https://beemaster.ca/page/core_disease_screen_signs",
              "*": "/BMaster/education"
            },
            "beeproducts": "/BMaster/products",
            "beeproductsstock": "/BMaster/products",
            "nucmakingworkshop": "/workshop",
            "earthheartcolective": "/workshop"
          },
          "regex": [
            [
              "workshop$",
              "/workshop"
            ]
          ],
          "else": "410"
        },
        {
          "param": "view",
          "values": {
            "homeview": "/",
            "hostingview": "/CSC/web_hosting",
            "buysellhomeview": "/marketplace",
            "workshopsview": "/workshop",
            "productview": "/shop",
            "jobview": "/jobs",
            "contactview": "/HelpDesk/contact",
            "membersview": "/membership",
            "mailview": "/newsletters",
            "newsletterview": {
              "bmaster": "https://beemaster.ca/page/nl-pub-beemaster-class-newsletters",
              "*": "/newsletters"
            },
            "bmasterbreederview": {
              "bmaster": "https://beemaster.ca/page/breeder_program",
              "*": "/BMaster/products"
            },
            "helpdeskhomeview": "/HelpDesk",
            "botanicalnameview": "/ENCY/BotanicalNameView",
            "forumulaview": "/ENCY/Formula",
            "formulaview": "/ENCY/Formula",
            "mentorview": {
              "bmaster": "https://beemaster.ca/page/mentoring_program",
              "*": "410"
            },
            "mentoringhomeview": {
              "bmaster": "https://beemaster.ca/page/mentoring_program",
              "*": "410"
            },
            "opensourceview": "https://computersystemconsulting.ca/page/open_source_vs_closed",
            "apisqueensview": {
              "bmaster": "https://beemaster.ca/page/sustainable_queens",
              "apis": "https://beemaster.ca/page/sustainable_queens",
              "*": "410"
            },
            "resourcesview": {
              "ency": "https://ency.usbm.ca/page/environmental_resources",
              "usbm": "https://ency.usbm.ca/page/environmental_resources",
              "*": "410"
            }
          },
          "else": "410"
        }
      ],
      "default": "/"
    },
    "page.cgi": {
      "alias": "index.cgi"
    },
    "forager/index.cgi": {
      "alias": "index.cgi"
    },
    "buyandsell/buy.cgi": {
      "rules": [
        {
          "param": "submit_logon",
          "to": "410"
        },
        {
          "param": "record_id",
          "to": "410"
        },
        {
          "param": "display_details_view.x",
          "to": "410"
        }

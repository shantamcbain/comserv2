comserv.psgi
workspace.xml
.idea/*
.idea/workspace.xml
.idea/vcs.xml
/db_config.json
# Timestamped dumps of db_config.json. Already-tracked backups stay in the
# index as credential-free templates; this stops NEW live dumps being added.
db_config.json.backup.*
.env
.env.*
*.log
/local/
/blib/
/pm_to_blib
/Makefile
/Makefile.old
/MYMETA.*
/inc/
/pretrained_models/
/whisper_venv/
/ency.db*

# AI session history and working files (not tracked)
root/Documentation/session_history/
*.md
# Exception: the Documentation System Standard is the single source of truth and
# MUST be version-controlled and browser-served. Track exactly this file.
!root/Documentation/STANDARD.md
!root/Documentation/TodoCardUnificationPlan.tt
# Exception: active plan documents that AI sessions and deploys must both see.
!root/Documentation/PlanningQueueRoleVisibilityPlan.md
!root/Documentation/ProjectsPageFilterSearchPriorityPlan.md
!root/Documentation/ProjectOwnershipBillingPlan.md
!root/Documentation/AccountingEntityStructurePlan.md
!root/Documentation/TodoListPageDisplayTuningPlan.md
!root/Documentation/V2MigrationPlan.md

# Dev workstation TLS certs (never commit private keys)
config/dev_tls/

# Auto-generated editor caches (runtime, re-creatable)
/.file_index_cache.json
/.route_map_cache.json

# Secrets: real credentials live ONLY in ~/.comserv/secrets (outside the repo).
# Never commit Comserv/secrets/ — it may contain live DB passwords.
/secrets/

# Runtime Documentation catalog overlay — rewritten on every scan/save.
# Tracking it causes merge conflicts on every cross-branch merge.
/root/session/documentation_config/DocumentationConfig.json
/root/session/documentation_config/scan_state.json
/root/session/documentation_config/*.bak
/root/session/documentation_config/*.tmp
Comserv/root/data/

# Per-call / runtime AI state (AISYSTEM plan; untracked 2026-10-01). Written by
# the running app, the Super Grok guard, the Firefox meter add-on and the
# decision-rank cron. Never commit these.
/data/ai_model_health.json
/data/ai_model_health.json.lock
/data/ai_model_health.json.tmp*
/data/ai_decision_calls.jsonl
/data/ai_rank_order.json
/data/ai_eval_outbox/openrouter-live.json
/data/ai_auto_changes.jsonl
/data/ai_guard_events.json
/root/static/ai/grokcom_usage.json
/root/static/ai/grokcom_usage_history.jsonl
/root/static/ai/supergrok_guard.json

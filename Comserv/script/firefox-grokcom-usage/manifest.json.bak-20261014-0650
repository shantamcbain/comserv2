{
  "manifest_version": 2,
  "name": "Comserv grok.com usage",
  "version": "1.3.0",
  "description": "Watch grok.com Settings → Usage and record SuperGrok Build/Chat % and Grok Bot % as the page changes. Numbers only — no cookies.",
  "browser_specific_settings": {
    "gecko": {
      "id": "grokcom-usage@comserv.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "storage",
    "https://grok.com/*",
    "https://*.grok.com/*"
  ],
  "background": {
    "scripts": [
      "background.js"
    ],
    "persistent": true
  },
  "browser_action": {
    "default_title": "grok.com usage",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://grok.com/*",
        "https://*.grok.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
